# ============================================================
#  8) ساخت مخزن روی GitHub
# ============================================================
create_remote_repo() {
    c_cyan ">>> [8/12] ساخت مخزن روی GitHub..."

    if gh repo view "${GH_USER}/${REPO_NAME}" >/dev/null 2>&1; then
        c_yellow "    [!] مخزن ${GH_USER}/${REPO_NAME} از قبل وجود دارد. استفاده می‌شود."
    else
        local vis_flag="--private"
        [ "$REPO_VISIBILITY" = "public" ] && vis_flag="--public"

        gh repo create "${GH_USER}/${REPO_NAME}" \
            $vis_flag \
            --description "APZ Manager – APK Security Analysis Platform (Android-ready)" \
            --source="${SCRIPT_DIR}" \
            --remote=origin \
            --disable-wiki

        c_green "    [+] مخزن ساخته شد: https://github.com/${GH_USER}/${REPO_NAME}"
    fi

    # اطمینان از remote
    if ! git remote get-url origin >/dev/null 2>&1; then
        git remote add origin "https://github.com/${GH_USER}/${REPO_NAME}.git"
    fi

    c_dim "    remote: $(git remote get-url origin)"
}

# ============================================================
#  9) Commit + Push اولیه
# ============================================================
initial_commit_push() {
    c_cyan ">>> [9/12] Commit و Push اولیه..."

    git add -A

    if ! git diff --cached --quiet; then
        git commit -m "chore: bootstrap CI/CD (workflows, templates, dependabot)" >/dev/null
        c_dim "    [+] commit ساخته شد."
    else
        c_dim "    [=] چیزی برای commit نیست."
    fi

    local branch; branch="$(git rev-parse --abbrev-ref HEAD)"
    # اطمینان از main
    if [ "$branch" != "${DEFAULT_BRANCH}" ]; then
        git branch -M "${DEFAULT_BRANCH}" || true
    fi

    git push -u origin "${DEFAULT_BRANCH}" || {
        c_yellow "    [!] push ناموفق. بررسی دستی لازم است."
        c_dim "    git push -u origin ${DEFAULT_BRANCH}"
    }

    c_green "    [+] Push انجام شد."
}

# ============================================================
#  10) تنظیم Secrets
# ============================================================
setup_secrets() {
    c_cyan ">>> [10/12] تنظیم Secrets..."

    # لیست secretها و توضیح
    declare -A SECRETS=(
        [APZ_VT_API_KEY]="VirusTotal API Key (اختیاری)"
        [APZ_HA_API_KEY]="Hybrid Analysis API Key (اختیاری)"
        [APZ_MD_API_KEY]="MetaDefender API Key (اختیاری)"
        [APZ_AI_API_KEY]="OpenAI API Key (اختیاری)"
        [GH_PAT]="Personal Access Token (اختیاری – برای push خودکار)"
    )

    local skip_secrets="${APZ_SKIP_SECRETS:-0}"

    if [ "$skip_secrets" = "1" ]; then
        c_dim "    [=] به‌دلیل APZ_SKIP_SECRETS=1 رد شد."
        return 0
    fi

    for key in "${!SECRETS[@]}"; do
        local desc="${SECRETS[$key]}"
        local existing
        existing="$(gh secret list --repo "${GH_USER}/${REPO_NAME}" 2>/dev/null | grep -c "^${key}" || true)"

        if [ "$existing" -gt 0 ]; then
            c_dim "    [=] ${key} از قبل تنظیم شده."
            continue
        fi

        # اگر در محیط موجود بود، خودکار ست کن
        if [ -n "${!key:-}" ]; then
            printf '%s' "${!key}" | gh secret set "${key}" --repo "${GH_USER}/${REPO_NAME}"
            c_dim "    [+] ${key} از محیط تنظیم شد."
            continue
        fi

        # در غیر این صورت، سؤال کن
        echo
        c_bold "    ▸ ${key}: ${desc}"
        read -r -s -p "      مقدار (Enter برای رد کردن): " val
        echo
        if [ -n "$val" ]; then
            printf '%s' "$val" | gh secret set "${key}" --repo "${GH_USER}/${REPO_NAME}"
            c_dim "    [+] ${key} تنظیم شد."
        else
            c_dim "    [=] ${key} رد شد."
        fi
    done

    c_green "    [+] Secrets بررسی شدند."
}

# ============================================================
#  11) Branch protection روی main
# ============================================================
set_branch_protection() {
    c_cyan ">>> [11/12] فعال‌سازی Branch protection روی ${DEFAULT_BRANCH}..."

    local endpoint="repos/${GH_USER}/${REPO_NAME}/branches/${DEFAULT_BRANCH}/protection"

    # ساخت payload
    local payload
    payload=$(cat <<JSON
{
  "required_status_checks": {
    "strict": true,
    "contexts": ["lint-and-test"]
  },
  "enforce_admins": false,
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1
  },
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false,
  "required_conversation_resolution": true,
  "required_linear_history": false
}
JSON
)

    if echo "$payload" | gh api --method PUT "$endpoint" --input - >/dev/null 2>&1; then
        c_green "    [+] Branch protection فعال شد."
    else
        c_yellow "    [!] تنظیم branch protection نیاز به دسترسی admin دارد."
        c_dim "    ▸ اگر repo خصوصی در حساب free است، branch protection در دسترس نیست."
        c_dim "    ▸ می‌توانید دستی از Settings → Branches تنظیم کنید."
    fi

    # فعال‌سازی امکانات امنیتی
    local sec_payload='{"security_and_analysis":{"secret_scanning":{"status":"enabled"},"secret_scanning_push_protection":{"status":"enabled"}}}'
    if echo "$sec_payload" | gh api --method PATCH "repos/${GH_USER}/${REPO_NAME}" --input - >/dev/null 2>&1; then
        c_dim "    [+] Secret scanning فعال شد."
    fi

    # فعال‌سازی vulnerability alerts
    if gh api --method PUT "repos/${GH_USER}/${REPO_NAME}/vulnerability-alerts" >/dev/null 2>&1; then
        c_dim "    [+] Vulnerability alerts فعال شد."
    fi

    # فعال‌سازی Dependabot alerts
    if gh api --method PUT "repos/${GH_USER}/${REPO_NAME}/automated-security-fixes" >/dev/null 2>&1; then
        c_dim "    [+] Automated security fixes فعال شد."
    fi
}

# ============================================================
#  12) جمع‌بندی
# ============================================================
summary() {
    c_cyan ">>> [12/12] جمع‌بندی"
    local repo_url="https://github.com/${GH_USER}/${REPO_NAME}"
    local actions_url="${repo_url}/actions"

    echo
    echo "============================================================"
    c_green "   ✅ CI/CD راه‌اندازی شد"
    echo "============================================================"
    echo "   مخزن      : ${repo_url}"
    echo "   Actions   : ${actions_url}"
    echo "   Releases  : ${repo_url}/releases"
    echo "   Settings  : ${repo_url}/settings"
    echo
    echo "   ▸ Workflowها:"
    echo "       • release.yml  → انتشار روی tag v*.*.*"
    echo "       • test.yml     → تست ماتریسی Python 3.9–3.12"
    echo "       • codeql.yml   → اسکن امنیتی هفتگی"
    echo
    echo "   ▸ برای انتشار نسخه جدید:"
    echo "       bash release.sh patch --no-adb"
    echo "     یا از GitHub UI:"
    echo "       Actions → Release → Run workflow → patch"
    echo
    echo "   ▸ برای مشاهده Secrets:"
    echo "       gh secret list --repo ${GH_USER}/${REPO_NAME}"
    echo "============================================================"
}

# ============================================================
#  main
# ============================================================
main() {
    banner
    preflight
    init_local_repo
    create_github_dirs
    write_release_workflow
    write_test_workflow
    write_codeql_workflow
    write_dependabot
    write_templates
    create_remote_repo
    initial_commit_push
    setup_secrets
    set_branch_protection
    summary
}

main "$@"
