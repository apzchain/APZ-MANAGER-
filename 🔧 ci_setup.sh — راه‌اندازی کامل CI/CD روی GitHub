🔧 ci_setup.sh — راه‌اندازی کامل CI/CD روی GitHub

این اسکریپت یک مخزن GitHub را از صفر آماده می‌کند:

· ✅ بررسی و نصب gh CLI (در صورت نیاز)
· ✅ ساخت مخزن GitHub (خصوصی/عمومی)
· ✅ افزودن .github/workflows/release.yml + test.yml + codeql.yml
· ✅ افزودن .github/dependabot.yml
· ✅ افزودن CODEOWNERS، تمپلیت PR و Issue
· ✅ تنظیم Secrets (APZ_VT_API_KEY, APZ_HA_API_KEY, ...)
· ✅ فعال‌سازی Branch protection روی main
· ✅ فعال‌سازی Actions، Dependabot Alerts، Secret Scanning
· ✅ Push اولیه‌ی کد

---

📄 ci_setup.sh

```bash
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – GitHub CI/CD Bootstrap
#  ساخت مخزن از صفر + workflows + secrets + branch protection
#  Usage:  bash ci_setup.sh [repo-name] [--private|--public]
#  Author: APZ Security Team | License: GPLv3
# ============================================================
set -euo pipefail

# ---------- پیش‌فرض‌ها ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_NAME="${1:-apz-manager}"
REPO_VISIBILITY="private"
DEFAULT_BRANCH="main"

# اگر داخل apz-android اجرا شد، پروژه‌ی اصلی را یک سطح بالاتر بگیر
if [ -f "${SCRIPT_DIR}/../apz_manager.py" ]; then
    SCRIPT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

# پارس پرچم‌ها
for arg in "$@"; do
    case "$arg" in
        --public)  REPO_VISIBILITY="public" ;;
        --private) REPO_VISIBILITY="private" ;;
    esac
done

# ---------- رنگ‌ها ----------
c_green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
c_red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
c_cyan()   { printf "\033[1;36m%s\033[0m\n" "$1"; }
c_bold()   { printf "\033[1m%s\033[0m\n" "$1"; }
c_dim()    { printf "\033[2m%s\033[0m\n" "$1"; }

banner() {
    echo "============================================================"
    echo "   APZ Manager – GitHub CI/CD Bootstrap"
    echo "   Repo: ${REPO_NAME}  |  Visibility: ${REPO_VISIBILITY}"
    echo "============================================================"
}

# ============================================================
#  0) پیش‌نیازها
# ============================================================
preflight() {
    c_cyan ">>> [0/12] بررسی پیش‌نیازها..."

    if ! command -v git >/dev/null 2>&1; then
        c_red "[!] git نصب نیست."
        exit 1
    fi

    if ! command -v gh >/dev/null 2>&1; then
        c_yellow "[!] gh (GitHub CLI) نصب نیست."
        echo "    نصب:"
        echo "      Linux : sudo apt install gh"
        echo "      macOS : brew install gh"
        echo "      Win   : winget install GitHub.cli"
        exit 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        c_yellow "[!] به GitHub لاگین نیستید."
        if command -v read >/dev/null; then
            read -r -p "    الان اجرا کنم gh auth login؟ [y/N] " ans
            if [[ "$ans" =~ ^[Yy]$ ]]; then
                gh auth login
            else
                exit 1
            fi
        fi
    fi

    GH_USER="$(gh api user --jq .login)"
    c_dim "    کاربر: ${GH_USER}"

    if [ ! -d "${SCRIPT_DIR}/.git" ]; then
        c_dim "    پروژه در ${SCRIPT_DIR} هنوز git init نشده."
    fi

    c_green "    [+] پیش‌نیازها OK."
}

# ============================================================
#  1) Git init محلی
# ============================================================
init_local_repo() {
    c_cyan ">>> [1/12] آماده‌سازی مخزن محلی..."
    cd "${SCRIPT_DIR}"

    if [ ! -d ".git" ]; then
        git init -b "${DEFAULT_BRANCH}"
        c_dim "    [+] git init در ${SCRIPT_DIR}"
    else
        # اطمینان از اینکه شاخه main است
        local current; current="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
        if [ "$current" != "$DEFAULT_BRANCH" ] && [ "$current" != "master" ]; then
            c_dim "    شاخه فعلی: ${current}"
        fi
    fi

    # تنظیم user اگر نبود
    if ! git config user.email >/dev/null 2>&1; then
        local email; email="$(gh api user --jq .email 2>/dev/null || echo "${GH_USER}@users.noreply.github.com")"
        git config user.email "$email"
        git config user.name "$GH_USER"
        c_dim "    [+] git user تنظیم شد: ${GH_USER}"
    fi

    c_green "    [+] مخزن محلی OK."
}

# ============================================================
#  2) ساختار پوشه‌های .github
# ============================================================
create_github_dirs() {
    c_cyan ">>> [2/12] ساخت ساختار .github/..."
    mkdir -p .github/workflows
    mkdir -p .github/ISSUE_TEMPLATE
    c_green "    [+] .github/ آماده شد."
}

# ============================================================
#  3) workflows/release.yml
# ============================================================
write_release_workflow() {
    c_cyan ">>> [3/12] نوشتن release.yml..."
    cat > .github/workflows/release.yml <<'EOF_RELEASE'
name: Release

on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:
    inputs:
      version:
        description: 'Version (e.g. patch | minor | major | 1.2.3)'
        required: true
        default: 'patch'

permissions:
  contents: write
  packages: write
  id-token: write

jobs:
  # ----------------------------------------------------------
  build:
    name: Build & Package
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.version.outputs.version }}
      zip:     ${{ steps.package.outputs.zip }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install system deps
        run: |
          sudo apt-get update
          sudo apt-get install -y libyara-dev yara zip

      - name: Install Python deps
        run: |
          python -m pip install --upgrade pip wheel setuptools
          if [ -f requirements-android.txt ]; then
            pip install -r requirements-android.txt
          else
            pip install androguard pyyaml flask sqlalchemy yara-python requests
          fi

      - name: Resolve version
        id: version
        run: |
          if [ -f VERSION ]; then
            V="$(tr -d '[:space:]' < VERSION)"
          else
            V="0.0.0"
          fi
          echo "version=$V" >> "$GITHUB_OUTPUT"
          echo "Detected version: $V"

      - name: Build ZIP
        id: package
        run: |
          if [ -d apz-android ] && [ -f apz-android/build_zip.sh ]; then
            ( cd apz-android && bash build_zip.sh )
            ZIP="$(ls apz-android-v*.zip | head -1)"
          elif [ -f build_zip.sh ]; then
            bash build_zip.sh
            ZIP="$(ls apz-android-v*.zip | head -1)"
          else
            # fallback: ساخت دستی ZIP
            mkdir -p dist
            ZIP="dist/apz-android-v${{ steps.version.outputs.version }}.zip"
            zip -r "$ZIP" . -x '*.git*' 'venv/*' '*/__pycache__/*' 'dist/*'
          fi
          echo "zip=$ZIP" >> "$GITHUB_OUTPUT"
          echo "Created: $ZIP"
          ls -la "$ZIP"

      - name: Compute SHA-256
        run: |
          ZIP="${{ steps.package.outputs.zip }}"
          sha256sum "$ZIP" > "${ZIP}.sha256"
          cat "${ZIP}.sha256"

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: apz-android-${{ steps.version.outputs.version }}
          path: |
            ${{ steps.package.outputs.zip }}
            ${{ steps.package.outputs.zip }}.sha256
          retention-days: 30

  # ----------------------------------------------------------
  test:
    name: Tests
    runs-on: ubuntu-latest
    needs: build
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Install deps
        run: |
          python -m pip install --upgrade pip
          if [ -f requirements-android.txt ]; then
            pip install -r requirements-android.txt
          else
            pip install androguard pyyaml flask sqlalchemy yara-python
          fi
          pip install pytest
      - name: Run tests
        run: |
          if [ -d tests ]; then
            pytest -v tests/ || true
          else
            echo "No tests directory; skipping."
          fi

  # ----------------------------------------------------------
  release:
    name: Publish GitHub Release
    runs-on: ubuntu-latest
    needs: [build, test]
    if: startsWith(github.ref, 'refs/tags/v')
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Download artifact
        uses: actions/download-artifact@v4
        with:
          name: apz-android-${{ needs.build.outputs.version }}

      - name: Extract changelog
        id: changelog
        run: |
          VER="${{ needs.build.outputs.version }}"
          if [ -f CHANGELOG.md ]; then
            awk -v ver="$VER" '
              $0 ~ "^## \\["ver"\\]" {flag=1; next}
              /^## \[/ && flag {exit}
              flag {print}
            ' CHANGELOG.md > notes.md
          fi
          if [ ! -s notes.md ]; then
            echo "Release v${VER}" > notes.md
          fi
          cat notes.md

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          name: APZ Manager v${{ needs.build.outputs.version }}
          body_path: notes.md
          files: |
            apz-android-v*.zip
            apz-android-v*.zip.sha256
          generate_release_notes: true
          draft: false
          prerelease: ${{ contains(github.ref, '-rc') || contains(github.ref, '-beta') }}

  # ----------------------------------------------------------
  dispatch-release:
    name: Manual Bump (workflow_dispatch)
    runs-on: ubuntu-latest
    needs: build
    if: github.event_name == 'workflow_dispatch'
    steps:
      - uses: actions/checkout@v4
        with:
          token: ${{ secrets.GH_PAT || secrets.GITHUB_TOKEN }}
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Bump version
        env:
          VERSION_ARG: ${{ github.event.inputs.version }}
          RELEASE_NOTES: "- Automated release via workflow_dispatch"
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          if [ -f release.sh ]; then
            bash release.sh "${{ github.event.inputs.version }}" \
              --no-adb --no-push --yes || true
            # Push tag manually
            NEW="$(cat VERSION)"
            git push origin HEAD:${DEFAULT_BRANCH:-main} || true
            git push origin "v${NEW}" || true
          fi
        env:
          DEFAULT_BRANCH: main
EOF_RELEASE
    c_green "    [+] release.yml نوشته شد."
}

