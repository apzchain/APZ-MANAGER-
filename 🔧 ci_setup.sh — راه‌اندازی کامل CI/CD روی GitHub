write_test_workflow() {
    c_cyan ">>> [4/12] نوشتن test.yml..."
    cat > .github/workflows/test.yml <<'EOF_TEST'
name: Test

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

permissions:
  contents: read

jobs:
  lint-and-test:
    name: Lint + Test (Python ${{ matrix.python }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python: ['3.9', '3.10', '3.11', '3.12']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python }}
          cache: 'pip'

      - name: System deps
        run: |
          sudo apt-get update
          sudo apt-get install -y libyara-dev yara

      - name: Install deps
        run: |
          python -m pip install --upgrade pip wheel setuptools
          if [ -f requirements-android.txt ]; then
            pip install -r requirements-android.txt
          else
            pip install androguard pyyaml flask sqlalchemy yara-python requests
          fi
          pip install pytest ruff black

      - name: Lint (ruff)
        run: ruff check . || true

      - name: Format check (black)
        run: black --check . || true

      - name: Run tests
        run: |
          if [ -d tests ]; then
            pytest -v tests/
          else
            echo "No tests/ directory."
          fi

      - name: Import smoke test
        run: |
          python - <<'PY'
          import os, sys
          mods = ["androguard", "yara", "flask", "sqlalchemy"]
          bad = []
          for m in mods:
              try:
                  __import__(m); print(f"OK {m}")
              except Exception as e:
                  print(f"FAIL {m}: {e}"); bad.append(m)
          sys.exit(1 if bad else 0)
          PY
EOF_TEST
    c_green "    [+] test.yml نوشته شد."
}

