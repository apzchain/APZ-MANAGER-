🛠️ ۲) build_zip.sh — ساخت ZIP نهایی

```bash
#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  ساخت فایل ZIP توزیع‌پذیر از پکیج APZ Android
#  خروجی: apz-android-v<version>.zip  در پوشه‌ی والد
# ============================================================
set -e

VERSION="$(cat VERSION 2>/dev/null || echo '1.0.0')"
PKG_NAME="apz-android"
OUT_ZIP="$(pwd)/../${PKG_NAME}-v${VERSION}.zip"

c_green() { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_cyan()  { printf "\033[1;36m%s\033[0m\n" "$1"; }
c_red()   { printf "\033[1;31m%s\033[0m\n" "$1"; }

c_cyan ">>> آماده‌سازی ساخت ZIP نسخه ${VERSION}..."

# پاک‌سازی فایل‌های موقت
rm -f "${OUT_ZIP}"

# ابزار zip
if ! command -v zip >/dev/null 2>&1; then
    c_cyan ">>> نصب zip..."
    pkg install -y zip
fi

# لیست فایل‌هایی که باید در ZIP باشند
FILES=(
    Makefile
    VERSION
    .gitignore
    LICENSE
    README_ANDROID.md
    apz_android.sh
    setup_proot.sh
    run_android.sh
    requirements-android.txt
    report_generator_patch.py
    patch_apz_manager.py
    .env.android.example
    build_zip.sh
)

# بررسی وجود فایل‌ها
MISSING=()
for f in "${FILES[@]}"; do
    if [ ! -f "$f" ]; then
        MISSING+=("$f")
    fi
done

if [ ${#MISSING[@]} -gt 0 ]; then
    c_red "[!] فایل‌های ناموجود:"
    for m in "${MISSING[@]}"; do echo "    - $m"; done
    exit 1
fi

# ساخت موقت با ساختار apz-android/
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT
mkdir -p "${TMPDIR}/${PKG_NAME}"

for f in "${FILES[@]}"; do
    cp -p "$f" "${TMPDIR}/${PKG_NAME}/"
done

# افزودن پوشه‌ی خالی rules/ برای YARA سفارشی
mkdir -p "${TMPDIR}/${PKG_NAME}/rules"
cat > "${TMPDIR}/${PKG_NAME}/rules/.keep" <<'EOF'
# قوانین YARA خود را در این پوشه قرار دهید.
# پسوند فایل‌ها: .yar
EOF

# ساخت ZIP
c_cyan ">>> فشرده‌سازی..."
( cd "${TMPDIR}" && zip -r -q "${OUT_ZIP}" "${PKG_NAME}" )

SIZE=$(du -h "${OUT_ZIP}" | cut -f1)
c_green "============================================================"
c_green "  ✅ ZIP ساخته شد: $(basename "${OUT_ZIP}")"
c_green "     حجم: ${SIZE}"
c_green "============================================================"
echo
echo "نصب روی گوشی:"
echo "  1) این فایل را به گوشی منتقل کنید."
echo "  2) داخل Termux:"
echo "       cd ~ && unzip ${PKG_NAME}-v${VERSION}.zip"
echo "       cd ${PKG_NAME} && make install"
echo
```

قابل اجرا با:

```bash
chmod +x build_zip.sh
./build_zip.sh
# یا
make dist
```

