```

فایل‌های apz_android.sh, setup_proot.sh, run_android.sh, requirements-android.txt, report_generator_patch.py, patch_apz_manager.py, .env.android.example, README_ANDROID.md همان‌هایی هستند که در پیام قبلی تحویل داده شدند — اینجا فقط فایل‌های جدید (Makefile, build_zip.sh, VERSION, .gitignore, LICENSE) را می‌آورم.

---

⭐ ۱) Makefile — قلب پکیج

⚠️ در Makefile حتماً از Tab (نه فاصله) برای تورفتگی دستورات استفاده کنید. اگر کپی می‌کنید، مطمئن شوید Tab حفظ شده است. (اگر مطمئن نیستید از make fix-tabs استفاده کنید که در همین فایل پیش‌بینی شده.)

```makefile
# ============================================================
#  APZ Manager – Android/Termux Makefile
#  نصب کامل با یک دستور:  make install
#  Author: APZ Security Team | License: GPLv3
# ============================================================

SHELL := bash
.DEFAULT_GOAL := help

# --- مسیرها (قابل بازنویسی) ---
HOME_DIR    := $(HOME)
OUT_DIR     ?= $(HOME_DIR)/apz-reports
REPO_URL    ?= https://github.com/your-org/apz-manager.git

# اگر apz_manager.py در همین شاخه باشد ⇒ همین‌جا نصب می‌کنیم.
# در غیر این صورت پروژه در ~/apz-manager کلون می‌شود.
PROJECT_DIR := $(shell if [ -f apz_manager.py ]; then pwd; \
                       else echo "$(HOME_DIR)/apz-manager"; fi)

VENV_DIR    := $(PROJECT_DIR)/venv
PIP         := $(VENV_DIR)/bin/pip
PY          := $(VENV_DIR)/bin/python
ACTIVATE    := . $(VENV_DIR)/bin/activate

# --- ورودی‌های اختیاری ---
APK   ?=
LIST  ?=

# ============================================================
#  help
# ============================================================
.PHONY: help
help:
	@echo ""
	@echo "📦  APZ Manager – Android Makefile"
	@echo "------------------------------------------------------------"
	@echo "  make install          نصب کامل در Termux (توصیه‌شده)"
	@echo "  make proot            نصب کامل با Ubuntu proot (PDF + YARA)"
	@echo "  make check            بررسی صحت نصب"
	@echo "  make run APK=path     تحلیل یک فایل APK"
	@echo "  make batch LIST=f     تحلیل دسته‌ای از یک لیست"
	@echo "  make api              اجرای سرور RESTful API"
	@echo "  make env              ساخت فایل ~/.apz.env از نمونه"
	@echo "  make storage          فعال‌سازی دسترسی به /sdcard"
	@echo "  make dist             ساخت فایل ZIP قابل توزیع"
	@echo "  make clean            حذف venv و کش‌ها"
	@echo "  make clean-all        حذف venv + گزارش‌ها"
	@echo "------------------------------------------------------------"
	@echo "  پروژه در: $(PROJECT_DIR)"
	@echo "  گزارش‌ها: $(OUT_DIR)"
	@echo ""

# ============================================================
#  نصب کامل (Termux native)
# ============================================================
.PHONY: install
install: preflight termux-deps clone venv deps patch check storage-dirs footer

.PHONY: preflight
preflight:
	@if [ ! -d "/data/data/com.termux" ]; then \
	    echo "⚠️  این Makefile باید داخل Termux اجرا شود."; \
	    echo "    برای نصب روی PC از نسخه‌ی معمول پروژه استفاده کنید."; \
	    exit 1; \
	fi
	@echo ">>> [0/7] محیط Termux تأیید شد."

.PHONY: termux-deps
termux-deps:
	@echo ">>> [1/7] نصب پیش‌نیازهای Termux (ممکن است چند دقیقه طول بکشد)..."
	@pkg update -y
	@pkg upgrade -y
	@pkg install -y \
	    python python-pip git make clang binutils pkg-config rust \
	    libxml2 libxslt libffi openssl zlib libjpeg-turbo freetype \
	    libyaml libcrypt libandroid-support termux-api
	@echo ">>> [1/7] ✅ پیش‌نیازها نصب شدند."

.PHONY: clone
clone:
	@if [ -f "apz_manager.py" ]; then \
	    echo ">>> [2/7] پروژه در همین شاخه است، کلون رد شد."; \
	else \
	    echo ">>> [2/7] دریافت/به‌روزرسانی پروژه از $(REPO_URL)..."; \
	    if [ -d "$(PROJECT_DIR)/.git" ]; then \
	        cd "$(PROJECT_DIR)" && git pull --rebase; \
	    else \
	        git clone "$(REPO_URL)" "$(PROJECT_DIR)"; \
	    fi; \
	fi

.PHONY: venv
venv:
	@echo ">>> [3/7] ساخت محیط مجازی..."
	@if [ ! -d "$(VENV_DIR)" ]; then \
	    python -m venv "$(VENV_DIR)"; \
	fi
	@$(PIP) install --upgrade pip wheel setuptools
	@echo ">>> [3/7] ✅ venv آماده است."

.PHONY: deps
deps:
	@echo ">>> [4/7] نصب وابستگی‌های پایتون..."
	@if [ -f "$(PROJECT_DIR)/requirements-android.txt" ]; then \
	    $(PIP) install -r "$(PROJECT_DIR)/requirements-android.txt"; \
	elif [ -f "requirements-android.txt" ]; then \
	    $(PIP) install -r "requirements-android.txt"; \
	else \
	    $(PIP) install androguard pyyaml flask sqlalchemy yara-python requests rich; \
	fi
	@echo ">>> [4/7] ✅ وابستگی‌ها نصب شدند."

.PHONY: patch
patch:
	@echo ">>> [5/7] اعمال پچ‌های اندروید..."
	@if [ -f "$(PROJECT_DIR)/patch_apz_manager.py" ]; then \
	    cd "$(PROJECT_DIR)" && $(PY) patch_apz_manager.py || true; \
	fi
	@if [ -f "$(PROJECT_DIR)/report_generator_patch.py" ] && [ -f "$(PROJECT_DIR)/report_generator.py" ]; then \
	    [ -f "$(PROJECT_DIR)/report_generator.py.android.bak" ] || \
	        cp "$(PROJECT_DIR)/report_generator.py" "$(PROJECT_DIR)/report_generator.py.android.bak"; \
	    cp "$(PROJECT_DIR)/report_generator_patch.py" "$(PROJECT_DIR)/report_generator.py"; \
	    echo "    [+] report_generator.py جایگزین شد."; \
	fi
	@echo ">>> [5/7] ✅ پچ‌ها اعمال شد."

.PHONY: check
check:
	@echo ">>> [6/7] بررسی صحت نصب..."
	@$(PY) - <<'PYEOF'
import sys
mods = ["androguard", "yara", "flask", "sqlalchemy", "requests"]
bad = []
for m in mods:
    try:
        __import__(m)
        print(f"    [OK] {m}")
    except Exception as e:
        print(f"    [!!] {m} -> {e}")
        bad.append(m)
if bad:
    print("\n[!] ماژول‌های ناموجود:", ", ".join(bad))
    sys.exit(1)
print("    [+] همه‌ی ماژول‌های کلیدی آماده‌اند.")
PYEOF

.PHONY: storage-dirs
storage-dirs:
	@mkdir -p "$(OUT_DIR)"
	@echo ">>> [7/7] پوشه‌ی گزارش‌ها آماده است: $(OUT_DIR)"

.PHONY: footer
footer:
	@echo ""
	@echo "============================================================"
	@echo "   ✅ نصب APZ Manager روی اندروید کامل شد"
	@echo "============================================================"
	@echo "   اجرا:"
	@echo "     make run APK=/sdcard/Download/app.apk"
	@echo "     make api"
	@echo "     make batch LIST=list.txt"
	@echo ""

# ============================================================
#  اجرای تحلیل
# ============================================================
.PHONY: run
run:
	@if [ -z "$(APK)" ]; then \
	    echo "Usage: make run APK=/sdcard/Download/app.apk"; \
	    exit 1; \
	fi
	@if [ ! -f "$(APK)" ]; then \
	    echo "[!] فایل پیدا نشد: $(APK)"; exit 1; \
	fi
	@mkdir -p "$(OUT_DIR)"
	@NAME=$$(basename "$(APK)" .apk); \
	STAMP=$$(date +%Y%m%d_%H%M%S); \
	OUT="$(OUT_DIR)/$${NAME}_$${STAMP}.json"; \
	echo ">>> تحلیل: $(APK)"; \
	echo ">>> خروجی: $$OUT"; \
	cd "$(PROJECT_DIR)" && $(ACTIVATE) && \
	    python apz_manager.py --file "$(APK)" --output "$$OUT" --db; \
	if [ -f "$$OUT" ]; then \
	    if command -v termux-notification >/dev/null 2>&1; then \
	        termux-notification --title "APZ Manager" \
	            --content "تحلیل $$NAME کامل شد." || true; \
	    fi; \
	fi

.PHONY: batch
batch:
	@if [ -z "$(LIST)" ]; then \
	    echo "Usage: make batch LIST=list.txt"; exit 1; \
	fi
	@mkdir -p "$(OUT_DIR)"
	@OUT="$(OUT_DIR)/batch_$$(date +%Y%m%d_%H%M%S).json"; \
	echo ">>> تحلیل دسته‌ای: $(LIST)"; \
	cd "$(PROJECT_DIR)" && $(ACTIVATE) && \
	    python apz_manager.py --batch "$(LIST)" --output "$$OUT" --db; \
	echo "[+] گزارش: $$OUT"

.PHONY: api
api:
	@cd "$(PROJECT_DIR)" && $(ACTIVATE) && \
	    echo ">>> API در حال اجرا روی http://127.0.0.1:5000" && \
	    python apz_api.py

# ============================================================
#  نصب با Ubuntu proot (کامل‌ترین حالت: PDF + YARA پایدار)
# ============================================================
.PHONY: proot
proot:
	@echo ">>> نصب Ubuntu proot (PDF + YARA کامل)..."
	@if [ -f "setup_proot.sh" ]; then \
	    bash setup_proot.sh; \
	else \
	    echo "[!] setup_proot.sh پیدا نشد."; exit 1; \
	fi

# ============================================================
#  کمکی‌ها
# ============================================================
.PHONY: env
env:
	@if [ ! -f "$$HOME/.apz.env" ]; then \
	    if [ -f ".env.android.example" ]; then \
	        cp ".env.android.example" "$$HOME/.apz.env"; \
	        echo "[+] ساخته شد: ~/.apz.env"; \
	        echo "    لطفاً کلیدهای API را ویرایش کنید: nano ~/.apz.env"; \
	    else \
	        echo "[!] نمونه‌ی .env.android.example پیدا نشد."; \
	    fi; \
	else \
	    echo "[=] ~/.apz.env از قبل وجود دارد."; \
	fi
	@if ! grep -q "apz.env" "$$HOME/.bashrc" 2>/dev/null; then \
	    echo '[ -f ~/.apz.env ] && set -a && . ~/.apz.env && set +a' >> "$$HOME/.bashrc"; \
	    echo "[+] خط منبع env به ~/.bashrc اضافه شد."; \
	fi

.PHONY: storage
storage:
	@echo ">>> فعال‌سازی دسترسی به حافظه (نیاز به تأیید اندروید)..."
	@termux-setup-storage || true
	@sleep 1
	@if [ -d "/sdcard/Download" ]; then \
	    echo "[+] دسترسی فعال است: /sdcard/Download"; \
	else \
	    echo "[!] دسترسی داده نشده."; \
	fi

.PHONY: fix-tabs
fix-tabs:
	@echo ">>> بررسی/اصلاح Tab در Makefile..."
	@if grep -qP '^\t' Makefile; then \
	    echo "[=] Tabها سالم هستند."; \
	else \
	    python - <<'PYEOF'
from pathlib import Path
p = Path("Makefile")
lines = p.read_text().splitlines(keepends=True)
fixed = []
prev_marker = False
for ln in lines:
    s = ln.lstrip(" ")
    if prev_marker and s.startswith(" ") and not ln.startswith("\t"):
        ln = "\t" + s
    if ln.rstrip().endswith(":"):
        prev_marker = True
    elif not ln.startswith("\t") and ln.strip():
        prev_marker = False
    fixed.append(ln)
p.write_text("".join(fixed))
print("[+] اصلاح شد (اگر لازم بود).")
PYEOF
	fi

# ============================================================
#  توزیع و ساخت ZIP
# ============================================================
.PHONY: dist zip
dist zip:
	@bash build_zip.sh

# ============================================================
#  پاک‌سازی
# ============================================================
.PHONY: clean
clean:
	@echo ">>> حذف venv و کش‌ها..."
	@rm -rf "$(VENV_DIR)"
	@find "$(PROJECT_DIR)" -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
	@find "$(PROJECT_DIR)" -type f -name "*.pyc" -delete 2>/dev/null || true
	@echo "[+] تمام."

.PHONY: clean-all
clean-all: clean
	@echo ">>> حذف گزارش‌ها..."
	@rm -rf "$(OUT_DIR)"
	@echo "[+] تمام."
```

