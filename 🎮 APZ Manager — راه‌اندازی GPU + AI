    )
    max_tokens: int = field(
        default_factory=lambda: int(os.getenv("APZ_AI_MAX_TOKENS", "2048"))
    )
    timeout: int = field(
        default_factory=lambda: int(os.getenv("APZ_AI_TIMEOUT", "120"))
