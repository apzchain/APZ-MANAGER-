📄 ۳) docker/healthcheck-gpu.sh — بررسی سلامت GPU

```bash
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – GPU healthcheck
#  بررسی: NVIDIA driver + CUDA + PyTorch + Ollama
# ============================================================
set -uo pipefail

FAIL=0
log()  { printf '\033[1;36m[gpu-hc]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[gpu-hc]\033[0m %s\n' "$*" >&2; }

# 1) nvidia-smi
if command -v nvidia-smi >/dev/null 2>&1; then
    if nvidia-smi >/dev/null 2>&1; then
        log "nvidia-smi OK"
    else
        err "nvidia-smi اجرا نشد"
        FAIL=1
    fi
else
    log "nvidia-smi در PATH نیست (طبیعی است اگر driver mount نشده)"
fi

# 2) PyTorch CUDA
if python -c "import torch" >/dev/null 2>&1; then
    TORCH_CUDA="$(python -c 'import torch; print(torch.cuda.is_available())' 2>/dev/null || echo False)"
    if [ "$TORCH_CUDA" = "True" ]; then
        log "PyTorch CUDA: available"
        python - <<'PY'
import torch
print(f"[gpu-hc] device: {torch.cuda.get_device_name(0)}")
print(f"[gpu-hc] capability: {torch.cuda.get_device_capability(0)}")
print(f"[gpu-hc] cuda version: {torch.version.cuda}")
PY
    else
        log "PyTorch CUDA: not available (CPU mode)"
    fi
fi

# 3) Ollama reachable
if [ -n "${OLLAMA_HOST:-}" ]; then
    if curl -fsS --max-time 5 "${OLLAMA_HOST}/api/tags" >/dev/null 2>&1; then
        log "Ollama reachable: ${OLLAMA_HOST}"
    else
        err "Ollama unreachable: ${OLLAMA_HOST}"
        FAIL=1
    fi
fi

# 4) APZ API (اگر در حال اجرا)
if pgrep -f "apz_api.py" >/dev/null 2>&1; then
    if ! curl -fsS --max-time 5 "http://127.0.0.1:5000/stats" >/dev/null 2>&1; then
        err "APZ API not responding"
        FAIL=1
    else
        log "APZ API OK"
    fi
fi

# 5) مسیر داده قابل نوشتن
for d in /data /data/reports /data/hf-cache; do
    if [ -d "$d" ] && [ ! -w "$d" ]; then
        err "Not writable: $d"
        FAIL=1
    fi
done

if [ "$FAIL" -eq 0 ]; then
    echo "healthy"
    exit 0
fi

echo "unhealthy"
exit 1
```

