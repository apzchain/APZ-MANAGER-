class AIConfig:
    enabled: bool = field(default_factory=lambda: os.getenv("APZ_AI_ENABLED", "0") == "1")
    backend: str = field(default_factory=lambda: os.getenv("APZ_AI_BACKEND", "ollama"))
    host: str = field(default_factory=lambda: os.getenv("OLLAMA_HOST", "http://localhost:11434"))
