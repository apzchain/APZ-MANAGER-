## 📄 ۵) `setup_gpu.sh` — راه‌انداز سریع GPU

```bash
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – GPU setup helper
#  - بررسی nvidia-container-toolkit
#  - تست GPU
#  - build + up با compose.gpu
#  - pull مدل‌ها
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

c_green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
c_red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
c_cyan()   { printf "\033[1;36m%s\033[0m\n" "$1"; }

echo "============================================================"
echo "   APZ Manager – GPU Setup"
echo "============================================================"

# 1) بررسی پیش‌نیازها
c_cyan ">>> [1/6] بررسی پیش‌نیازها..."
if ! command -v docker >/dev/null 2>&1; then
    c_red "[!] docker نصب نیست."
    exit 1
fi

if ! docker info 2>/dev/null | grep -qi nvidia; then
    c_yellow "[!] ممکن است nvidia-container-toolkit پیکربندی نشده باشد."
    echo "    راهنما: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html"
fi

if ! command -v nvidia-smi >/dev/null 2>&1; then
    c_yellow "[!] nvidia-smi پیدا نشد. GPU driver نصب است؟"
fi

# 2) تست GPU در docker
c_cyan ">>> [2/6] تست GPU در Docker..."
if docker run --rm --gpus all nvidia/cuda:12.1.1-base-ubuntu22.04 nvidia-smi >/dev/null 2>&1; then
    c_green "    [+] GPU در Docker در دسترس است."
    docker run --rm --gpus all nvidia/cuda:12.1.1-base-ubuntu22.04 nvidia-smi | head -12
else
    c_red "[!] GPU در Docker در دسترس نیست."
    echo "    راه‌حل:"
    echo "      sudo apt install -y nvidia-container-toolkit"
    echo "      sudo nvidia-ctk runtime configure --runtime=docker"
    echo "      sudo systemctl restart docker"
    exit 1
fi

# 3) فایل‌های لازم
c_cyan ">>> [3/6] بررسی فایل‌های پروژه..."
for f in Dockerfile.gpu docker-compose.gpu.yml docker/entrypoint.sh docker/healthcheck.sh; do
    if [ ! -f "$f" ]; then
        c_red "[!] فایل ناموجود: $f"
        echo "    ابتدا:  bash docker_setup.sh gen"
        exit 1
    fi
done
c_green "    [+] همه فایل‌ها موجودند."

# 4) ساخت ایمیج
c_cyan ">>> [4/6] ساخت ایمیج GPU (ممکن است ۱۰–۲۰ دقیقه طول بکشد)..."
DOCKERFILE=Dockerfile.gpu APZ_GPU_IMAGE=apz-manager:gpu docker build \
    -f Dockerfile.gpu \
    -t apz-manager:gpu \
    --build-arg BUILDKIT_INLINE_CACHE=1 \
    . 

c_green "    [+] ایمیج ساخته شد: apz-manager:gpu"

# 5) بالا آوردن سرویس‌ها
c_cyan ">>> [5/6] اجرای docker compose -f docker-compose.gpu.yml up -d..."
docker compose -f docker-compose.gpu.yml up -d --build

# 6) انتظار برای Ollama + pull مدل‌ها
c_cyan ">>> [6/6] انتظار برای Ollama و دانلود مدل‌ها (چند دقیقه)..."
for i in $(seq 1 60); do
    if docker exec apz-ollama ollama list >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

PRIMARY="${APZ_AI_MODEL:-qwen2.5:7b-instruct}"
FALLBACK="${APZ_AI_FALLBACK_MODEL:-llama3.2:3b-instruct}"

docker exec apz-ollama ollama pull "$PRIMARY" || true
docker exec apz-ollama ollama pull "$FALLBACK" || true

echo
c_green "============================================================"
c_green "   ✅ GPU setup کامل شد"
c_green "============================================================"
echo "   وضعیت سرویس‌ها:"
docker compose -f docker-compose.gpu.yml ps
echo
echo "   مدل‌های Ollama:"
docker exec apz-ollama ollama list || true
echo
echo "   ▸ API:        http://localhost:5000/stats"
echo "   ▸ Ollama:     http://localhost:11434"
echo "   ▸ Web UI:     docker compose -f docker-compose.gpu.yml --profile ui up -d"
echo "                 → http://localhost:3000"
echo
echo "   ▸ تست AI روی یک گزارش:"
echo "       docker exec -it apz-api-gpu python ai_analyzer.py \\"
echo "           --report /data/reports/sample.json --mode all"
echo
echo "   ▸ تست GPU:"
echo "       docker exec -it apz-api-gpu nvidia-smi"
echo "       docker exec -it apz-api-gpu python -c 'import torch; print(torch.cuda.is_available())'"
echo
