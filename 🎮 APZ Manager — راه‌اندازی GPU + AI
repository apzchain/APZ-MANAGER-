📄 ۱) Dockerfile.gpu — ایمیج CUDA برای تحلیل ML

```dockerfile
# ============================================================
#  APZ Manager – GPU/CUDA Dockerfile
#  برای: تحلیل ML، embedding، ONNX GPU، اتصال به Ollama
#  Base: NVIDIA CUDA 12.1 + cuDNN 8 + Python 3.11
#  Author: APZ Security Team | License: GPLv3
# ============================================================
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS runtime

LABEL org.opencontainers.image.title="APZ Manager GPU" \
      org.opencontainers.image.description="APK Security Analysis Platform with CUDA acceleration" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.gpu="cuda-12.1"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH="/opt/venv/bin:$PATH" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}" \
    APZ_HOME=/opt/apz \
    APZ_DEFAULT_OUTDIR=/data/reports \
    APZ_DB_PATH=/data/apz.db \
    APZ_HTTP_HOST=0.0.0.0 \
    APZ_HTTP_PORT=5000 \
    # --- AI / GPU ---
    APZ_AI_ENABLED=1 \
    APZ_AI_BACKEND=ollama \
    OLLAMA_HOST=http://ollama:11434 \
    APZ_AI_MODEL=qwen2.5:7b-instruct \
    APZ_EMBED_MODEL=BAAI/bge-small-en-v1.5 \
    HF_HOME=/data/hf-cache \
    TRANSFORMERS_CACHE=/data/hf-cache \
    TORCH_HOME=/data/torch-cache \
    CUDA_VISIBLE_DEVICES=0 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- وابستگی‌های سیستمی ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip \
        build-essential pkg-config git curl wget ca-certificates \
        # YARA + XML + image
        libyara-dev yara \
        libxml2-dev libxslt1-dev libffi-dev \
        libjpeg-dev libfreetype6-dev zlib1g-dev \
        # PDF (اختیاری برای weasyprint)
        libpango-1.0-0 libpangoft2-1.0-0 libcairo2 \
        libgdk-pixbuf-2.0-0 shared-mime-info \
        fonts-dejavu fonts-noto-core fonts-noto-color-emoji \
        # GPU tooling
        nvidia-cuda-toolkit \
        # general
        tini \
    && rm -rf /var/lib/apt/lists/*

# ---------- venv ----------
RUN python3.11 -m venv /opt/venv && \
    pip install --upgrade pip wheel setuptools

# ---------- هسته‌ی تحلیل APZ ----------
COPY requirements-android.txt* requirements.txt* /tmp/reqs/
RUN if [ -f /tmp/reqs/requirements-android.txt ]; then \
        pip install -r /tmp/reqs/requirements-android.txt; \
    elif [ -f /tmp/reqs/requirements.txt ]; then \
        pip install -r /tmp/reqs/requirements.txt; \
    else \
        pip install androguard pyyaml flask sqlalchemy yara-python requests rich; \
    fi

# ---------- PyTorch با CUDA 12.1 ----------
RUN pip install --extra-index-url https://download.pytorch.org/whl/cu121 \
        torch==2.3.1+cu121 \
        torchvision==0.18.1+cu121 \
        torchaudio==2.3.1+cu121

# ---------- ONNX Runtime GPU ----------
RUN pip install onnxruntime-gpu==1.18.0

# ---------- ML / Embedding / LLM ----------
RUN pip install \
        transformers==4.42.4 \
        sentence-transformers==3.0.1 \
        accelerate==0.32.1 \
        safetensors==0.4.3 \
        huggingface-hub==0.24.0 \
        tokenizers==0.19.1 \
        # Ollama client
        ollama==0.3.0 \
        # utilities
        numpy scipy scikit-learn pandas \
        # tokenization for APK strings
        tiktoken \
        # onnx + ops
        onnx \
        # PDF/optional
        jinja2

# ---------- weasyprint (اختیاری) ----------
RUN pip install weasyprint==62.3 || true

# ---------- کاربر non-root ----------
RUN groupadd -r apz -g 1000 && \
    useradd -r -g apz -u 1000 -m -d /home/apz -s /bin/bash apz

# ---------- سورس پروژه ----------
WORKDIR ${APZ_HOME}
COPY --chown=apz:apz . ${APZ_HOME}

# پوشه‌های داده (کش مدل، گزارش‌ها، دیتابیس)
RUN mkdir -p \
        /data/reports \
        /data/logs \
        /data/rules \
        /data/hf-cache \
        /data/torch-cache \
        /data/models \
        /data/embeddings \
    && chown -R apz:apz /data ${APZ_HOME}

# ---------- entrypoint / healthcheck ----------
COPY --chown=apz:apz docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=apz:apz docker/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY --chown=apz:apz docker/healthcheck-gpu.sh /usr/local/bin/healthcheck-gpu.sh 2>/dev/null || true
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh \
    && ([ -f /usr/local/bin/healthcheck-gpu.sh ] && chmod +x /usr/local/bin/healthcheck-gpu.sh || true)

USER apz

EXPOSE 5000

VOLUME ["/data"]

# healthcheck (سبک، با /stats)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["api"]
```

