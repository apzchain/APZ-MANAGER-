// ─── در contract-ui.js، بعد از getStateMutabilityBadge ───

function renderStandardBadge(std) {
  const tooltip = std.fullName + (std.method === 'erc165' ? ' · verified via ERC-165' : '');
  const verified = std.confidence === 'verified' ? '✓ ' : '';
  return `
    <span class="std-badge std-${std.color}" title="${escapeHtml(tooltip)}">
      <span class="std-badge-icon">${std.icon}</span>
      <span class="std-badge-name">${verified}${escapeHtml(std.name)}</span>
    </span>
  `;
}

function renderStandardsRow(standards) {
  if (!standards || standards.length === 0) return '';

  return `
    <div class="std-row">
      ${standards.map(renderStandardBadge).join('')}
    </div>
  `;
}

function renderTokenInfo(info) {
  if (!info.isToken) return '';

  const parts = [];

  if (info.name) {
    parts.push(`
      <div class="token-info-item">
        <div class="token-info-label">Name</div>
        <div class="token-info-value">${escapeHtml(info.name)}</div>
      </div>
    `);
  }

  if (info.symbol) {
    parts.push(`
      <div class="token-info-item">
        <div class="token-info-label">Symbol</div>
        <div class="token-info-value highlight">${escapeHtml(info.symbol)}</div>
      </div>
    `);
  }

  if (info.decimals != null) {
    parts.push(`
      <div class="token-info-item">
        <div class="token-info-label">Decimals</div>
        <div class="token-info-value">${info.decimals}</div>
      </div>
    `);
  }

  if (info.totalSupply) {
    const supply = (() => {
      try {
        const dec = info.decimals != null ? Number(info.decimals) : 18;
        const big = BigInt(info.totalSupply);
        const div = 10n ** BigInt(dec);
        return (Number(big / div) + Number(big % div) / Number(div)).toLocaleString('en-US', { maximumFractionDigits: 4 });
      } catch {
        return info.totalSupply;
      }
    })();
    parts.push(`
      <div class="token-info-item">
        <div class="token-info-label">Total Supply</div>
        <div class="token-info-value highlight">${escapeHtml(supply)}</div>
      </div>
    `);
  }

  if (info.proxy) {
    parts.push(`
      <div class="token-info-item">
        <div class="token-info-label">Proxy</div>
        <div class="token-info-value">
          <span class="proxy-type">${escapeHtml(info.proxy.type)}</span>
          <code class="proxy-impl" title="${escapeHtml(info.proxy.implementation)}">
            ${info.proxy.implementation.slice(0, 10)}...${info.proxy.implementation.slice(-6)}
          </code>
        </div>
      </div>
    `);
  }

  if (parts.length === 0) return '';

  return `
    <div class="token-info">
      <div class="token-info-header">
        <span class="token-type-chip token-type-${info.tokenType}">
          ${info.tokenType === 'fungible' ? '🪙 Fungible' :
            info.tokenType === 'nft' ? '🖼️ NFT' :
            info.tokenType === 'multi-token' ? '🎨 Multi-Token' :
            info.tokenType === 'vault' ? '🏦 Vault' : info.tokenType}
        </span>
      </div>
      <div class="token-info-grid">
        ${parts.join('')}
      </div>
    </div>
  `;
}
