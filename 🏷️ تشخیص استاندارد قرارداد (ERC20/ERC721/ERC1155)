// ─── در بالای فایل ───
const STANDARD = window.APZ_STANDARD;

// ─── در performSearch، بخش contract ───
if (info.isContract) {
  const chainId = RPC.hexToNumber(await RPC.getChainId());

  // موازی: ABI + Source + Bytecode + Standard Detection
  const [abiInfo, sourceInfo, bytecode] = await Promise.all([
    ABI.fetchABI(chainId, query),
    SOURCE.fetchSource(chainId, query),
    RPC.getCode(query)
  ]);

  const finalAbiInfo = (sourceInfo.abi && (!abiInfo.abi || !abiInfo.verified))
    ? { ...abiInfo, abi: sourceInfo.abi, verified: true, source: sourceInfo.source }
    : abiInfo;

  if (finalAbiInfo.abi) {
    await CONTRACT.attachSelectors(finalAbiInfo.abi);
  }
  window.__currentABI = (finalAbiInfo.abi || []).filter((x) => x.type === 'function');

  // ✨ تشخیص استاندارد (موازی با کارهای دیگر)
  let standardInfo = null;
  try {
    standardInfo = await STANDARD.detect(query, finalAbiInfo.abi || []);
    console.log('[Standard] Detected:', standardInfo.standards.map((s) => s.name));
  } catch (err) {
    console.warn('[Standard] Detection failed:', err);
  }

  // ─── ذخیره داده‌ها ───
  currentContractData = {
    address: query,
    chainId,
    abiInfo: finalAbiInfo,
    sourceInfo,
    bytecode,
    standardInfo
  };

  // ─── ساخت محتوای تب‌ها ───
