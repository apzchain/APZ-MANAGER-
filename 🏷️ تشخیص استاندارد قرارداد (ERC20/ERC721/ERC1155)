      icon: '📦',
      required: ['multicall(bytes[])']
    }
  ];

  // ─── Proxy Storage Slots ───
  const PROXY_SLOTS = {
    // EIP-1967: Implementation
    'eip1967-impl': '0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc',
    // EIP-1967: Beacon
    'eip1967-beacon': '0xa3f0ad74e5423aebfd80d3ef4346578335a9a72aeaee59ff6cb3582b35133d50',
    // EIP-1967: Admin
    'eip1967-admin': '0xb53127684a568b3173ae13b9f8a6016e243e63b6e8ee1178d6a717850b5d6103',
    // EIP-1822: Proxiable UUID
    'eip1822': '0xc5f16f0fcc639fa48a6947836d9850f504798523bf8c9a3a87d5876cf622bcf7'
  };

  // ─── Build ABI Signature Set ───
  function buildSignatureSet(abi) {
    const fns = new Set();
    const events = new Set();
    const errors = new Set();

    for (const item of abi || []) {
      const inputs = (item.inputs || []).map((i) => i.type).join(',');
      const sig = `${item.name}(${inputs})`;

      if (item.type === 'function') fns.add(sig);
      else if (item.type === 'event') events.add(sig);
      else if (item.type === 'error') errors.add(sig);
    }

    return { fns, events, errors };
  }

  // ─── Check Required ───
  function hasAll(required, set) {
    if (!required || required.length === 0) return true;
    return required.every((r) => set.has(r));
  }

  function hasAny(required, set) {
    return required.some((r) => set.has(r));
  }

  // ─── Detect by ABI Heuristic ───
  function detectByABI(abi) {
    const { fns, events } = buildSignatureSet(abi);
    const matched = [];

    for (const std of STANDARDS) {
      const fnsOk = hasAll(std.required, fns);
      const eventsOk = !std.events || hasAll(std.events, events);

      if (fnsOk && eventsOk) {
        matched.push({
          id: std.id,
          name: std.name,
          fullName: std.fullName,
          color: std.color,
          icon: std.icon,
          interfaceId: std.interfaceId || null,
          method: 'abi',
          confidence: 'high'
        });
      }
    }

    // حذف زیرمجموعه‌ها اگر والد ضعیف‌تر است (اختیاری)
    // مثلاً اگر ERC20Permit دارد، ERC20 هم دارد که خوب است

    return matched;
  }

  // ─── Detect by ERC165 ───
  async function detectByERC165(address) {
    const results = [];
    const checks = Object.entries(INTERFACE_IDS).filter(([, id]) => id !== null);

    for (const [name, interfaceId] of checks) {
      try {
        // supportsInterface(bytes4)
        const selector = '0x01ffc9a7';
        const data = selector + interfaceId.slice(2).padStart(64, '0');

        const res = await RPC.call('eth_call', [
          { to: address, data },
          'latest'
        ]);

        const supported = res && res !== '0x' && BigInt(res) === 1n;
        if (supported) {
          results.push(name);
        }
      } catch (err) {
        // احتمالاً قرارداد ERC165 ندارد — بی‌صدا رد شو
      }
    }

    return results;
  }

  // ─── Detect Proxy ───
  async function detectProxy(address) {
    const detected = [];

    for (const [name, slot] of Object.entries(PROXY_SLOTS)) {
      try {
        const res = await RPC.call('eth_getStorageAt', [address, slot, 'latest']);
        if (res && res !== '0x' && res.length > 2) {
          const implAddress = '0x' + res.slice(26);
          if (implAddress !== '0x0000000000000000000000000000000000000000') {
            detected.push({
              type: name,
              implementation: implAddress
            });
          }
        }
      } catch (err) {
        // نادیده بگیر
      }
    }

    return detected;
  }

  // ─── Merge Results ───
  function mergeResults(abiMatches, erc165Matches) {
    const map = new Map();

    // ابتدا ABI matches
    for (const m of abiMatches) {
      map.set(m.id, m);
    }

    // ERC165 matches: تأیید یا اضافه
    const erc165ToId = {
      ERC165: 'ERC165',
      ERC721: 'ERC721',
      ERC721Metadata: 'ERC721Metadata',
      ERC721Enumerable: 'ERC721Enumerable',
      ERC1155: 'ERC1155',
      ERC1155MetadataURI: 'ERC1155',
      ERC2981: 'ERC2981'
    };

    for (const name of erc165Matches) {
      const id = erc165ToId[name] || name;
      if (map.has(id)) {
        // تأیید توسط ERC165
        map.get(id).method = 'erc165';
        map.get(id).confidence = 'verified';
      } else {
        // اضافه کن اگر در ABI نبود
        const std = STANDARDS.find((s) => s.id === id);
        if (std) {
          map.set(id, {
            id: std.id,
            name: std.name,
            fullName: std.fullName,
            color: std.color,
            icon: std.icon,
            interfaceId: std.interfaceId || null,
            method: 'erc165',
            confidence: 'verified'
          });
        }
      }
    }

    // ترتیب: استانداردهای اصلی اول
    const order = ['ERC20', 'ERC721', 'ERC1155', 'ERC4626', 'ERC20Metadata',
      'ERC721Metadata', 'ERC721Enumerable', 'ERC20Permit', 'ERC2981', 'ERC165',
      'Ownable', 'AccessControl', 'Pausable', 'Multicall'];

    return Array.from(map.values()).sort((a, b) => {
      const ai = order.indexOf(a.id);
      const bi = order.indexOf(b.id);
      return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
    });
  }

  // ─── Main Detect ───
  async function detect(address, abi) {
    const result = {
      standards: [],
      proxy: null,
      isToken: false,
      tokenType: null,
      name: null,
      symbol: null,
      decimals: null,
      totalSupply: null
    };

    // 1. ABI heuristic
    const abiMatches = detectByABI(abi);

    // 2. ERC165 on-chain
    let erc165Matches = [];
    if (abiMatches.some((m) => m.id === 'ERC165')) {
      erc165Matches = await detectByERC165(address);
    }

    // 3. Merge
    result.standards = mergeResults(abiMatches, erc165Matches);

    // 4. Proxy
    const proxies = await detectProxy(address);
    if (proxies.length > 0) {
      result.proxy = proxies[0];
      result.standards.unshift({
        id: 'PROXY',
        name: 'Proxy',
        fullName: proxies[0].type,
        color: 'proxy',
        icon: '🔗',
        method: 'storage',
        confidence: 'verified'
      });
    }

    // 5. Token classification
    const ids = result.standards.map((s) => s.id);
    if (ids.includes('ERC20')) {
      result.isToken = true;
      result.tokenType = 'fungible';
    } else if (ids.includes('ERC721')) {
      result.isToken = true;
      result.tokenType = 'nft';
    } else if (ids.includes('ERC1155')) {
      result.isToken = true;
      result.tokenType = 'multi-token';
    } else if (ids.includes('ERC4626')) {
      result.isToken = true;
      result.tokenType = 'vault';
    }

    // 6. خواندن متادیتا (اختیاری، اگر ERC20/721 بود)
    if (result.isToken && abi) {
      await fetchTokenMetadata(result, address, abi);
    }

    return result;
  }

  // ─── Fetch Token Metadata ───
  async function fetchTokenMetadata(result, address, abi) {
    const CONTRACT = window.APZ_CONTRACT;
    if (!CONTRACT) return;

    const tryCall = async (fnName, args = []) => {
      try {
        const fn = abi.find((x) =>
          x.type === 'function' && x.name === fnName
        );
        if (!fn) return null;
        if (!fn._selector) fn._selector = await CONTRACT.computeSelector(fn);
        return await CONTRACT.callReadFunction(address, fn, args);
      } catch {
        return null;
      }
    };

    const [name, symbol, decimals, totalSupply] = await Promise.all([
      tryCall('name'),
      tryCall('symbol'),
      tryCall('decimals'),
      tryCall('totalSupply')
    ]);

    result.name = name;
    result.symbol = symbol;
    result.decimals = decimals;
    result.totalSupply = totalSupply;
  }

  // ─── Public API ───
  window.APZ_STANDARD = {
    detect,
    detectByABI,
    detectByERC165,
    detectProxy,
    INTERFACE_IDS,
    STANDARDS
  };
})();
