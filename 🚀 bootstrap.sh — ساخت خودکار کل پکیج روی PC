detect_lan_ip() {
if command -v ip >/dev/null 2>&1; then
ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' | head -1 && return
fi
if command -v ifconfig >/dev/null 2>&1; then
ifconfig 2>/dev/null | grep -oP 'inet \K[\d.]+' | grep -v '127.0.0.1' | head -1 && return
fi
echo "127.0.0.1"
}

render_qr() {
local data="$1"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 "${data}"
return 0
fi
if python3 -c "import qrcode" >/dev/null 2>&1; then
python3 - <<PYQR
import qrcode
q = qrcode.QRCode(border=1)
q.add_data("""${data}""")
q.make()
q.print_ascii(invert=True)
PYQR
return 0
fi
c_yellow "    [!] qrencode یا python-qrcode نصب نیست (برای QR نصب کنید: pip install qrcode)."
return 1
