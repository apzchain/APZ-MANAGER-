from future import annotations
import os, re, shutil
from pathlib import Path

TARGETS = ["apz_manager.py", "apz_api.py", "apz_orchestrator.py"]
BACKUP_SUFFIX = ".android.bak"

def is_android() -> bool:
return ("ANDROID_ROOT" in os.environ) or ("com.termux" in os.environ.get("PREFIX", ""))

def backup(path: Path) -> None:
bak = path.with_suffix(path.suffix + BACKUP_SUFFIX)
if not bak.exists():
shutil.copy2(path, bak)
print(f"[+] بکاپ: {bak}")

def patch_tkinter(path: Path) -> bool:
src = path.read_text(encoding="utf-8")
if "TKINTER_AVAILABLE" in src: return False
pat = re.compile(r"^(import tkinter.|from tkinter import .)$", re.MULTILINE)
if not pat.search(src): return False
def _w(m): return ("try:\n    " + m.group(0) + "\n    TKINTER_AVAILABLE = True\n"
"except Exception:\n    TKINTER_AVAILABLE = False\n")
new, n = pat.subn(_w, src, count=1)
if n:
path.write_text(new, encoding="utf-8")
print(f"[+] tkinter guard: {path.name}")
return True
return False

def patch_weasyprint(path: Path) -> bool:
src = path.read_text(encoding="utf-8")
if "WEASYPRINT_AVAILABLE" in src: return False
pat = re.compile(r"^(from weasyprint import .+|import weasyprint.*)$", re.MULTILINE)
if not pat.search(src): return False
def _w(m): return ("try:\n    " + m.group(0) + "\n    WEASYPRINT_AVAILABLE = True\n"
"except Exception:\n    WEASYPRINT_AVAILABLE = False\n")
new, n = pat.subn(_w, src, count=1)
if n:
path.write_text(new, encoding="utf-8")
print(f"[+] weasyprint guard: {path.name}")
return True
return False

def patch_default_outdir(path: Path) -> bool:
src = path.read_text(encoding="utf-8")
if "APZ_DEFAULT_OUTDIR" in src: return False
inject = ("\n# --- APZ Android Patch ---\n"
"import pathlib as _apz_pl\n"
"APZ_DEFAULT_OUTDIR = _apz_pl.Path.home() / 'apz-reports'\n"
"APZ_DEFAULT_OUTDIR.mkdir(parents=True, exist_ok=True)\n"
"# --- End APZ Patch ---\n\n")
lines = src.splitlines(keepends=True)
at = 0
for i, ln in enumerate(lines[:60]):
if ln.startswith(("import ", "from ")) or ln.strip() == "": at = i + 1
else: break
path.write_text("".join(lines[:at]) + inject + "".join(lines[at:]), encoding="utf-8")
print(f"[+] APZ_DEFAULT_OUTDIR: {path.name}")
return True

def main() -> None:
root = Path(file).resolve().parent
print(f"[i] شاخه: {root}")
print(f"[i] Android: {is_android()}")
changed = False
for name in TARGETS:
p = root / name
if not p.exists():
print(f"[=] {name} نیست، رد شد."); continue
backup(p)
changed |= patch_tkinter(p) | patch_weasyprint(p) | patch_default_outdir(p)
print("✅ پچ‌ها اعمال شد." if changed else "[=] تغییری لازم نبود.")

if name == "main":
main()
