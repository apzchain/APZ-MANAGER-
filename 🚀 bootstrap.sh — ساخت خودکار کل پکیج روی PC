def _risk_color(level: str) -> str:
return {"CRITICAL":"#8b0000","HIGH":"#d9534f","MEDIUM":"#f0ad4e",
"LOW":"#5bc0de","CLEAN":"#5cb85c","UNKNOWN":"#777"}.get((level or "").upper(),"#777")

def _findings_to_rows(findings):
if not findings:
return "<tr><td colspan='4' style='text-align:center;color:#888;'>یافته‌ای نیست.</td></tr>"
rows = []
for f in findings:
title = f.get("title_fa") or f.get("title") or "-"
