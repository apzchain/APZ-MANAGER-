ev = f.get("evidence") or []
if isinstance(ev, list):
ev = "
".join(f"<code>{e}</code>" for e in ev)
rows.append(f"<tr><td><b>{title}</b></td><td style='text-align:center;'>{w}</td><td>{d}</td><td>{ev}</td></tr>")
return "\n".join(rows)

def _list_to_html(items, empty_msg="—"):
if not items: return f"<span style='color:#888;'>{empty_msg}</span>"
if isinstance(items, (str, bytes)): return f"<code>{items}</code>"
return "<ul>" + "".join(f"<li><code>{i}</code></li>" for i in items) + "</ul>"

