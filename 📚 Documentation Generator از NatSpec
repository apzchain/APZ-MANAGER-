  // ─── Contract Card ───
  function renderContract(contract, index) {
    const id = anchorId('contract', contract.name);
    const hasContent = contract.functions.length || contract.events.length ||
      contract.errors.length || contract.modifiers.length ||
      contract.stateVars.length;

    return `
      <details class="doc-contract" id="${id}" ${index === 0 ? 'open' : ''}>
        <summary class="doc-contract-summary">
          <div class="doc-contract-title">
            <span class="doc-contract-kind">${contract.kind}${contract.abstract ? ' abstract' : ''}</span>
            <span class="doc-contract-name">${escapeHtml(contract.name)}</span>
