.doc-stat-coverage.good .doc-stat-num { color: #00ffcc; }
.doc-stat-coverage.fair .doc-stat-num { color: #ffc107; }
.doc-stat-coverage.poor .doc-stat-num { color: #ff3860; }

.doc-coverage-bar {
