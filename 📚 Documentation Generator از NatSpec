  gap: 4px;
}

.doc-btn:hover {
  color: var(--neon);
  border-color: var(--border-hover);
}

/* ─── Header (Pragma/Imports) ─── */
.doc-header {
  padding: 14px 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.doc-header-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  flex-wrap: wrap;
}

.doc-header-label {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dimmer);
  font-weight: 700;
  min-width: 80px;
}

.doc-header-value,
.doc-import {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--neon);
  padding: 3px 10px;
  background: rgba(0, 255, 204, 0.05);
  border: 1px solid rgba(0, 255, 204, 0.15);
  border-radius: 6px;
}

.doc-header-imports {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* ─── Contract Details ─── */
.doc-contracts {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.doc-contract {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  overflow: hidden;
  transition: var(--transition);
}

.doc-contract[open] {
  border-color: rgba(0, 255, 204, 0.25);
  box-shadow: 0 0 24px rgba(0, 255, 204, 0.06);
}

.doc-contract-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  cursor: pointer;
  list-style: none;
  user-select: none;
  gap: 12px;
  flex-wrap: wrap;
}

.doc-contract-summary::-webkit-details-marker { display: none; }

.doc-contract-title {
  display: flex;
  align-items: baseline;
  gap: 10px;
  flex-wrap: wrap;
  min-width: 0;
}

.doc-contract-kind {
  padding: 3px 10px;
  background: rgba(168, 85, 247, 0.15);
  color: #c8a3f7;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
