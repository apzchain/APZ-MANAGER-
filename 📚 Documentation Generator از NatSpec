/* ═══════════════════════════════════════════════
   APZ Wallet — Docs Viewer
   Binds interactions: search, expand/collapse, copy, TOC
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  let activeSearch = '';
  let searchHits = [];
  let currentHitIndex = 0;

  // ─── Helpers ───
  function showToast(message, type = 'success') {
    window.dispatchEvent(new CustomEvent('apz-toast', {
      detail: { message, type }
    }));
  }

  function copyToClipboard(text) {
    return navigator.clipboard.writeText(text);
  }

  // ─── Expand / Collapse ───
  function expandAll(container, expand = true) {
    container.querySelectorAll('details').forEach((d) => {
      d.open = expand;
    });
  }

  // ─── Search ───
  function performSearch(query, container) {
    activeSearch = query.trim().toLowerCase();
    const countEl = container.querySelector('#doc-search-count');

    // پاک کردن highlightهای قبلی
    container.querySelectorAll('.doc-search-hit').forEach((el) => {
      const parent = el.parentNode;
      parent.replaceChild(document.createTextNode(el.textContent), el);
      parent.normalize();
    });
    container.querySelectorAll('[data-search-hidden]').forEach((el) => {
      delete el.dataset.searchHidden;
      el.style.display = '';
    });

    if (!activeSearch || activeSearch.length < 2) {
      countEl.textContent = '';
      searchHits = [];
      currentHitIndex = 0;
      return;
    }

    // پیدا کردن همه‌ی items با data-searchable
    const items = container.querySelectorAll('[data-searchable]');
    let hits = 0;

    items.forEach((item) => {
      const text = (item.dataset.searchable || '').toLowerCase();
      if (text.includes(activeSearch)) {
        hits++;
        // باز کردن parent details
        const parentDetails = item.closest('details');
        if (parentDetails) parentDetails.open = true;
      }
    });

    // جستجو در متن کامل برای highlight
    if (hits === 0) {
      countEl.textContent = '0';
      countEl.classList.add('no-match');
      return;
    }

    countEl.classList.remove('no-match');
    countEl.textContent = `${hits}`;
  }

  // ─── Keyboard Navigation ───
  function setupKeyboard(container) {
    document.addEventListener('keydown', (e) => {
      const search = container.querySelector('#doc-search');

      // Ctrl/Cmd + F → focus search
      if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
        if (container.contains(document.activeElement) || search === document.activeElement) {
          e.preventDefault();
          search?.focus();
        }
      }

      // Escape → clear search
      if (e.key === 'Escape' && document.activeElement === search) {
        search.value = '';
        performSearch('', container);
        search.blur();
      }
    });
  }

  // ─── Bind ───
  function bind(container) {
    // Copy signature buttons
    container.querySelectorAll('.doc-copy-sig').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const sig = btn.dataset.sig;
        try {
          await copyToClipboard(sig);
          showToast('Signature copied!', 'success');
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1200);
        } catch {
          showToast('Copy failed', 'error');
        }
      });
    });

    // Expand all
    container.querySelector('#doc-expand-all')?.addEventListener('click', () => {
      expandAll(container, true);
    });

    // Collapse all
    container.querySelector('#doc-collapse-all')?.addEventListener('click', () => {
      expandAll(container, false);
    });

    // Search
    const searchInput = container.querySelector('#doc-search');
    if (searchInput) {
      let debounce;
      searchInput.addEventListener('input', () => {
        clearTimeout(debounce);
        debounce = setTimeout(() => {
          performSearch(searchInput.value, container);
        }, 200);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          // پرش به اولین نتیجه
          const first = container.querySelector('[data-searchable]:not([data-search-hidden])');
          if (first) {
            first.scrollIntoView({ behavior: 'smooth', block: 'center' });
            first.classList.add('doc-flash');
            setTimeout(() => first.classList.remove('doc-flash'), 1500);
          }
        }
      });
    }

    // Anchor links (برای jump از URL hash)
    container.querySelectorAll('[id^="doc-"]').forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.tagName === 'SUMMARY' || e.target.closest('summary')) {
          // اجازه بده که details باز/بسته شود
          return;
        }
        // اگر روی anchor کلیک شد، URL hash را آپدیت کن
        if (e.target.classList.contains('doc-item-name')) {
          history.replaceState(null, '', `#${el.id}`);
          copyToClipboard(`${location.origin}${location.pathname}${location.search}#${el.id}`);
          showToast('Link copied!', 'success');
        }
      });
    });

    setupKeyboard(container);
  }

  // ─── Public API ───
  window.APZ_DOCS_VIEWER = {
    bind,
    expandAll,
    performSearch
  };
})();
