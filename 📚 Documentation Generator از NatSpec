  gap: 12px;
  align-items: flex-start;
}

.ns-block-dev {
  background: rgba(168, 85, 247, 0.05);
  border-left-color: #a855f7;
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.ns-block-icon {
  font-size: 1.1rem;
  flex-shrink: 0;
  line-height: 1;
  margin-top: 2px;
}

.ns-block-body { flex: 1; min-width: 0; }

.ns-block-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dimmer);
  font-weight: 700;
  margin-bottom: 6px;
}

.ns-block-text {
  font-size: 0.85rem;
  color: var(--text);
  line-height: 1.6;
}

.ns-params {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ns-param-row {
  display: flex;
  gap: 10px;
  align-items: baseline;
  padding: 4px 0;
  font-size: 0.82rem;
  line-height: 1.5;
}

.ns-param-name {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--neon);
  padding: 2px 8px;
  background: rgba(0, 255, 204, 0.08);
  border-radius: 4px;
  flex-shrink: 0;
}

.ns-param-desc {
  color: var(--text);
  flex: 1;
  word-break: break-word;
}

.ns-custom {
  padding: 10px 14px;
  background: rgba(136, 146, 176, 0.05);
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ns-empty {
  padding: 10px 14px;
  font-size: 0.82rem;
  color: var(--text-dimmer);
  font-style: italic;
  background: var(--bg-2);
  border-radius: 8px;
  text-align: center;
}

/* ─── Item (Function/Event/Error/Modifier) ─── */
.doc-item {
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  transition: var(--transition);
}

.doc-item:hover { border-color: var(--border-hover); }

.doc-item[open] { border-color: rgba(0, 255, 204, 0.2); }

.doc-item-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  cursor: pointer;
  user-select: none;
  list-style: none;
  gap: 12px;
}

.doc-item-summary::-webkit-details-marker { display: none; }

.doc-item-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  flex: 1;
}

.doc-item-kind {
  font-size: 0.62rem;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  flex-shrink: 0;
}

.kind-read { background: rgba(0, 255, 204, 0.1); color: var(--neon); }
.kind-write { background: rgba(255, 193, 7, 0.1); color: var(--warn); }
