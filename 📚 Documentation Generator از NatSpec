    `;
  }

  // ─── Event Card ───
  function renderEvent(ev) {
    const id = anchorId('ev', ev.name);
    return `
      <details class="doc-item doc-ev" id="${id}" data-searchable="${escapeHtml(ev.name + ' ' + (ev.docs?.notice || ''))}">
        <summary class="doc-item-summary">
          <div class="doc-item-left">
            <span class="doc-item-kind kind-event">event</span>
