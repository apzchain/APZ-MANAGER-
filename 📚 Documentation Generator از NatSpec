function toMarkdown(parsed) {
  let md = '';
  for (const c of parsed.contracts) {
    md += `# ${c.name}\n\n`;
    if (c.docs.notice) md += `> ${c.docs.notice}\n\n`;
    for (const fn of c.functions) {
      md += `## \`${formatSignature(fn, 'function')}\`\n\n`;
      if (fn.docs.notice) md += `${fn.docs.notice}\n\n`;
    }
  }
  return md;
}
