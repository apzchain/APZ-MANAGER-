  min-width: 0;
}

.doc-search::placeholder { color: var(--text-dimmer); }

.doc-search-count {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--neon);
  padding: 2px 6px;
  background: rgba(0, 255, 204, 0.1);
  border-radius: 4px;
}

.doc-search-count.no-match {
  color: var(--danger);
  background: rgba(255, 56, 96, 0.1);
}

.doc-btn {
  padding: 6px 12px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text-dim);
  font-family: inherit;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
