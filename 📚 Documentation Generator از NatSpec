  // ─── Modifier Card ───
  function renderModifier(mod) {
    const id = anchorId('mod', mod.name);
    return `
      <details class="doc-item doc-mod" id="${id}" data-searchable="${escapeHtml(mod.name + ' ' + (mod.docs?.notice || ''))}">
