.kind-error { background: rgba(255, 56, 96, 0.1); color: var(--danger); }
.kind-modifier { background: rgba(0, 184, 255, 0.1); color: #00b8ff; }

.doc-item-name {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--text);
  cursor: copy;
  overflow: hidden;
  text-overflow: ellipsis;
}

.doc-item-name:hover { color: var(--neon); text-decoration: underline dashed; text-underline-offset: 3px; }

.doc-item-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.doc-vis {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--text-dimmer);
}

.doc-item-body {
  padding: 0 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  animation: docSlide 200ms;
}

@keyframes docSlide {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ─── Signature ─── */
.doc-signature {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
}

.doc-signature-code {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--neon);
  flex: 1;
  word-break: break-all;
  line-height: 1.5;
}

.doc-copy-sig {
  background: transparent;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
  padding: 6px;
  border-radius: 6px;
  transition: var(--transition);
  flex-shrink: 0;
}

.doc-copy-sig:hover {
  color: var(--neon);
  background: rgba(0, 255, 204, 0.1);
}

.doc-copy-sig.copied { color: var(--success); }

/* ─── I/O Grid ─── */
.doc-io-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.doc-io-col {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.doc-io-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-dimmer);
  font-weight: 700;
}

.doc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.doc-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 10px;
  background: rgba(0, 184, 255, 0.08);
  border: 1px solid rgba(0, 184, 255, 0.2);
  border-radius: 6px;
  font-size: 0.72rem;
}

.doc-chip-out {
  background: rgba(0, 255, 204, 0.06);
  border-color: rgba(0, 255, 204, 0.2);
}

.doc-chip code {
  font-family: var(--font-mono);
  color: #00b8ff;
  font-size: 0.72rem;
}

.doc-chip-out code { color: var(--neon); }

.doc-chip-name {
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: 0.68rem;
}

.doc-chip-empty {
  font-size: 0.78rem;
  color: var(--text-dimmer);
  font-style: italic;
}

/* ─── State Var ─── */
.doc-var-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.doc-var {
  padding: 10px 14px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  transition: var(--transition);
}

.doc-var:hover { border-color: var(--border-hover); }

.doc-var-sig {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: #ffcb6b;
  word-break: break-all;
}

.doc-var-notice {
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-top: 6px;
  line-height: 1.5;
}

/* ─── Flash Effect for Search Jump ─── */
.doc-flash {
  animation: docFlash 1.5s ease-out;
}

@keyframes docFlash {
  0%, 100% { background: transparent; }
  30% { background: rgba(0, 255, 204, 0.15); }
}

/* ─── Error ─── */
.doc-error {
  padding: 20px;
  background: rgba(255, 56, 96, 0.06);
  border: 1px solid rgba(255, 56, 96, 0.2);
  border-radius: 12px;
  color: var(--danger);
  font-size: 0.85rem;
  text-align: center;
}

/* ─── Responsive ─── */
@media (max-width: 640px) {
  .doc-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .doc-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .doc-toolbar-left,
  .doc-toolbar-right {
    width: 100%;
  }

  .doc-search-wrap { min-width: auto; flex: 1; }

  .doc-btn { flex: 1; justify-content: center; }

  .doc-io-grid { grid-template-columns: 1fr; }

  .doc-contract-body { padding: 0 14px 16px; }
  .doc-item-body { padding: 0 14px 14px; }

  .ns-param-row { flex-direction: column; align-items: flex-start; gap: 4px; }
  .ns-param-name { align-self: flex-start; }

  .doc-contract-summary { padding: 14px; }
  .doc-item-summary { padding: 10px 14px; }
}

/* ─── RTL ─── */
[dir="rtl"] .doc-item-name { text-align: right; }
[dir="rtl"] .ns-block { border-left: none; border-right: 3px solid var(--neon); }
[dir="rtl"] .ns-block-dev { border-right-color: #a855f7; }
[dir="rtl"] .doc-signature-code { direction: ltr; text-align: left; }
[dir="rtl"] .doc-var-sig { direction: ltr; text-align: left; }
```

