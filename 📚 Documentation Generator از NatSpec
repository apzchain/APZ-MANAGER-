}

.ns-row-inherit {
  background: rgba(255, 203, 107, 0.05);
  border-color: rgba(255, 203, 107, 0.15);
}

.ns-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
