  // ─── Helpers ───
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function anchorId(prefix, name) {
    return `doc-${prefix}-${name.replace(/[^a-zA-Z0-9_]/g, '_')}`;
  }

  function formatSignature(item, kind) {
    if (kind === 'function') {
      const inputs = (item.inputs || []).map((i) =>
        `${i.type}${i.indexed ? ' indexed' : ''}${i.name ? ' ' + i.name : ''}`
      ).join(', ');
      const outputs = (item.outputs || []).map((o) =>
        `${o.type}${o.name ? ' ' + o.name : ''}`
      ).join(', ');
      const mut = item.stateMutability || 'nonpayable';
      const mutStr = ['view', 'pure', 'payable'].includes(mut) ? ` ${mut}` : '';
      const vis = item.visibility || 'public';
      const mods = item.modifiers && item.modifiers.length
        ? ' ' + item.modifiers.join(' ')
        : '';
      const outs = outputs ? ` returns (${outputs})` : '';
      return `function ${item.name}(${inputs}) ${vis}${mutStr}${mods}${outs}`;
    }
    if (kind === 'event') {
      const inputs = (item.inputs || []).map((i) =>
        `${i.type}${i.indexed ? ' indexed' : ''}${i.name ? ' ' + i.name : ''}`
      ).join(', ');
      return `event ${item.name}(${inputs})`;
    }
    if (kind === 'error') {
      const inputs = (item.inputs || []).map((i) =>
        `${i.type}${i.name ? ' ' + i.name : ''}`
      ).join(', ');
      return `error ${item.name}(${inputs})`;
    }
    if (kind === 'modifier') {
      const inputs = (item.inputs || []).map((i) => i.type).join(', ');
      return `modifier ${item.name}(${inputs})`;
    }
    if (kind === 'stateVar') {
      return `${item.type} ${item.visibility} ${item.name}${item.constant ? ' constant' : ''}${item.immutable ? ' immutable' : ''}`;
    }
    return item.name || '';
  }

