    if (docs.title) {
      parts.push(`
        <div class="ns-row ns-row-title">
          <span class="ns-label">${t('title')}</span>
          <span class="ns-value">${escapeHtml(docs.title)}</span>
        </div>
      `);
    }

    // author
    if (docs.author) {
      parts.push(`
        <div class="ns-row">
          <span class="ns-label">${t('author')}</span>
          <span class="ns-value">${escapeHtml(docs.author)}</span>
        </div>
      `);
    }

    // inheritdoc
    if (docs.inheritdoc) {
      parts.push(`
        <div class="ns-row ns-row-inherit">
          <span class="ns-label">${t('inheritdoc')}</span>
          <span class="ns-value ns-mono">${escapeHtml(docs.inheritdoc)}</span>
        </div>
      `);
    }

    // notice
    if (docs.notice) {
      parts.push(`
        <div class="ns-block ns-block-notice">
          <div class="ns-block-icon">📢</div>
          <div class="ns-block-body">
            <div class="ns-block-label">${t('notice')}</div>
            <div class="ns-block-text">${escapeHtml(docs.notice).replace(/\n/g, '<br>')}</div>
          </div>
        </div>
      `);
    }

    // dev
    if (docs.dev) {
      parts.push(`
        <div class="ns-block ns-block-dev">
          <div class="ns-block-icon">⚙️</div>
          <div class="ns-block-body">
            <div class="ns-block-label">${t('dev')}</div>
            <div class="ns-block-text">${escapeHtml(docs.dev).replace(/\n/g, '<br>')}</div>
          </div>
        </div>
      `);
    }

    // params
    const paramNames = Object.keys(docs.params || {});
    if (paramNames.length > 0) {
      const rows = paramNames.map((name) => `
        <div class="ns-param-row">
          <code class="ns-param-name">${escapeHtml(name)}</code>
          <span class="ns-param-desc">${escapeHtml(docs.params[name])}</span>
        </div>
      `).join('');
      parts.push(`
        <div class="ns-block">
          <div class="ns-block-label">${t('params')}</div>
          <div class="ns-params">${rows}</div>
        </div>
      `);
    }

    // returns
    if (docs.returnsList && docs.returnsList.length > 0) {
      const rows = docs.returnsList.map((r) => `
        <div class="ns-param-row">
          ${r.name ? `<code class="ns-param-name">${escapeHtml(r.name)}</code>` : ''}
          <span class="ns-param-desc">${escapeHtml(r.desc)}</span>
        </div>
      `).join('');
      parts.push(`
        <div class="ns-block">
          <div class="ns-block-label">${t('returns')}</div>
          <div class="ns-params">${rows}</div>
        </div>
      `);
    }

    // custom tags
    const customKeys = Object.keys(docs.custom || {});
    if (customKeys.length > 0) {
      const rows = customKeys.map((key) => `
        <div class="ns-row">
          <span class="ns-label">@${escapeHtml(key)}</span>
          <span class="ns-value">${escapeHtml(docs.custom[key])}</span>
        </div>
      `).join('');
      parts.push(`<div class="ns-custom">${rows}</div>`);
    }

    if (parts.length === 0) {
      return `<div class="ns-empty">${t('noDocs')}</div>`;
    }

    return `<div class="ns-content">${parts.join('')}</div>`;
  }

  // ─── Code Signature Block ───
  function renderSignature(item, kind) {
    const sig = formatSignature(item, kind);
    const mutability = item.stateMutability || '';
    const visibility = item.visibility || '';
    const badgeClass = (mutability === 'view' || mutability === 'pure') ? 'view' : 'write';

    return `
      <div class="doc-signature">
        <code class="doc-signature-code">${escapeHtml(sig)}</code>
        <button class="doc-copy-sig" data-sig="${escapeHtml(sig)}" title="${t('copySignature')}">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
        </button>
      </div>
    `;
  }

  // ─── Function Card ───
  function renderFunction(fn) {
    const id = anchorId('fn', fn.name + (fn.kind === 'constructor' ? '_ctor' : ''));
    const isRead = ['view', 'pure'].includes(fn.stateMutability);
    const kindLabel = fn.kind === 'constructor' ? t('constructor')
      : fn.kind === 'special' ? t(fn.name) // fallback/receive
      : isRead ? t('readFunction') : t('writeFunction');

    const inputChips = (fn.inputs || []).map((i) => `
      <span class="doc-chip">
        <code>${escapeHtml(i.type)}</code>
        ${i.name ? `<span class="doc-chip-name">${escapeHtml(i.name)}</span>` : ''}
      </span>
    `).join('') || `<span class="doc-chip-empty">—</span>`;

    const outputChips = (fn.outputs || []).map((o) => `
      <span class="doc-chip doc-chip-out">
        <code>${escapeHtml(o.type)}</code>
        ${o.name ? `<span class="doc-chip-name">${escapeHtml(o.name)}</span>` : ''}
      </span>
    `).join('') || `<span class="doc-chip-empty">—</span>`;

    return `
      <details class="doc-item doc-fn" id="${id}" data-searchable="${escapeHtml(fn.name + ' ' + (fn.docs?.notice || '') + ' ' + (fn.docs?.dev || ''))}">
        <summary class="doc-item-summary">
          <div class="doc-item-left">
            <span class="doc-item-kind ${isRead ? 'kind-read' : 'kind-write'}">${kindLabel}</span>
            <span class="doc-item-name">${escapeHtml(fn.name)}</span>
          </div>
          <div class="doc-item-right">
            ${fn.stateMutability && fn.stateMutability !== 'nonpayable' ? `<span class="mutability-badge ${isRead ? 'view' : 'write'}">${fn.stateMutability}</span>` : ''}
            ${fn.visibility ? `<span class="doc-vis">${fn.visibility}</span>` : ''}
            <svg class="doc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </div>
        </summary>

        <div class="doc-item-body">
          ${renderSignature(fn, 'function')}

          <div class="doc-io-grid">
            <div class="doc-io-col">
              <div class="doc-io-label">${t('params')}</div>
              <div class="doc-chips">${inputChips}</div>
            </div>
            <div class="doc-io-col">
              <div class="doc-io-label">${t('returns')}</div>
              <div class="doc-chips">${outputChips}</div>
