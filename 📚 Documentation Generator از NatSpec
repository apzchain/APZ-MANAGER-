  transition: width 600ms cubic-bezier(0.4, 0, 0.2, 1);
}

.doc-stat-coverage.excellent .doc-coverage-fill { background: linear-gradient(90deg, #00ff88, #00ffcc); }
.doc-stat-coverage.good .doc-coverage-fill { background: linear-gradient(90deg, #00ffcc, #00b8ff); }
.doc-stat-coverage.fair .doc-coverage-fill { background: linear-gradient(90deg, #ffc107, #ff9800); }
.doc-stat-coverage.poor .doc-coverage-fill { background: linear-gradient(90deg, #ff3860, #ff6b6b); }

/* ─── Toolbar ─── */
.doc-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  flex-wrap: wrap;
}

.doc-toolbar-left,
.doc-toolbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.doc-search-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 6px 12px;
  color: var(--text-dim);
  transition: var(--transition);
  min-width: 220px;
}

.doc-search-wrap:focus-within {
  border-color: var(--neon);
