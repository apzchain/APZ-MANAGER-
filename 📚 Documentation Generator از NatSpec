          ${contract.functions.length ? `
            <div class="doc-section">
              <h4 class="doc-section-title">${t('functions')}</h4>
              <div class="doc-list">
                ${contract.functions.map(renderFunction).join('')}
              </div>
            </div>
          ` : ''}

          ${contract.events.length ? `
            <div class="doc-section">
              <h4 class="doc-section-title">${t('events')}</h4>
              <div class="doc-list">
                ${contract.events.map(renderEvent).join('')}
              </div>
            </div>
          ` : ''}

          ${contract.errors.length ? `
            <div class="doc-section">
              <h4 class="doc-section-title">${t('errors')}</h4>
              <div class="doc-list">
                ${contract.errors.map(renderError).join('')}
              </div>
            </div>
          ` : ''}

          ${!hasContent ? `
            <div class="doc-empty-note">${t('noNatSpec')}</div>
          ` : ''}
        </div>
      </details>
    `;
  }

  // ─── Coverage Bar ───
  function getCoverageClass(pct) {
    if (pct >= 80) return 'excellent';
    if (pct >= 60) return 'good';
    if (pct >= 40) return 'fair';
    return 'poor';
  }

  function getCoverageLabel(pct) {
    if (pct >= 80) return t('excellent');
    if (pct >= 60) return t('good');
    if (pct >= 40) return t('fair');
    return t('poor');
  }

  function renderCoverage(stats) {
    const cls = getCoverageClass(stats.coverage);
    return `
      <div class="doc-stats-grid">
        <div class="doc-stat-card">
          <div class="doc-stat-num">${stats.contracts}</div>
          <div class="doc-stat-lbl">${t('contracts')}</div>
        </div>
        <div class="doc-stat-card">
          <div class="doc-stat-num">${stats.functions}</div>
          <div class="doc-stat-lbl">${t('functions')}</div>
        </div>
        <div class="doc-stat-card">
          <div class="doc-stat-num">${stats.events}</div>
          <div class="doc-stat-lbl">${t('events')}</div>
        </div>
        <div class="doc-stat-card doc-stat-coverage ${cls}">
          <div class="doc-stat-num">${stats.coverage}%</div>
          <div class="doc-stat-lbl">${t('coverage')} · ${getCoverageLabel(stats.coverage)}</div>
          <div class="doc-coverage-bar">
            <div class="doc-coverage-fill" style="width:${stats.coverage}%"></div>
          </div>
        </div>
      </div>
    `;
  }

  // ─── Header (Pragma, Imports) ───
  function renderHeader(parsed, address, chainId) {
    const parts = [];

    if (parsed.pragma) {
      parts.push(`
        <div class="doc-header-row">
          <span class="doc-header-label">${t('pragma')}</span>
          <code class="doc-header-value">solidity ${escapeHtml(parsed.pragma)}</code>
        </div>
      `);
    }

    if (parsed.imports.length > 0) {
      parts.push(`
        <div class="doc-header-row">
          <span class="doc-header-label">${t('imports')}</span>
          <div class="doc-header-imports">
            ${parsed.imports.map((i) => `<code class="doc-import">${escapeHtml(i)}</code>`).join('')}
          </div>
        </div>
      `);
    }

    if (parts.length === 0) return '';

    return `<div class="doc-header">${parts.join('')}</div>`;
  }

  // ─── Toolbar ───
  function renderToolbar() {
    return `
      <div class="doc-toolbar">
        <div class="doc-toolbar-left">
          <div class="doc-search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" class="doc-search" id="doc-search" placeholder="${t('searchDocs')}" />
            <span class="doc-search-count" id="doc-search-count"></span>
          </div>
        </div>
        <div class="doc-toolbar-right">
          <button class="doc-btn" id="doc-expand-all">↧ ${t('expandAll')}</button>
          <button class="doc-btn" id="doc-collapse-all">↥ ${t('collapseAll')}</button>
        </div>
      </div>
    `;
  }

  // ─── Main Render ───
  function render(source, address, chainId) {
    if (!source || !source.trim()) {
      return renderNoSource();
    }

    let parsed;
    try {
      parsed = PARSER.parseSource(source);
    } catch (err) {
      console.error('[Docs] Parse error:', err);
      return `<div class="doc-error">Failed to parse source: ${escapeHtml(err.message)}</div>`;
    }

    const stats = PARSER.getStats(parsed);

    if (parsed.contracts.length === 0) {
      return renderNoSource();
    }

    return `
      <div class="docs-wrapper" data-source-size="${source.length}">
        ${renderCoverage(stats)}
        ${renderToolbar()}
        ${renderHeader(parsed, address, chainId)}
        <div class="doc-contracts">
          ${parsed.contracts.map((c, i) => renderContract(c, i)).join('')}
        </div>
      </div>
    `;
  }

  // ─── No Source ───
  function renderNoSource() {
    return `
      <div class="docs-wrapper docs-empty">
        <div class="doc-empty-icon">📚</div>
        <h3>${t('noDocs')}</h3>
        <p>${t('noNatSpec')}</p>
      </div>
    `;
  }

  // ─── Public ───
  window.APZ_DOCS_GEN = {
    render,
    setLang: (lang) => { currentLang = lang; },
    getLang: () => currentLang
  };
})();
