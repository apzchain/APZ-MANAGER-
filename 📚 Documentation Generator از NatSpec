6️⃣ 🔄 ادغام در explorer.js

```javascript
// ─── در بالای فایل ───
const DOCS_GEN = window.APZ_DOCS_GEN;
const DOCS_VIEWER = window.APZ_DOCS_VIEWER;
const NATSPEC = window.APZ_NATSPEC;

let currentContractData = {
  address: null,
  chainId: null,
  abiInfo: null,
  sourceInfo: null,
  bytecode: null
};

// ─── در performSearch، بخش contract ───
if (info.isContract) {
  const chainId = RPC.hexToNumber(await RPC.getChainId());

  // موازی: ABI + Source + Bytecode
  const [abiInfo, sourceInfo, bytecode] = await Promise.all([
    ABI.fetchABI(chainId, query),
    SOURCE.fetchSource(chainId, query),
    RPC.getCode(query)
  ]);

  const finalAbiInfo = (sourceInfo.abi && (!abiInfo.abi || !abiInfo.verified))
    ? { ...abiInfo, abi: sourceInfo.abi, verified: true, source: sourceInfo.source }
    : abiInfo;

  if (finalAbiInfo.abi) {
    await CONTRACT.attachSelectors(finalAbiInfo.abi);
  }
  window.__currentABI = (finalAbiInfo.abi || []).filter((x) => x.type === 'function');

  // ─── ذخیره داده‌ها برای تب‌ها ───
  currentContractData = {
    address: query,
    chainId,
    abiInfo: finalAbiInfo,
    sourceInfo,
    bytecode
  };

  // ─── ساخت محتوای همه‌ی تب‌ها ───
  const overviewHtml = CONTRACT_UI.renderContract(query, finalAbiInfo, bytecode, showToast);
  const sourceHtml = (sourceInfo.files && sourceInfo.files.length > 0)
    ? SRC_VIEWER.renderSource(sourceInfo, query, chainId)
    : SRC_VIEWER.renderNoSource(query, chainId);

  // ─── Docs ───
  let docsHtml;
  const mainFile = sourceInfo.files?.find((f) => f.isMain) || sourceInfo.files?.[0];
  if (mainFile?.content) {
    docsHtml = DOCS_GEN.render(mainFile.content, query, chainId);
  } else {
    docsHtml = DOCS_GEN.renderNoSource();
  }

  // ─── ABI JSON ───
  const abiJson = finalAbiInfo.abi
    ? JSON.stringify(finalAbiInfo.abi, null, 2)
    : '// ABI not available';
  const abiHtml = `
    <div class="result-card">
      <div class="card-section-title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
        ABI
        <button class="btn btn-ghost small" id="copy-abi-btn" style="margin-inline-start:auto">📋 Copy ABI</button>
      </div>
      <pre class="abi-json"><code>${escapeHtml(abiJson)}</code></pre>
    </div>
  `;

  // ─── Tabs ───
  html = `
    <div class="result-tabs" id="result-tabs" style="display:flex">
      <button class="result-tab active" data-tab="overview">${t('tabs.overview') || 'Overview'}</button>
      <button class="result-tab" data-tab="source">${t('tabs.source') || 'Source'}</button>
      <button class="result-tab" data-tab="docs">${t('tabs.docs') || 'Documentation'}</button>
      <button class="result-tab" data-tab="abi">${t('tabs.abi') || 'ABI'}</button>
    </div>
    <div class="tab-panel active" data-panel="overview">${overviewHtml}</div>
    <div class="tab-panel" data-panel="source" hidden>${sourceHtml}</div>
    <div class="tab-panel" data-panel="docs" hidden>${docsHtml}</div>
    <div class="tab-panel" data-panel="abi" hidden>${abiHtml}</div>
  `;
}

// ─── بعد از content.innerHTML = html ───
if (type === 'address' && currentContractData.address) {
  bindContractInteractions(content, query);
  bindSourceInteractions(content, query, currentContractData.chainId);
  bindDocsInteractions(content);
  bindTabs(content);
  bindCopyABI(content);
}

// ═══════════════════════════════════════════
// Tab Binder
// ═══════════════════════════════════════════
function bindTabs(container) {
  const tabs = container.querySelectorAll('.result-tab');
  const panels = container.querySelectorAll('.tab-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;

      tabs.forEach((t) => t.classList.toggle('active', t === tab));
      panels.forEach((p) => {
        const show = p.dataset.panel === target;
        p.hidden = !show;
        p.classList.toggle('active', show);
      });

      // ذخیره در URL
      const params = new URLSearchParams(location.search);
      params.set('tab', target);
      history.replaceState(null, '', `?${params.toString()}`);
    });
  });

  // فعال‌سازی از URL
  const params = new URLSearchParams(location.search);
  const tab = params.get('tab');
  if (tab) {
    const targetTab = container.querySelector(`.result-tab[data-tab="${tab}"]`);
    targetTab?.click();
  }
}

// ═══════════════════════════════════════════
// Docs Binder
// ═══════════════════════════════════════════
function bindDocsInteractions(container) {
  const docsPanel = container.querySelector('[data-panel="docs"] .docs-wrapper');
  if (!docsPanel) return;
  DOCS_VIEWER.bind(docsPanel);
}

// ═══════════════════════════════════════════
// Copy ABI
// ═══════════════════════════════════════════
function bindCopyABI(container) {
  document.getElementById('copy-abi-btn')?.addEventListener('click', () => {
    const abiText = container.querySelector('.abi-json code')?.textContent || '';
    navigator.clipboard.writeText(abiText).then(() => {
      showToast('ABI copied!', 'success');
    });
  });
}

// ─── در applyLang ───
DOCS_GEN.setLang(lang);
DOCS_VIEWER.setLang?.(lang);
