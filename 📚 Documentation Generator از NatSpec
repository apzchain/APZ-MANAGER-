اگر قرارداد ERC20 یا ERC721 است، برچسب استاندارد اضافه کنید:

```javascript
function detectStandard(parsed) {
  const fnNames = parsed.contracts[0]?.functions.map(f => f.name) || [];
  if (fnNames.includes('transfer') && fnNames.includes('balanceOf') && fnNames.includes('approve')) {
    return 'ERC20';
  }
  if (fnNames.includes('ownerOf') && fnNames.includes('safeTransferFrom')) {
    return 'ERC721';
  }
  return null;
}
