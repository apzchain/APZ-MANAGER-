/* ═══════════════════════════════════════════════
   APZ Wallet — NatSpec Parser
   Parses Solidity NatSpec comments + source structure
   Format reference: https://docs.soliditylang.org/en/latest/natspec-format.html
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  // ─── NatSpec Tag Patterns ───
  const TAGS = [
    'title', 'author', 'notice', 'dev', 'param', 'return', 'returns',
    'inheritdoc', 'custom', 'custom:event', 'custom:error', 'custom:modifier'
  ];

  // ─── Regex Patterns ───
  const RE = {
    // /// line comment
    lineComment: /^\s*\/\/\/\s?(.*)$/,
    // /** ... */ block comment
    blockCommentStart: /^\s*\/\*\*\s*(.*)$/,
    blockCommentEnd: /^\s*\*\/\s*$/,
    blockCommentLine: /^\s*\*\s?(.*)$/,

    // NatSpec tag
    tag: /^\s*@(\w+(?::\w+)?)\s+(.*)$/,

    // Solidity constructs
    pragma: /^\s*pragma\s+solidity\s+([^;]+);/,
    import: /^\s*import\s+(?:"([^"]+)"|'([^']+)'|(\{[^}]+\})\s+from\s+["']([^"']+)["'])/,
    contract: /^\s*(abstract\s+)?(contract|interface|library)\s+(\w+)(?:\s+is\s+([^{]+))?\s*\{/,
    function: /^\s*function\s+(\w+)\s*\(([^)]*)\)\s*(.*?)(?:\{|$)/,
    constructor: /^\s*constructor\s*\(([^)]*)\)\s*(.*?)(?:\{|$)/,
    fallback: /^\s*(fallback|receive)\s*\(\)\s*(.*?)(?:\{|$)/,
    event: /^\s*event\s+(\w+)\s*\(([^)]*)\)\s*;/,
    error: /^\s*error\s+(\w+)\s*\(([^)]*)\)\s*;/,
    modifier: /^\s*modifier\s+(\w+)\s*(?:\(([^)]*)\))?\s*(?:virtual\s+)?(?:\{|;)/,
    struct: /^\s*struct\s+(\w+)\s*\{/,
    enum: /^\s*enum\s+(\w+)\s*\{/,
    using: /^\s*using\s+(\w+)\s+for\s+(\w+|\*)\s*;/,
    stateVar: /^\s*([\w\[\]<>,\s]+?)\s+(public|private|internal|constant|immutable|\s)+?\s*(\w+)\s*(?:=[^;]+)?\s*;/
  };

  // ─── Split source into lines ───
  function splitLines(source) {
    return source.replace(/\r\n/g, '\n').split('\n');
  }

  // ─── Extract a NatSpec block from lines ───
  function extractNatSpec(lines, startIndex) {
    const comments = [];
    let i = startIndex;

    // حالت ۱: /// lines
    while (i >= 0 && RE.lineComment.test(lines[i])) {
      comments.unshift(lines[i].match(RE.lineComment)[1]);
      i--;
    }

    if (comments.length > 0) {
      return {
        raw: comments,
        startLine: i + 1,
        endLine: startIndex
      };
    }

    // حالت ۲: /** ... */ block
    if (RE.blockCommentEnd.test(lines[startIndex])) {
      let j = startIndex - 1;
      const blockLines = [];
      while (j >= 0) {
        if (RE.blockCommentStart.test(lines[j])) {
          const firstLine = lines[j].match(RE.blockCommentStart)[1];
          if (firstLine) blockLines.unshift(firstLine);
          return {
            raw: blockLines,
            startLine: j,
            endLine: startIndex
          };
        }
        const lineMatch = lines[j].match(RE.blockCommentLine);
        if (lineMatch) {
          blockLines.unshift(lineMatch[1]);
        } else {
          break;
        }
        j--;
      }
    }

    return null;
  }

  // ─── Parse NatSpec tags ───
  function parseNatSpec(rawLines) {
    const result = {
      title: null,
      author: null,
      notice: null,
      dev: null,
      params: {},
      returns: {},
      returnsList: [],
      inheritdoc: null,
      custom: {},
      extra: []
    };

    if (!rawLines || rawLines.length === 0) return result;

    let currentTag = null;
    let currentValue = [];

    const flush = () => {
      if (!currentTag) return;
      const text = currentValue.join('\n').trim();

      switch (currentTag) {
        case 'title': result.title = text; break;
        case 'author': result.author = text; break;
        case 'notice': result.notice = text; break;
        case 'dev': result.dev = text; break;
        case 'inheritdoc': result.inheritdoc = text; break;
        case 'param': {
          const m = text.match(/^(\w+)\s+(.*)$/s);
          if (m) result.params[m[1]] = m[2].trim();
          break;
        }
        case 'return':
        case 'returns': {
          // @return name desc  |  @return desc
          const m = text.match(/^(\w+)\s+(.*)$/s);
          if (m) {
            result.returns[m[1]] = m[2].trim();
            result.returnsList.push({ name: m[1], desc: m[2].trim() });
          } else {
            result.returnsList.push({ name: '', desc: text });
          }
          break;
        }
        default: {
          if (currentTag.startsWith('custom')) {
            const key = currentTag.replace(/^custom:?/, '') || 'custom';
            result.custom[key] = text;
          } else {
            result.extra.push({ tag: currentTag, text });
          }
        }
      }

      currentTag = null;
      currentValue = [];
    };

    for (const line of rawLines) {
      const tagMatch = line.match(RE.tag);
      if (tagMatch) {
        flush();
        currentTag = tagMatch[1];
        currentValue = [tagMatch[2]];
      } else if (currentTag) {
        currentValue.push(line);
      } else {
        // خطوط توضیحی بدون tag → به‌عنوان notice
        if (!result.notice) result.notice = line.trim();
      }
    }
    flush();

    return result;
  }

  // ─── Parse function parameters ───
  function parseParams(str) {
    if (!str || !str.trim()) return [];
    return str.split(',').map((p) => {
      const parts = p.trim().split(/\s+/);
      // uint256 _amount  |  uint256  |  address to
      if (parts.length === 1) {
        return { type: parts[0], name: '', indexed: false };
      }
      const indexed = parts.includes('indexed');
      const filtered = parts.filter((x) => x !== 'indexed' && x !== 'memory' && x !== 'calldata' && x !== 'storage');
      return {
        type: filtered[0] || parts[0],
        name: filtered[filtered.length - 1] || '',
        indexed
      };
    }).filter((p) => p.type);
  }

  // ─── Parse returns ───
  function parseReturns(str) {
    if (!str || !str.trim()) return [];
    // "returns (uint256, address)"
    const m = str.match(/returns\s*\(([^)]*)\)/);
    if (!m) return [];
    return parseParams(m[1]);
  }

  // ─── Extract modifiers ───
  function extractModifiers(str) {
    if (!str) return [];
    const matches = str.match(/\b([A-Z]\w+)\b(?!\s*\()/g);
    return matches ? [...new Set(matches)] : [];
  }

  // ─── Main: Parse Solidity Source ───
  function parseSource(source) {
    const lines = splitLines(source);
    const result = {
      pragma: null,
      imports: [],
      contracts: [],
      usingFor: []
    };

    let currentContract = null;
    let braceDepth = 0;

    for (let i = 0; i < lines.length; i++) {
      const line = lines[i];
      const trimmed = line.trim();

      if (!trimmed || trimmed.startsWith('//')) {
        // ادامه‌ی چک برای `@` tags قبلی
        continue;
      }

      // ─── خارج از قرارداد ───
      if (!currentContract) {
        // pragma
        const pm = trimmed.match(RE.pragma);
        if (pm) {
          result.pragma = pm[1];
          continue;
        }
        // import
        const im = trimmed.match(RE.import);
        if (im) {
          result.imports.push(im[1] || im[2] || im[4]);
          continue;
        }
        // contract
        const cm = trimmed.match(RE.contract);
        if (cm) {
          const natSpec = extractNatSpec(lines, i - 1);
          const docs = parseNatSpec(natSpec?.raw || []);

          currentContract = {
            kind: cm[2],
            name: cm[3],
            abstract: !!cm[1],
            inherits: cm[4] ? cm[4].split(',').map((s) => s.trim().split(/\s+/)[0]) : [],
            docs,
            natSpecStartLine: natSpec?.startLine ?? i,
            definitionLine: i,
            functions: [],
            events: [],
            errors: [],
            modifiers: [],
            structs: [],
            enums: [],
            stateVars: [],
            usingFor: []
          };
          result.contracts.push(currentContract);
          braceDepth = 1;
          continue;
        }
      } else {
        // ─── داخل قرارداد ───

        // ردیابی عمق
        braceDepth += (line.match(/\{/g) || []).length;
        braceDepth -= (line.match(/\}/g) || []).length;

        if (braceDepth <= 0) {
          currentContract = null;
          continue;
        }

        // NatSpec قبل از تعریف؟
        const prevNatSpec = extractNatSpec(lines, i - 1);
        const docs = prevNatSpec ? parseNatSpec(prevNatSpec.raw) : {};

        // Function
        const fm = trimmed.match(RE.function);
        if (fm) {
          const sig = fm[3] || '';
          const returns = parseReturns(sig);
          const mutability = ['view', 'pure', 'payable'].find((m) => new RegExp(`\\b${m}\\b`).test(sig)) || 'nonpayable';
          currentContract.functions.push({
            name: fm[1],
            inputs: parseParams(fm[2]),
            outputs: returns.map((r) => ({ type: r.type, name: r.name })),
            visibility: ['public', 'private', 'internal', 'external'].find((v) => new RegExp(`\\b${v}\\b`).test(sig)) || 'public',
            stateMutability: mutability,
            modifiers: extractModifiers(sig),
            virtual: /\bvirtual\b/.test(sig),
            override: /\boverride\b/.test(sig),
            docs,
            line: i
          });
          continue;
        }

        // Constructor
        const cst = trimmed.match(RE.constructor);
        if (cst) {
          currentContract.functions.push({
            name: 'constructor',
            kind: 'constructor',
            inputs: parseParams(cst[1]),
            outputs: [],
            visibility: 'public',
            stateMutability: 'nonpayable',
            modifiers: extractModifiers(cst[2]),
            docs,
            line: i
          });
          continue;
        }

        // Fallback / Receive
        const fb = trimmed.match(RE.fallback);
        if (fb) {
          currentContract.functions.push({
            name: fb[1],
            kind: 'special',
            inputs: [],
            outputs: [],
            visibility: 'external',
            stateMutability: 'payable',
            modifiers: [],
            docs,
            line: i
          });
          continue;
        }

        // Event
        const em = trimmed.match(RE.event);
        if (em) {
          currentContract.events.push({
            name: em[1],
            inputs: parseParams(em[2]),
            docs,
            line: i
          });
          continue;
        }

        // Error
        const er = trimmed.match(RE.error);
        if (er) {
          currentContract.errors.push({
            name: er[1],
            inputs: parseParams(er[2]),
            docs,
            line: i
          });
          continue;
        }

        // Modifier
        const mm = trimmed.match(RE.modifier);
        if (mm) {
          currentContract.modifiers.push({
            name: mm[1],
            inputs: parseParams(mm[2] || ''),
            docs,
            line: i
          });
          continue;
        }

        // Struct
        const st = trimmed.match(RE.struct);
        if (st) {
          currentContract.structs.push({
            name: st[1],
            docs,
            line: i
          });
          continue;
        }

        // Enum
        const en = trimmed.match(RE.enum);
        if (en) {
          currentContract.enums.push({
            name: en[1],
            docs,
            line: i
          });
          continue;
        }

        // using ... for
        const um = trimmed.match(RE.using);
        if (um) {
          currentContract.usingFor.push({ library: um[1], target: um[2] });
          continue;
        }

        // State Variable
        const svm = trimmed.match(RE.stateVar);
        if (svm && !trimmed.includes('(')) {
          const visibility = ['public', 'private', 'internal'].find((v) => new RegExp(`\\b${v}\\b`).test(trimmed));
          if (visibility) {
            currentContract.stateVars.push({
              type: svm[1].trim(),
              name: svm[3],
              visibility,
              constant: /\bconstant\b/.test(trimmed),
              immutable: /\bimmutable\b/.test(trimmed),
              docs,
              line: i
            });
          }
        }
      }
    }

    return result;
  }

  // ─── Stats ───
  function getStats(parsed) {
    const stats = {
      contracts: parsed.contracts.length,
      functions: 0,
      events: 0,
      errors: 0,
      modifiers: 0,
      stateVars: 0,
      documented: 0,
      totalDocs: 0,
      coverage: 0
    };

    let total = 0;

    for (const c of parsed.contracts) {
      stats.functions += c.functions.length;
      stats.events += c.events.length;
      stats.errors += c.errors.length;
      stats.modifiers += c.modifiers.length;
      stats.stateVars += c.stateVars.length;

      total += 1 + c.functions.length + c.events.length + c.errors.length + c.modifiers.length + c.stateVars.length;

      // documented count
      const checkDoc = (item) => {
        const d = item.docs || {};
        return !!(d.notice || d.dev || d.title || Object.keys(d.params || {}).length);
      };

      if (checkDoc(c)) stats.documented++;
      c.functions.forEach((f) => checkDoc(f) && stats.documented++);
      c.events.forEach((e) => checkDoc(e) && stats.documented++);
      c.errors.forEach((e) => checkDoc(e) && stats.documented++);
      c.modifiers.forEach((m) => checkDoc(m) && stats.documented++);
      c.stateVars.forEach((s) => checkDoc(s) && stats.documented++);
    }

    stats.totalDocs = total;
    stats.coverage = total > 0 ? Math.round((stats.documented / total) * 100) : 0;
    return stats;
  }

  // ─── Public API ───
  window.APZ_NATSPEC = {
    parseSource,
    parseNatSpec,
    parseParams,
    getStats,
    extractNatSpec
  };
})();
