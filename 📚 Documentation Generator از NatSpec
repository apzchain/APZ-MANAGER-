              </span>
            ` : ''}
          </div>
          <div class="doc-contract-stats">
            ${contract.functions.length ? `<span class="doc-stat-chip">${contract.functions.length} ${t('functions')}</span>` : ''}
            ${contract.events.length ? `<span class="doc-stat-chip">${contract.events.length} ${t('events')}</span>` : ''}
            ${contract.modifiers.length ? `<span class="doc-stat-chip">${contract.modifiers.length} ${t('modifiers')}</span>` : ''}
            <svg class="doc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
