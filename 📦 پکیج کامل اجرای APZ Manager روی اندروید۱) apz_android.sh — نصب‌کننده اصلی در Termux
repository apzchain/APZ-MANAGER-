#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  APZ Manager - Android Installer (Termux native)
#  Author: APZ Security Team
#  License: GPLv3
# ============================================================
set -e

REPO_URL="${APZ_REPO_URL:-https://github.com/your-org/apz-manager.git}"
WORK_DIR="${HOME}/apz-manager"
VENV_DIR="${WORK_DIR}/venv"

c_green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
c_red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
c_cyan()   { printf "\033[1;36m%s\033[0m\n" "$1"; }

banner() {
    echo "============================================================"
    echo "        APZ Manager – Android Installer (Termux)            "
    echo "============================================================"
}

check_termux() {
    if [ ! -d "/data/data/com.termux" ]; then
        c_red "[!] این اسکریپت باید داخل Termux اجرا شود."
        exit 1
    fi
}

install_system_deps() {
    c_cyan ">>> [1/6] نصب پیش‌نیازهای سیستمی..."
    pkg update -y
    pkg upgrade -y
    pkg install -y \
        python python-pip git clang make binutils pkg-config \
        rust libxml2 libxslt libffi openssl zlib \
        libjpeg-turbo freetype libyaml libcrypt libandroid-support \
        termux-api
    c_green "[+] پیش‌نیازها نصب شد."
}

clone_repo() {
    c_cyan ">>> [2/6] دریافت ریپازیتوری..."
    if [ -d "${WORK_DIR}" ]; then
        c_yellow "[=] ریپازیتوری موجود است، به‌روزرسانی می‌شود..."
        cd "${WORK_DIR}" && git pull --rebase || true
    else
        git clone "${REPO_URL}" "${WORK_DIR}"
    fi
    cd "${WORK_DIR}"
    c_green "[+] ریپازیتوری آماده است: ${WORK_DIR}"
}

setup_venv() {
    c_cyan ">>> [3/6] ساخت محیط مجازی پایتون..."
    if [ ! -d "${VENV_DIR}" ]; then
        python -m venv "${VENV_DIR}"
    fi
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
    pip install --upgrade pip wheel setuptools
    c_green "[+] محیط مجازی فعال است."
}

install_python_deps() {
    c_cyan ">>> [4/6] نصب وابستگی‌های پایتون (ممکن است چند دقیقه طول بکشد)..."
    if [ -f "requirements-android.txt" ]; then
        pip install -r requirements-android.txt
    else
        c_yellow "[!] requirements-android.txt پیدا نشد، از لیست پیش‌فرض استفاده می‌شود..."
        pip install \
            androguard \
            pyyaml \
            flask \
            sqlalchemy \
            yara-python \
            requests \
            rich
    fi
    c_green "[+] وابستگی‌های پایتون نصب شد."
}

verify_install() {
    c_cyan ">>> [5/6] بررسی صحت نصب..."
    python - <<'PYEOF'
import sys
mods = ["androguard", "yara", "flask", "sqlalchemy", "requests"]
missing = []
for m in mods:
    try:
        __import__(m)
        print(f"  [OK] {m}")
    except Exception as e:
        print(f"  [!!] {m} -> {e}")
        missing.append(m)
if missing:
    print("\n[!] ماژول‌های ناموجود:", ", ".join(missing))
    sys.exit(1)
print("\n[+] همه‌ی ماژول‌های اصلی آماده‌اند.")
PYEOF
    c_green "[+] بررسی کامل شد."
}

apply_patches() {
    c_cyan ">>> [6/6] اعمال پچ‌های مخصوص اندروید..."
    if [ -f "patch_apz_manager.py" ]; then
        python patch_apz_manager.py || c_yellow "[!] پچ خودکار با خطا مواجه شد (ادامه می‌دهیم)."
    fi
    # جایگزینی report_generator
    if [ -f "report_generator_patch.py" ]; then
        cp -n report_generator.py report_generator.py.bak 2>/dev/null || true
        cp report_generator_patch.py report_generator.py
        c_green "[+] report_generator.py با نسخه‌ی سازگار جایگزین شد."
    fi
}

show_footer() {
    echo
    c_green "============================================================"
    c_green "        ✅ نصب APZ Manager روی اندروید کامل شد              "
    c_green "============================================================"
    echo
    echo "برای اجرای تحلیل:"
    echo "  bash ~/apz-manager/run_android.sh /sdcard/Download/app.apk"
    echo
    echo "برای فعال‌سازی دسترسی به حافظه‌ی گوشی (یک‌بار):"
    echo "  termux-setup-storage"
    echo
    echo "برای اجرای API:"
    echo "  cd ~/apz-manager && source venv/bin/activate && python apz_api.py"
    echo
}

main() {
    banner
    check_termux
    install_system_deps
    clone_repo
    setup_venv
    install_python_deps
    verify_install
    apply_patches
    show_footer
}

main "$@"
