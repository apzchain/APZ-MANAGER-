7️⃣ 🔄 ادغام در explorer.js

این تغییرات را اعمال کنید:

```javascript
// ─── در بالای فایل ───
const SOURCE = window.APZ_SOURCE;
const SRC_VIEWER = window.APZ_SOURCE_VIEWER;

// ─── در performSearch، بخش address (contract) ───
} else if (type === 'address') {
  const info = await RPC.getAddressInfo(query);

  if (info.isContract) {
    const chainId = RPC.hexToNumber(await RPC.getChainId());

    // موازی: ABI + Source + Bytecode
    const [abiInfo, sourceInfo, bytecode] = await Promise.all([
      ABI.fetchABI(chainId, query),
      SOURCE.fetchSource(chainId, query),
      RPC.getCode(query)
    ]);

    // اگر ABI از Sourcify هست ولی Source هم داریم، ادغام کن
    const finalAbiInfo = (sourceInfo.abi && (!abiInfo.abi || !abiInfo.verified))
      ? { ...abiInfo, abi: sourceInfo.abi, verified: true, source: sourceInfo.source }
      : abiInfo;

    if (finalAbiInfo.abi) {
      await CONTRACT.attachSelectors(finalAbiInfo.abi);
    }

    // ذخیره ABI برای bindContractInteractions
    window.__currentABI = (finalAbiInfo.abi || []).filter((x) => x.type === 'function');

    // رندر: ABI + توابع + Source
    html = CONTRACT_UI.renderContract(query, finalAbiInfo, bytecode, showToast);

    // ✨ افزودن Source Code
    if (sourceInfo.files && sourceInfo.files.length > 0) {
      html += SRC_VIEWER.renderSource(sourceInfo, query, chainId);
    } else {
      html += SRC_VIEWER.renderNoSource(query, chainId);
    }
  } else {
    html = renderAddress(info);
  }
}

// ─── بعد از content.innerHTML = html ───
if (type === 'address' && content.querySelector('.contract-header')) {
  bindContractInteractions(content, query);

  // ✨ Bind source viewer
  const chainId = RPC.hexToNumber(await RPC.getChainId());
  SRC_VIEWER.bindSourceInteractions(content, query, chainId);
}

// ─── در applyLang، بعد از به‌روزرسانی زبان ───
SRC_VIEWER.setLang(lang);
CONTRACT_UI.setLang(lang);

// ─── Listener برای toast از Source Viewer ───
window.addEventListener('apz-toast', (e) => {
  showToast(e.detail.message, e.detail.type || 'success');
});
```

