      fileUnavailable: 'Dateiinhalt nicht verfügbar (nur Hash vorhanden)',
      mainFile: 'Haupt'
    }
  };

  function t(key) {
    const dict = SRC_I18N[currentLang] || SRC_I18N.en;
    return dict[key] || key;
  }

  // ─── Helpers ───
  function escapeHtml(str) {
    return String(str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function shortPath(path, maxLen = 40) {
    if (path.length <= maxLen) return path;
    const parts = path.split('/');
    if (parts.length <= 2) return path.slice(0, maxLen - 3) + '...';
    return parts[0] + '/.../' + parts[parts.length - 1];
  }

  function getFileIcon(path) {
    if (path.endsWith('.sol')) return '📄';
    if (path.endsWith('.json')) return '⚙';
    if (path.endsWith('.md')) return '📖';
    if (path.endsWith('.js') || path.endsWith('.ts')) return '📜';
    return '📎';
  }

  // ─── Render Source Header ───
  function renderSourceHeader(sourceData) {
    const meta = [];

    if (sourceData.source) {
      meta.push(`<span class="src-meta-item"><span class="src-meta-label">${t('verifiedBy')}:</span> <span class="src-meta-value">${escapeHtml(sourceData.source)}</span></span>`);
    }
    if (sourceData.compiler) {
      meta.push(`<span class="src-meta-item"><span class="src-meta-label">${t('compiler')}:</span> <span class="src-meta-value">${escapeHtml(sourceData.compiler)}</span></span>`);
    }
    if (sourceData.license) {
      meta.push(`<span class="src-meta-item"><span class="src-meta-label">${t('license')}:</span> <span class="src-meta-value">${escapeHtml(sourceData.license)}</span></span>`);
    }
    if (sourceData.settings?.optimizer) {
      meta.push(`<span class="src-meta-item"><span class="src-meta-label">${t('optimizer')}:</span> <span class="src-meta-value">${sourceData.settings.optimizer.enabled ? '✓ enabled (' + (sourceData.settings.optimizer.runs || '200') + ')' : 'disabled'}</span></span>`);
    }
    if (sourceData.settings?.evmVersion) {
      meta.push(`<span class="src-meta-item"><span class="src-meta-label">${t('evmVersion')}:</span> <span class="src-meta-value">${escapeHtml(sourceData.settings.evmVersion)}</span></span>`);
    }

    return `
      <div class="result-card source-header">
        <div class="result-card-header">
          <div class="result-card-icon source">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <div style="flex:1;min-width:0">
            <div class="result-card-title">
              ${t('sourceCode')}
              <span class="badge success" style="margin-inline-start:8px">✓ ${t('verified')}</span>
              <span class="src-file-count">${sourceData.files.length} ${t('files')}</span>
            </div>
          </div>
        </div>

        ${meta.length ? `<div class="src-meta">${meta.join('')}</div>` : ''}
      </div>
    `;
  }

  // ─── Render File Tabs ───
  function renderFileTabs(files) {
    if (files.length <= 1) return '';

    return `
      <div class="src-tabs" role="tablist">
        ${files.map((f, i) => `
          <button
            class="src-tab ${i === activeFileIndex ? 'active' : ''}"
            data-file-index="${i}"
            role="tab"
            title="${escapeHtml(f.path)}"
          >
            <span class="src-tab-icon">${getFileIcon(f.path)}</span>
            <span class="src-tab-name">${escapeHtml(shortPath(f.path, 28))}</span>
            ${f.isMain ? `<span class="src-tab-badge">${t('mainFile')}</span>` : ''}
          </button>
        `).join('')}
      </div>
    `;
  }

  // ─── Render Code with Line Numbers ───
  function renderCode(content, language) {
    if (!content) {
      return `<div class="src-empty">${t('fileUnavailable')}</div>`;
    }

    let highlighted;

    if (viewMode === 'raw') {
      highlighted = escapeHtml(content);
    } else if (window.Prism) {
      // Prism.js در دسترس است
      try {
        const grammar = window.Prism.languages[language] || window.Prism.languages.javascript;
        highlighted = window.Prism.highlight(content, grammar, language);
      } catch (err) {
        console.warn('[Source] Prism failed, using fallback:', err);
        highlighted = HIGHLIGHT.highlight(content, language);
      }
    } else {
      // Fallback به highlighter ساده
      highlighted = HIGHLIGHT.highlight(content, language);
    }

    // شمارش خطوط
    const lineCount = content.split('\n').length;

    const lineNumbersHtml = Array.from({ length: lineCount }, (_, i) =>
      `<span class="src-line-num" data-line="${i + 1}">${i + 1}</span>`
    ).join('\n');

    return `
      <div class="src-code-wrapper">
        <div class="src-line-numbers" aria-hidden="true">${lineNumbersHtml}</div>
        <pre class="src-code" data-language="${escapeHtml(language)}"><code>${highlighted}</code></pre>
      </div>
    `;
  }

  // ─── Render Toolbar ───
  function renderToolbar(file) {
    return `
      <div class="src-toolbar">
        <div class="src-toolbar-left">
          <button class="src-btn" id="src-copy-btn" title="${t('copy')}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            <span>${t('copy')}</span>
          </button>

          <button class="src-btn" id="src-download-btn" title="${t('download')}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            <span>${t('download')}</span>
          </button>

          <button class="src-btn" id="src-download-all-btn" title="${t('downloadAll')}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            <span>${t('downloadAll')}</span>
          </button>
        </div>

        <div class="src-toolbar-right">
          <div class="src-search-wrap">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="text"
              class="src-search"
              id="src-search"
              placeholder="${t('searchPlaceholder')}"
            />
            <span class="src-search-count" id="src-search-count"></span>
          </div>

          <div class="src-view-switch" role="group" aria-label="View mode">
            <button class="src-view-btn ${viewMode === 'highlighted' ? 'active' : ''}" data-mode="highlighted">
              ${t('highlighted')}
            </button>
            <button class="src-view-btn ${viewMode === 'raw' ? 'active' : ''}" data-mode="raw">
              ${t('raw')}
            </button>
          </div>
        </div>
      </div>
    `;
  }

  // ─── Main Render ───
  function renderSource(sourceData, address, chainId) {
    if (!sourceData || !sourceData.files || sourceData.files.length === 0) {
      return renderNoSource(address, chainId);
    }

    currentSourceData = sourceData;
    activeFileIndex = 0;

    // اگر فایل main وجود دارد، آن را انتخاب کن
    const mainIndex = sourceData.files.findIndex((f) => f.isMain);
    if (mainIndex >= 0) activeFileIndex = mainIndex;

    const activeFile = sourceData.files[activeFileIndex];

    return `
      ${renderSourceHeader(sourceData)}
      <div class="result-card source-body">
        ${renderFileTabs(sourceData.files)}
        ${renderToolbar(activeFile)}
        <div class="src-code-container" id="src-code-container">
          ${renderCode(activeFile.content, activeFile.language)}
        </div>
      </div>
    `;
  }

  // ─── No Source ───
  function renderNoSource(address, chainId) {
    const sourcifyUrl = `https://sourcify.dev/#/lookup/${address}`;
    const explorerUrl = `https://repo.sourcify.dev/contracts/full_match/${chainId}/${address}/`;

    return `
      <div class="result-card source-empty">
        <div class="result-card-header">
          <div class="result-card-icon source">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <div>
            <div class="result-card-title">${t('sourceCode')}</div>
          </div>
        </div>

        <div class="src-notice">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <div>
            <strong>${t('sourceNotFound')}</strong>
            <p>${t('sourceNotFoundSub')}</p>
          </div>
        </div>

        <div class="src-empty-actions">
          <a class="btn btn-primary" href="${sourcifyUrl}" target="_blank" rel="noopener">
            🔍 ${t('trySourcify')}
          </a>
          <a class="btn btn-ghost" href="${explorerUrl}" target="_blank" rel="noopener">
            ↗ ${t('tryEtherscan')}
          </a>
        </div>
      </div>
    `;
  }

  // ─── Bind Interactions ───
  function bindSourceInteractions(container, address, chainId) {
    if (!currentSourceData) return;

    // Tabs
    container.querySelectorAll('.src-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.dataset.fileIndex, 10);
        switchFile(idx, container, address, chainId);
      });
    });

    // Copy
    document.getElementById('src-copy-btn')?.addEventListener('click', () => {
      const file = currentSourceData.files[activeFileIndex];
      if (!file.content) return;
      navigator.clipboard.writeText(file.content).then(() => {
        window.dispatchEvent(new CustomEvent('apz-toast', {
          detail: { message: t('copied'), type: 'success' }
        }));
      });
    });

    // Download current
    document.getElementById('src-download-btn')?.addEventListener('click', () => {
      const file = currentSourceData.files[activeFileIndex];
      if (!file.content) return;
      const filename = file.path.split('/').pop() || 'contract.sol';
      SOURCE.downloadFile(filename, file.content);
    });

    // Download all
    document.getElementById('src-download-all-btn')?.addEventListener('click', () => {
      SOURCE.downloadAsZip(
        currentSourceData.files,
        `contract-${address.slice(0, 10)}`
      );
    });

    // View mode
    container.querySelectorAll('.src-view-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        viewMode = btn.dataset.mode;
        container.querySelectorAll('.src-view-btn').forEach((b) => {
          b.classList.toggle('active', b.dataset.mode === viewMode);
        });
        refreshCode(container);
      });
    });

    // Search
    const searchInput = document.getElementById('src-search');
    if (searchInput) {
      let searchTimeout;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          performSearch(searchInput.value, container);
        }, 250);
      });
    }

    // Keyboard shortcut: Ctrl/Cmd + F → focus search
    const keyHandler = (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
        if (container.contains(document.activeElement) || !document.getElementById('src-search')?.hidden) {
          // فقط اگر داخل source viewer هستیم
          e.preventDefault();
          document.getElementById('src-search')?.focus();
        }
      }
    };
    document.addEventListener('keydown', keyHandler);
  }

  function switchFile(idx, container, address, chainId) {
    activeFileIndex = idx;
    const file = currentSourceData.files[idx];

    // Update tabs
    container.querySelectorAll('.src-tab').forEach((tab, i) => {
      tab.classList.toggle('active', i === idx);
    });

    // Re-render code container
    const codeContainer = document.getElementById('src-code-container');
    codeContainer.innerHTML = renderCode(file.content, file.language);

    // Reset search
    const searchInput = document.getElementById('src-search');
    if (searchInput) searchInput.value = '';
    document.getElementById('src-search-count').textContent = '';

    // Scroll to top
    codeContainer.scrollTop = 0;
  }

  function refreshCode(container) {
    const file = currentSourceData.files[activeFileIndex];
    const codeContainer = document.getElementById('src-code-container');
    codeContainer.innerHTML = renderCode(file.content, file.language);
  }

  function performSearch(query, container) {
    const countEl = document.getElementById('src-search-count');
    const codeEl = container.querySelector('.src-code');

    // پاک کردن highlightهای قبلی
    codeEl?.querySelectorAll('.src-search-match, .src-search-match-active')
      .forEach((el) => {
        const parent = el.parentNode;
        parent.replaceChild(document.createTextNode(el.textContent), el);
        parent.normalize();
      });

    if (!query || query.length < 2) {
      countEl.textContent = '';
      return;
    }

    // جستجو در متن ساده (ساده‌سازی شده)
    const file = currentSourceData.files[activeFileIndex];
    if (!file.content) return;

    const regex = new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
    const matches = file.content.match(regex);
    const count = matches ? matches.length : 0;

    if (count === 0) {
      countEl.textContent = t('noMatches');
      countEl.classList.add('no-match');
      return;
    }

    countEl.classList.remove('no-match');
    countEl.textContent = `${count} ${t('matches')}`;

    // هایلایت در HTML (ساده)
    // این کار در HTML هایلایت‌شده چالش‌برانگیز است
    // برای دقت بالا، از re-render استفاده می‌کنیم
    highlightInRendered(codeEl, query);
  }

  function highlightInRendered(container, query) {
    // پیمایش text nodes و جایگزینی
    const walker = document.createTreeWalker(
      container,
      NodeFilter.SHOW_TEXT,
      null
    );
    const textNodes = [];
    let node;
    while ((node = walker.nextNode())) {
      textNodes.push(node);
    }

    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');

    textNodes.forEach((textNode) => {
      if (!regex.test(textNode.nodeValue)) return;
      const frag = document.createDocumentFragment();
      const parts = textNode.nodeValue.split(regex);
      parts.forEach((part, i) => {
        if (i % 2 === 1) {
          const mark = document.createElement('mark');
          mark.className = 'src-search-match';
          mark.textContent = part;
          frag.appendChild(mark);
        } else {
          frag.appendChild(document.createTextNode(part));
        }
      });
      textNode.parentNode.replaceChild(frag, textNode);
    });
  }

  // ─── Public API ───
  window.APZ_SOURCE_VIEWER = {
    renderSource,
    renderNoSource,
    bindSourceInteractions,
    setLang: (lang) => { currentLang = lang; },
    getLang: () => currentLang
  };
})();
