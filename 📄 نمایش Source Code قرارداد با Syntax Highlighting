```javascript
/* ═══════════════════════════════════════════════
   APZ Wallet — Source Code Fetcher
   Sources:
     • Sourcify (repo.sourcify.dev) — بدون API key
     • Etherscan-compatible API (اختیاری)
     • Blockscout (اختیاری)
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  // ─── Configuration ───
  const CFG = {
    sourcify: {
      enabled: true,
      baseUrl: 'https://repo.sourcify.dev/contracts',
      matchTypes: ['full_match', 'partial_match']
    },
    blockscout: {
      enabled: false,
      baseUrl: null // مثلاً https://apz-blockscout.example.com
    },
    cacheTTL: 24 * 60 * 60 * 1000
  };

  const cache = new Map();

  function cacheKey(chainId, address) {
    return `src:${chainId}:${address.toLowerCase()}`;
  }

  function getCached(chainId, address) {
    const entry = cache.get(cacheKey(chainId, address));
    if (entry && Date.now() - entry.time < CFG.cacheTTL) return entry.data;
    return null;
  }

  function setCache(chainId, address, data) {
    cache.set(cacheKey(chainId, address), { data, time: Date.now() });
  }

  // ─── Source: Sourcify ───
  async function fetchFromSourcify(chainId, address) {
    if (!CFG.sourcify.enabled) return null;

    for (const matchType of CFG.sourcify.matchTypes) {
      try {
        const baseUrl = `${CFG.sourcify.baseUrl}/${matchType}/${chainId}/${address}`;

        // 1. metadata.json → برای گرفتن لیست فایل‌ها و اطلاعات
        const metaRes = await fetch(`${baseUrl}/metadata.json`);
        if (!metaRes.ok) continue;

        const metadata = await metaRes.json();
        const sources = metadata?.output?.sources || {};
        const settings = metadata?.settings || {};

        // 2. دریافت محتوای هر فایل
        const files = await Promise.all(
          Object.entries(sources).map(async ([path, info]) => {
            // اگر keccak hash موجود باشد، سورس واقعی را از repo می‌گیریم
            const fileUrl = `${baseUrl}/sources/${path}`;
            try {
              const fileRes = await fetch(fileUrl);
              if (fileRes.ok) {
                const content = await fileRes.text();
                return {
                  path,
                  content,
                  language: detectLanguage(path),
                  isMain: settings.compilationTarget &&
                    Object.keys(settings.compilationTarget).includes(path)
                };
              }
            } catch (err) {
              console.warn('[Source] File fetch failed:', path, err.message);
            }

            // Fallback: از metadata (فقط hash داریم)
            return {
              path,
              content: null,
              language: detectLanguage(path),
              keccak256: info.keccak256,
              isMain: false
            };
          })
        );

        // فایل‌های خالی را حذف کن
        const validFiles = files.filter((f) => f.content || f.keccak256);

        if (validFiles.length > 0) {
          console.log(`[Source] Sourcify (${matchType}): ${validFiles.length} files`);
          return {
            matchType,
            language: metadata.language || 'Solidity',
            compiler: metadata.compiler?.version || null,
            files: validFiles,
            settings: {
              optimizer: settings.optimizer,
              evmVersion: settings.evmVersion,
              libraries: settings.libraries
            },
            abi: metadata.output?.abi || null,
            contractName: metadata.settings?.compilationTarget
              ? Object.values(metadata.settings.compilationTarget)[0]
              : null,
            source: `Sourcify (${matchType.replace('_', ' ')})`,
            verified: true
          };
        }
      } catch (err) {
        console.warn(`[Source] Sourcify ${matchType} failed:`, err.message);
      }
    }
    return null;
  }

  // ─── Source: Blockscout ───
  async function fetchFromBlockscout(chainId, address) {
    if (!CFG.blockscout.enabled || !CFG.blockscout.baseUrl) return null;

    try {
      const url = `${CFG.blockscout.baseUrl}/api/v2/smart-contracts/${address}`;
      const res = await fetch(url);
      if (!res.ok) return null;

      const data = await res.json();
      if (!data.source_code) return null;

      const files = [{
        path: data.name ? `${data.name}.sol` : 'Contract.sol',
        content: data.source_code,
        language: 'solidity',
        isMain: true
      }];

      // additional_sources
      if (data.additional_sources) {
        data.additional_sources.forEach((src) => {
          files.push({
            path: src.file_path || 'Additional.sol',
            content: src.source_code,
            language: detectLanguage(src.file_path)
          });
        });
      }

      console.log('[Source] Blockscout: found source');
      return {
        matchType: 'blockscout',
        language: 'Solidity',
        compiler: data.compiler_version,
        files,
        abi: typeof data.abi === 'string' ? JSON.parse(data.abi) : data.abi,
        contractName: data.name,
        source: 'Blockscout',
        verified: true
      };
    } catch (err) {
      console.warn('[Source] Blockscout failed:', err.message);
    }
    return null;
  }

  // ─── Source: Etherscan-compatible ───
  async function fetchFromEtherscan(chainId, address) {
    const apiKey = localStorage.getItem('apz-etherscan-key');
    if (!apiKey) return null;

    try {
      const url = `https://api.etherscan.io/v2/api?chainid=${chainId}&module=contract&action=getsourcecode&address=${address}&apikey=${apiKey}`;
      const res = await fetch(url);
      if (!res.ok) return null;

      const json = await res.json();
      if (json.status !== '1' || !json.result?.[0]) return null;

      const data = json.result[0];
      if (!data.SourceCode) return null;

      let files = [];

      // برخی مواقع source یک JSON با چند فایل است
      if (data.SourceCode.startsWith('{{')) {
        try {
          const inner = JSON.parse(data.SourceCode.slice(1, -1));
          files = Object.entries(inner.sources || {}).map(([path, info]) => ({
            path,
            content: info.content,
            language: detectLanguage(path),
            isMain: path === data.ContractName + '.sol'
          }));
        } catch {
          files = [{
            path: `${data.ContractName}.sol`,
            content: data.SourceCode,
            language: 'solidity',
            isMain: true
          }];
        }
      } else {
        files = [{
          path: `${data.ContractName}.sol`,
          content: data.SourceCode,
          language: 'solidity',
          isMain: true
        }];
      }

      console.log('[Source] Etherscan: found source');
      return {
        matchType: 'etherscan',
        language: 'Solidity',
        compiler: data.CompilerVersion,
        files,
        abi: data.ABI ? JSON.parse(data.ABI) : null,
        contractName: data.ContractName,
        source: 'Etherscan',
        verified: true,
        license: data.LicenseType
      };
    } catch (err) {
      console.warn('[Source] Etherscan failed:', err.message);
    }
    return null;
  }

  // ─── Language Detection ───
  function detectLanguage(path) {
    const lower = path.toLowerCase();
    if (lower.endsWith('.sol')) return 'solidity';
    if (lower.endsWith('.vy')) return 'vyper';
    if (lower.endsWith('.js')) return 'javascript';
    if (lower.endsWith('.ts')) return 'typescript';
    if (lower.endsWith('.json')) return 'json';
    if (lower.endsWith('.md')) return 'markdown';
    if (lower.endsWith('.yaml') || lower.endsWith('.yml')) return 'yaml';
    return 'solidity';
  }

  // ─── Main Fetch ───
  async function fetchSource(chainId, address) {
    const cached = getCached(chainId, address);
    if (cached) {
      console.log('[Source] From cache');
      return cached;
    }

    let result = await fetchFromSourcify(chainId, address);
    if (!result) result = await fetchFromBlockscout(chainId, address);
    if (!result) result = await fetchFromEtherscan(chainId, address);

    if (!result) {
      return {
        files: [],
        source: null,
        verified: false,
        error: 'SOURCE_NOT_FOUND'
      };
    }

    setCache(chainId, address, result);
    return result;
  }

  // ─── Download Helper ───
  function downloadFile(filename, content, mime = 'text/plain') {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function downloadAsZip(files, name = 'contract-sources') {
    // بدون JSZip: به‌صورت فایل متنی ترکیبی
    // در production از JSZip استفاده کنید
    const combined = files.map((f) => {
      return `${'='.repeat(80)}\n// File: ${f.path}\n${'='.repeat(80)}\n\n${f.content || '// content unavailable'}\n\n`;
    }).join('\n');
    downloadFile(`${name}.txt`, combined);
  }

  // ─── Public API ───
  window.APZ_SOURCE = {
    fetchSource,
    downloadFile,
    downloadAsZip,
    configure: (opts) => {
      if (opts.blockscoutUrl) {
        CFG.blockscout.enabled = true;
        CFG.blockscout.baseUrl = opts.blockscoutUrl;
      }
    },
    clearCache: () => cache.clear()
  };
})();
