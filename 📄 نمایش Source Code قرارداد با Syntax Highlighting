      download: 'Herunterladen',
      downloadAll: 'Alle herunterladen',
      search: 'In Datei suchen',
      searchPlaceholder: 'Suchen...',
      noMatches: 'Keine Treffer',
      matches: 'Treffer',
      raw: 'Roh',
      highlighted: 'Hervorgehoben',
