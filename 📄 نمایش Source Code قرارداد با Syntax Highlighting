/* ═══════════════════════════════════════════════
   APZ Wallet — Lightweight Syntax Highlighter
   Fallback برای زمانی که Prism.js در دسترس نیست
   پشتیبانی: Solidity, JavaScript, TypeScript, JSON
   ═══════════════════════════════════════════════ */

(function () {
  'use strict';

  // ─── Solidity Keywords ───
  const SOLIDITY_KEYWORDS = [
    'pragma', 'solidity', 'import', 'from', 'contract', 'interface', 'library',
    'abstract', 'is', 'using', 'for', 'function', 'constructor', 'modifier',
    'event', 'error', 'struct', 'enum', 'mapping', 'returns', 'return',
    'public', 'private', 'internal', 'external', 'view', 'pure', 'payable',
    'constant', 'immutable', 'override', 'virtual', 'abstract',
    'if', 'else', 'while', 'do', 'for', 'break', 'continue', 'try', 'catch',
    'throw', 'revert', 'require', 'assert', 'emit', 'new', 'delete',
    'this', 'super', 'self', 'address', 'bool', 'string', 'bytes', 'byte',
    'int', 'uint', 'fixed', 'ufixed', 'true', 'false', 'wei', 'gwei', 'ether',
    'seconds', 'minutes', 'hours', 'days', 'weeks', 'memory', 'storage', 'calldata',
    'assembly', 'unchecked', 'receive', 'fallback', 'type', 'indexed'
  ];

  const SOLIDITY_TYPES = [
    'address', 'bool', 'string', 'bytes', 'bytes32', 'bytes1', 'bytes2', 'bytes3',
    'bytes4', 'bytes8', 'bytes16', 'bytes20', 'bytes28',
    'int8', 'int16', 'int32', 'int64', 'int128', 'int256',
    'uint8', 'uint16', 'uint32', 'uint64', 'uint128', 'uint256',
    'int', 'uint'
  ];

  const JS_KEYWORDS = [
    'const', 'let', 'var', 'function', 'return', 'if', 'else', 'for', 'while',
    'do', 'break', 'continue', 'class', 'extends', 'super', 'this', 'new',
    'delete', 'typeof', 'instanceof', 'in', 'of', 'try', 'catch', 'finally',
    'throw', 'async', 'await', 'import', 'export', 'default', 'from', 'as',
    'true', 'false', 'null', 'undefined', 'NaN', 'Infinity', 'yield', 'static',
    'get', 'set', 'switch', 'case', 'with', 'debugger'
  ];

  // ─── Escape ───
  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // ─── Highlighter ───
  function highlightSolidity(code) {
    // ترتیب مهم است: comments → strings → numbers → keywords → types
    let html = escapeHtml(code);

    // ─── Comments (اول از همه، چون ممکن است شامل کلمات کلیدی باشند) ───
    // Block comments
    html = html.replace(/\/\*[\s\S]*?\*\//g, (m) =>
      `<span class="tok-comment">${m}</span>`
    );
    // Line comments
    html = html.replace(/\/\/[^\n]*/g, (m) =>
      `<span class="tok-comment">${m}</span>`
    );

    // ─── Strings ───
    html = html.replace(/(["'])((?:\\.|(?!\1)[^\\])*?)\1/g, (m) =>
      `<span class="tok-string">${m}</span>`
    );

    // ─── Hex numbers (addresses, hashes) ───
    html = html.replace(/\b(0x[a-fA-F0-9]+)\b/g, (m) =>
      `<span class="tok-hex">${m}</span>`
    );

    // ─── Numbers ───
    html = html.replace(/\b(\d+(?:_\d+)*(?:\.\d+)?(?:[eE][+-]?\d+)?)\b/g, (m) =>
      `<span class="tok-number">${m}</span>`
    );

    // ─── Types ───
    const typesRe = new RegExp(`\\b(${SOLIDITY_TYPES.join('|')})\\b(?!-)`, 'g');
    html = html.replace(typesRe, (m) =>
      `<span class="tok-type">${m}</span>`
    );

    // ─── Keywords ───
    const kwRe = new RegExp(`\\b(${SOLIDITY_KEYWORDS.join('|')})\\b`, 'g');
    html = html.replace(kwRe, (m) =>
      `<span class="tok-keyword">${m}</span>`
    );

    // ─── Function names (بعد از function) ───
    html = html.replace(/\bfunction\s+([A-Za-z_]\w*)/g, (m, name) =>
      `function <span class="tok-fn">${name}</span>`
    );

    // ─── Contract names (بعد از contract/interface/library) ───
    html = html.replace(/\b(contract|interface|library)\s+([A-Za-z_]\w*)/g, (m, kw, name) =>
      `${kw} <span class="tok-class">${name}</span>`
    );

    // ─── Events ───
    html = html.replace(/\bevent\s+([A-Za-z_]\w*)/g, (m, name) =>
      `event <span class="tok-fn">${name}</span>`
    );

    // ─── Modifiers (public/private/...) ───
    html = html.replace(/\b(public|private|internal|external|view|pure|payable|virtual|override|immutable|constant)\b/g, (m) =>
      `<span class="tok-modifier">${m}</span>`
    );

    // ─── Pragmas ───
    html = html.replace(/(pragma\s+solidity[^;]*;)/g, (m) =>
      `<span class="tok-pragma">${m}</span>`
    );

    return html;
  }

  function highlightJS(code) {
    let html = escapeHtml(code);

    html = html.replace(/\/\*[\s\S]*?\*\//g, (m) => `<span class="tok-comment">${m}</span>`);
    html = html.replace(/\/\/[^\n]*/g, (m) => `<span class="tok-comment">${m}</span>`);
    html = html.replace(/(["'`])((?:\\.|(?!\1)[^\\])*?)\1/g, (m) => `<span class="tok-string">${m}</span>`);
    html = html.replace(/\b(0x[a-fA-F0-9]+)\b/g, (m) => `<span class="tok-hex">${m}</span>`);
    html = html.replace(/\b(\d+(?:\.\d+)?)\b/g, (m) => `<span class="tok-number">${m}</span>`);

    const kwRe = new RegExp(`\\b(${JS_KEYWORDS.join('|')})\\b`, 'g');
    html = html.replace(kwRe, (m) => `<span class="tok-keyword">${m}</span>`);

    return html;
  }

  function highlightJSON(code) {
    let html = escapeHtml(code);
    html = html.replace(/("(?:\\.|[^"\\])*")(\s*:)/g, (m, key, colon) =>
      `<span class="tok-key">${key}</span>${colon}`
    );
    html = html.replace(/("(?:\\.|[^"\\])*")/g, (m) => `<span class="tok-string">${m}</span>`);
    html = html.replace(/\b(true|false|null)\b/g, (m) => `<span class="tok-keyword">${m}</span>`);
    html = html.replace(/\b(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)\b/g, (m) => `<span class="tok-number">${m}</span>`);
    return html;
  }

  function highlight(code, language = 'solidity') {
    switch (language.toLowerCase()) {
      case 'solidity':
      case 'sol':
        return highlightSolidity(code);
      case 'javascript':
      case 'js':
      case 'typescript':
      case 'ts':
        return highlightJS(code);
      case 'json':
        return highlightJSON(code);
      default:
        return escapeHtml(code);
    }
  }

  // ─── Public ───
  window.APZ_HIGHLIGHT = {
    highlight,
    escapeHtml,
    highlightSolidity,
    highlightJS,
    highlightJSON
  };
})();
