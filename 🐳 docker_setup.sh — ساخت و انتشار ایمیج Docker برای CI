📄 docker_setup.sh

```bash
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – Docker Bootstrap
#  ساخت Dockerfile + compose + entrypoint + healthcheck
#  و بیلد/پوش خودکار ایمیج برای CI
#  Usage:
#     bash docker_setup.sh build          # فقط build
#     bash docker_setup.sh run            # build + run API
#     bash docker_setup.sh push           # build + push به GHCR
#     bash docker_setup.sh compose-up     # docker compose up
#     bash docker_setup.sh clean          # پاک‌سازی
#  Options:
#     --registry=ghcr|dockerhub|local     (پیش‌فرض: ghcr)
#     --tag=1.0.0
#     --platform=linux/amd64,linux/arm64
#     --no-cache
#  Author: APZ Security Team | License: GPLv3
# ============================================================
set -euo pipefail

# ---------- پیش‌فرض‌ها ----------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_NAME="apz-manager"
DEFAULT_TAG="$(cat "${SCRIPT_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]' || echo '1.0.0')"

REGISTRY="${APZ_DOCKER_REGISTRY:-ghcr}"
IMAGE_TAG="${APZ_DOCKER_TAG:-${DEFAULT_TAG}}"
PLATFORMS="${APZ_DOCKER_PLATFORMS:-linux/amd64,linux/arm64}"
NO_CACHE="${APZ_DOCKER_NO_CACHE:-0}"

# ---------- رنگ‌ها ----------
c_green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_yellow() { printf "\033[1;33m%s\033[0m\n" "$1"; }
c_red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
c_cyan()   { printf "\033[1;36m%s\033[0m\n" "$1"; }
c_bold()   { printf "\033[1m%s\033[0m\n" "$1"; }
c_dim()    { printf "\033[2m%s\033[0m\n" "$1"; }

# ---------- پارس پرچم‌ها ----------
ACTION="${1:-build}"
shift || true

for arg in "$@"; do
    case "$arg" in
        --registry=*)  REGISTRY="${arg#*=}" ;;
        --tag=*)       IMAGE_TAG="${arg#*=}" ;;
        --platform=*)  PLATFORMS="${arg#*=}" ;;
        --no-cache)    NO_CACHE=1 ;;
    esac
done

banner() {
    echo "============================================================"
    echo "   APZ Manager – Docker Bootstrap"
    echo "   Action: ${ACTION}  |  Tag: ${IMAGE_TAG}"
    echo "   Registry: ${REGISTRY}"
    echo "============================================================"
}

# ============================================================
#  پیش‌نیازها
# ============================================================
preflight() {
    c_cyan ">>> [0/10] بررسی پیش‌نیازها..."

    if ! command -v docker >/dev/null 2>&1; then
        c_red "[!] docker نصب نیست."
        echo "    نصب:"
        echo "      Linux : curl -fsSL https://get.docker.com | sh"
        echo "      macOS : brew install --cask docker"
        echo "      Win   : winget install Docker.DockerDesktop"
        exit 1
    fi

    if ! docker info >/dev/null 2>&1; then
        c_red "[!] Docker daemon در دسترس نیست."
        exit 1
    fi

    # docker buildx برای چندمعماری
    if [ "$PLATFORMS" != "linux/amd64" ] && ! docker buildx version >/dev/null 2>&1; then
        c_yellow "[!] docker buildx موجود نیست. فقط linux/amd64 ساخته می‌شود."
        PLATFORMS="linux/amd64"
    fi

    # docker compose
    HAS_COMPOSE=0
    if docker compose version >/dev/null 2>&1; then
        HAS_COMPOSE=1
        COMPOSE_CMD="docker compose"
    elif command -v docker-compose >/dev/null 2>&1; then
        HAS_COMPOSE=1
        COMPOSE_CMD="docker-compose"
    fi

    # تعیین image name
    if [ "$REGISTRY" = "ghcr" ]; then
        if command -v gh >/dev/null 2>&1; then
            GH_USER="$(gh api user --jq .login 2>/dev/null || echo '')"
        fi
        GH_USER="${GH_USER:-$(whoami)}"
        IMAGE_NAME="ghcr.io/${GH_USER,,}/${PKG_NAME}"
    elif [ "$REGISTRY" = "dockerhub" ]; then
        DOCKER_USER="${DOCKER_USER:-$(whoami)}"
        IMAGE_NAME="${DOCKER_USER}/${PKG_NAME}"
    else
        IMAGE_NAME="${PKG_NAME}"
    fi

    c_dim "    [+] image: ${IMAGE_NAME}:${IMAGE_TAG}"
    c_green "    [+] پیش‌نیازها OK."
}

