# ============================================================
#  4) entrypoint.sh
# ============================================================
write_entrypoint() {
    c_cyan ">>> [4/10] نوشتن docker/entrypoint.sh..."
    mkdir -p "${SCRIPT_DIR}/docker"

    cat > "${SCRIPT_DIR}/docker/entrypoint.sh" <<'EOF_ENTRY'
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – Container entrypoint
#  Usage inside container:
#     entrypoint.sh api                              → اجرای API
#     entrypoint.sh cli --file x.apk --output y.json → تحلیل
#     entrypoint.sh analyze /path/app.apk            → تحلیل + ذخیره خودکار
#     entrypoint.sh batch /path/list.txt             → تحلیل دسته‌ای
#     entrypoint.sh shell                            → bash تعاملی
# ============================================================
set -euo pipefail

APZ_HOME="${APZ_HOME:-/opt/apz}"
APZ_DEFAULT_OUTDIR="${APZ_DEFAULT_OUTDIR:-/data/reports}"
APZ_DB_PATH="${APZ_DB_PATH:-/data/apz.db}"
APZ_HTTP_HOST="${APZ_HTTP_HOST:-0.0.0.0}"
APZ_HTTP_PORT="${APZ_HTTP_PORT:-5000}"

mkdir -p "${APZ_DEFAULT_OUTDIR}" "$(dirname "${APZ_DB_PATH}")" /data/logs /data/rules

cd "${APZ_HOME}"

log()  { printf '\033[1;36m[APZ]\033[0m %s\n' "$*"; }
err()  { printf '\033[1;31m[APZ]\033[0m %s\n' "$*" >&2; }

CMD="${1:-api}"
shift || true

case "$CMD" in
    # ---------- API ----------
    api|serve)
        log "Starting RESTful API on ${APZ_HTTP_HOST}:${APZ_HTTP_PORT}"
        log "  Data dir : ${APZ_DEFAULT_OUTDIR}"
        log "  Database : ${APZ_DB_PATH}"
        exec python apz_api.py
        ;;

    # ---------- CLI pass-through ----------
    cli)
        log "Running CLI: $*"
        exec python apz_manager.py "$@"
        ;;

    # ---------- تحلیل یک APK ----------
    analyze)
        if [ $# -lt 1 ]; then err "Usage: entrypoint.sh analyze /path/app.apk [extra args]"; exit 1; fi
        APK_PATH="$1"; shift
        if [ ! -f "${APK_PATH}" ]; then err "APK not found: ${APK_PATH}"; exit 1; fi
        NAME="$(basename "${APK_PATH}" .apk)"
        STAMP="$(date +%Y%m%d_%H%M%S)"
        OUT="${APZ_DEFAULT_OUTDIR}/${NAME}_${STAMP}.json"
        log "Analyzing: ${APK_PATH}"
        log "Output   : ${OUT}"
        exec python apz_manager.py --file "${APK_PATH}" --output "${OUT}" --db "$@"
        ;;

    # ---------- تحلیل دسته‌ای ----------
    batch)
        if [ $# -lt 1 ]; then err "Usage: entrypoint.sh batch /path/list.txt"; exit 1; fi
        LIST="$1"; shift
        if [ ! -f "${LIST}" ]; then err "List not found: ${LIST}"; exit 1; fi
        OUT="${APZ_DEFAULT_OUTDIR}/batch_$(date +%Y%m%d_%H%M%S).json"
        log "Batch analyzing: ${LIST}"
        log "Output         : ${OUT}"
        exec python apz_manager.py --batch "${LIST}" --output "${OUT}" --db "$@"
        ;;

    # ---------- اسکن پوشه‌ای ----------
    scan-dir)
        DIR="${1:-/samples}"
        shift || true
        if [ ! -d "${DIR}" ]; then err "Directory not found: ${DIR}"; exit 1; fi
        log "Scanning directory: ${DIR}"
        LIST="$(mktemp)"
        find "${DIR}" -type f -iname '*.apk' > "${LIST}"
        COUNT="$(wc -l < "${LIST}")"
        log "Found ${COUNT} APK(s)"
        if [ "${COUNT}" -eq 0 ]; then err "No APKs found"; exit 0; fi
        OUT="${APZ_DEFAULT_OUTDIR}/scan_$(date +%Y%m%d_%H%M%S).json"
        exec python apz_manager.py --batch "${LIST}" --output "${OUT}" --db "$@"
        ;;

    # ---------- YARA-only ----------
    yara)
        TARGET="${1:-/samples}"
        log "Running YARA against: ${TARGET}"
        exec yara -r /data/rules "${TARGET}"
        ;;

    # ---------- shell ----------
    shell|bash|sh)
        exec /bin/bash
        ;;

    # ---------- healthcheck داخلی ----------
    healthcheck)
        exec /usr/local/bin/healthcheck.sh
        ;;

    # ---------- هر چیز دیگر → pass through ----------
    *)
        log "Pass-through: ${CMD} $*"
        exec "${CMD}" "$@"
        ;;
esac
EOF_ENTRY
    chmod +x "${SCRIPT_DIR}/docker/entrypoint.sh"
    c_green "    [+] entrypoint.sh نوشته شد."
}

# ============================================================
#  5) healthcheck.sh
# ============================================================
write_healthcheck() {
    c_cyan ">>> [5/10] نوشتن docker/healthcheck.sh..."
    cat > "${SCRIPT_DIR}/docker/healthcheck.sh" <<'EOF_HEALTH'
#!/usr/bin/env bash
# ============================================================
#  APZ Manager – Container healthcheck
#  بررسی: فرایند اصلی + پاسخ API + دسترسی به دیتابیس
# ============================================================
set -uo pipefail

APZ_HTTP_HOST="${APZ_HTTP_HOST:-127.0.0.1}"
APZ_HTTP_PORT="${APZ_HTTP_PORT:-5000}"
APZ_DB_PATH="${APZ_DB_PATH:-/data/apz.db}"

FAIL=0

# 1) فرایند python در حال اجرا؟
if ! pgrep -f "python.*apz" >/dev/null 2>&1; then
    echo "[!] APZ process not running" >&2
    FAIL=1
fi

# 2) پاسخ HTTP (فقط اگر API فعال باشد)
if command -v curl >/dev/null 2>&1; then
    if pgrep -f "apz_api.py" >/dev/null 2>&1; then
        if ! curl -fsS --max-time 4 "http://${APZ_HTTP_HOST}:${APZ_HTTP_PORT}/stats" >/dev/null 2>&1; then
            # اگر /stats نبود، حداقل پورت باز باشد
            if ! curl -fsS --max-time 4 "http://${APZ_HTTP_HOST}:${APZ_HTTP_PORT}/" >/dev/null 2>&1; then
                echo "[!] API not responding" >&2
                FAIL=1
            fi
        fi
    fi
fi

# 3) دیتابیس قابل نوشتن؟
DB_DIR="$(dirname "${APZ_DB_PATH}")"
if [ ! -w "${DB_DIR}" ]; then
    echo "[!] DB dir not writable: ${DB_DIR}" >&2
    FAIL=1
fi

# 4) پوشه گزارش قابل نوشتن؟
if [ -n "${APZ_DEFAULT_OUTDIR:-}" ] && [ ! -w "${APZ_DEFAULT_OUTDIR}" ]; then
    echo "[!] Output dir not writable: ${APZ_DEFAULT_OUTDIR}" >&2
    FAIL=1
fi

if [ "${FAIL}" -eq 0 ]; then
    echo "healthy"
    exit 0
fi

echo "unhealthy"
exit 1
EOF_HEALTH
    chmod +x "${SCRIPT_DIR}/docker/healthcheck.sh"
    c_green "    [+] healthcheck.sh نوشته شد."
}

# ============================================================
#  6) docker-compose.yml
# ============================================================
write_compose() {
    c_cyan ">>> [6/10] نوشتن docker-compose.yml..."
    cat > "${SCRIPT_DIR}/docker-compose.yml" <<'EOF_COMPOSE'
# ============================================================
#  APZ Manager – Docker Compose
#  سرویس‌ها:
#    - api     : سرور RESTful روی پورت 5000
#    - worker  : مصرف‌کننده‌ی پوشه‌ی /samples برای تحلیل خودکار
#    - redis   : (اختیاری) صف کار برای پردازش موازی
#  داده‌ها:
#    - apz-data    : گزارش‌ها و دیتابیس
#    - apz-samples : APKهای ورودی (bind mount)
#    - apz-rules   : قوانین YARA (bind mount)
# ============================================================
version: "3.9"

x-common: &common
    build:
        context: .
        dockerfile: ${DOCKERFILE:-Dockerfile}
    image: ${APZ_IMAGE:-apz-manager:latest}
    restart: unless-stopped
    environment:
        APZ_DEFAULT_OUTDIR: /data/reports
        APZ_DB_PATH: /data/apz.db
        APZ_LOG_LEVEL: ${APZ_LOG_LEVEL:-INFO}
        APZ_VT_API_KEY: ${APZ_VT_API_KEY:-}
        APZ_HA_API_KEY: ${APZ_HA_API_KEY:-}
        APZ_MD_API_KEY: ${APZ_MD_API_KEY:-}
        APZ_AI_API_KEY: ${APZ_AI_API_KEY:-}
        APZ_HTTP_HOST: 0.0.0.0
        APZ_HTTP_PORT: "5000"
        TZ: ${TZ:-UTC}
    volumes:
        - apz-data:/data
        - ./rules:/data/rules:ro
    networks:
        - apz-net
    healthcheck:
        test: ["CMD", "/usr/local/bin/healthcheck.sh"]
        interval: 30s
        timeout: 5s
        retries: 3
        start_period: 20s

services:
    # ---------- RESTful API ----------
    api:
        <<: *common
        container_name: apz-api
        command: ["api"]
        ports:
            - "${APZ_HTTP_PORT:-5000}:5000"
        depends_on:
            redis:
                condition: service_healthy
        deploy:
            resources:
                limits:
                    cpus: '2.0'
                    memory: 2G
                reservations:
                    memory: 512M

    # ---------- Worker (اسکن خودکار پوشه samples) ----------
    worker:
        <<: *common
        container_name: apz-worker
        command: ["scan-dir", "/samples"]
        environment:
            APZ_DEFAULT_OUTDIR: /data/reports
            APZ_DB_PATH: /data/apz.db
            APZ_VT_API_KEY: ${APZ_VT_API_KEY:-}
            APZ_HA_API_KEY: ${APZ_HA_API_KEY:-}
            APZ_MD_API_KEY: ${APZ_MD_API_KEY:-}
            APZ_AI_API_KEY: ${APZ_AI_API_KEY:-}
            APZ_SCAN_INTERVAL: ${APZ_SCAN_INTERVAL:-3600}
        volumes:
            - apz-data:/data
            - ./rules:/data/rules:ro
            - ./samples:/samples:ro
        depends_on:
            redis:
                condition: service_healthy
        profiles:
            - worker

    # ---------- Redis (صف) ----------
    redis:
        image: redis:7-alpine
        container_name: apz-redis
        restart: unless-stopped
        command: ["redis-server", "--appendonly", "yes", "--save", "60", "1"]
        volumes:
            - apz-redis:/data
        networks:
            - apz-net
        healthcheck:
            test: ["CMD", "redis-cli", "ping"]
            interval: 10s
            timeout: 3s
            retries: 5
        deploy:
            resources:
                limits:
                    memory: 256M

    # ---------- Optional: pgAdmin/web for future DB ----------
    # (فعلاً SQLite استفاده می‌شود، این سرویس غیرفعال است)
    # db:
    #     image: postgres:16-alpine
    #     ...

volumes:
    apz-data:
        driver: local
    apz-redis:
        driver: local

networks:
    apz-net:
        driver: bridge
EOF_COMPOSE
    c_green "    [+] docker-compose.yml نوشته شد."

    # نسخه‌ی CI-minimal compose
    cat > "${SCRIPT_DIR}/docker-compose.ci.yml" <<'EOF_CI'
# ============================================================
#  APZ Manager – Compose برای CI (بدون سرویس اضافه)
# ============================================================
version: "3.9"

services:
    apz:
        build:
            context: .
            dockerfile: Dockerfile
        image: apz-manager:ci
        environment:
            APZ_DEFAULT_OUTDIR: /data/reports
            APZ_DB_PATH: /data/apz.db
            APZ_LOG_LEVEL: INFO
        volumes:
            - ./ci-out:/data
            - ./samples:/samples:ro
            - ./rules:/data/rules:ro
        command: ["scan-dir", "/samples"]
        # اگر exit code 0 برگرداند موفق است
EOF_CI
    c_green "    [+] docker-compose.ci.yml نوشته شد."
}

# ============================================================
#  7) Makefile.docker
# ============================================================
write_makefile_docker() {
    c_cyan ">>> [7/10] نوشتن Makefile.docker..."
    cat > "${SCRIPT_DIR}/Makefile.docker" <<'EOF_MKDOCKER'
# ============================================================
#  APZ Manager – Docker Make targets
#  استفاده:  make -f Makefile.docker <target>
# ============================================================
IMAGE_NAME   ?= apz-manager
IMAGE_TAG    ?= latest
REGISTRY     ?=
PLATFORMS    ?= linux/amd64,linux/arm64
DOCKERFILE   ?= Dockerfile
BUILDX_BUILDER ?= apz-builder

ifeq ($(REGISTRY),)
FULL_IMAGE := $(IMAGE_NAME):$(IMAGE_TAG)
else
FULL_IMAGE := $(REGISTRY)/$(IMAGE_NAME):$(IMAGE_TAG)
endif

.PHONY: help
help:
	@echo "APZ Docker targets:"
	@echo "  make -f Makefile.docker build         → ساخت ایمیج"
	@echo "  make -f Makefile.docker build-slim    → ساخت ایمیج slim"
	@echo "  make -f Makefile.docker build-full    → ساخت ایمیج با PDF"
	@echo "  make -f Makefile.docker buildx        → ساخت چندمعماری"
	@echo "  make -f Makefile.docker run           → اجرای API"
	@echo "  make -f Makefile.docker shell         → bash داخل کانتینر"
	@echo "  make -f Makefile.docker test          → تست داخل Docker"
	@echo "  make -f Makefile.docker push          → push به registry"
	@echo "  make -f Makefile.docker compose-up    → docker compose up"
	@echo "  make -f Makefile.docker compose-down  → docker compose down"
	@echo "  make -f Makefile.docker clean         → پاک‌سازی"

.PHONY: build
build:
	docker build -t $(FULL_IMAGE) -f $(DOCKERFILE) .

.PHONY: build-slim
build-slim:
	docker build -t $(FULL_IMAGE)-slim -f Dockerfile.slim .

.PHONY: build-full
build-full:
	docker build -t $(FULL_IMAGE)-full -f Dockerfile.proot .

.PHONY: buildx
buildx:
	@docker buildx inspect $(BUILDX_BUILDER) >/dev/null 2>&1 || \
	    docker buildx create --name $(BUILDX_BUILDER) --use
	docker buildx build \
	    --builder $(BUILDX_BUILDER) \
	    --platform $(PLATFORMS) \
	    -t $(FULL_IMAGE) \
	    -f $(DOCKERFILE) \
	    --push .

.PHONY: run
run:
	docker run --rm -it \
	    -p 5000:5000 \
	    -v apz-data:/data \
	    -v $(PWD)/rules:/data/rules:ro \
	    $(FULL_IMAGE) api

.PHONY: shell
shell:
	docker run --rm -it \
	    --entrypoint /bin/bash \
	    -v apz-data:/data \
	    $(FULL_IMAGE)

.PHONY: test
test:
	docker run --rm \
	    -v $(PWD)/samples:/samples:ro \
	    -v $(PWD)/ci-out:/data \
	    $(FULL_IMAGE) scan-dir /samples

.PHONY: push
push: build
	docker push $(FULL_IMAGE)

.PHONY: compose-up
compose-up:
	docker compose up -d --build

.PHONY: compose-down
compose-down:
	docker compose down

.PHONY: clean
clean:
	docker image rm -f $(FULL_IMAGE) 2>/dev/null || true
	docker image rm -f $(FULL_IMAGE)-slim 2>/dev/null || true
	docker image rm -f $(FULL_IMAGE)-full 2>/dev/null || true
	docker volume rm -f apz-data apz-redis 2>/dev/null || true
EOF_MKDOCKER
    c_green "    [+] Makefile.docker نوشته شد."
}

# ============================================================
#  8) workflow برای GitHub Actions (docker publish)
# ============================================================
write_docker_workflow() {
    c_cyan ">>> [8/10] نوشتن .github/workflows/docker.yml..."
    mkdir -p "${SCRIPT_DIR}/.github/workflows"

    cat > "${SCRIPT_DIR}/.github/workflows/docker.yml" <<'EOF_GH'
name: Docker

on:
  push:
    branches: [ main ]
    tags: [ 'v*.*.*' ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  build-and-push:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
    steps:
      - uses: actions/checkout@v4

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      - name: Set up Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata (tags, labels)
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=ref,event=branch
            type=ref,event=pr
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}
            type=sha,prefix=sha-
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push (multi-arch)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: true
          sbom: true

      - name: Build and push (slim variant)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile.slim
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name != 'pull_request' }}
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:slim
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:slim-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Build and push (full/PDF variant)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile.proot
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name != 'pull_request' }}
          tags: |
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:full
            ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:full-${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Image digest
        run: echo "Digest: ${{ steps.build.outputs.digest }}"

  smoke-test:
    runs-on: ubuntu-latest
    needs: build-and-push
    if: github.event_name == 'pull_request' || github.ref == 'refs/heads/main'
    permissions:
      contents: read
      packages: read
    steps:
      - uses: actions/checkout@v4
      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Pull image (amd64)
        run: |
          docker pull ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:sha-${{ github.sha }} || \
          docker pull ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest
      - name: Run healthcheck
        run: |
          IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}:latest"
          docker run --rm -d --name apz-smoke -p 5000:5000 "$IMAGE" api
          sleep 8
          curl -fsS http://localhost:5000/stats || true
          docker logs apz-smoke
          docker stop apz-smoke
EOF_GH
    c_green "    [+] docker.yml نوشته شد."
}

# ============================================================
#  9) build (اجرای Docker)
# ============================================================
do_build() {
    c_cyan ">>> [9/10] ساخت ایمیج..."
    cd "${SCRIPT_DIR}"

    local extra=""
    [ "$NO_CACHE" = "1" ] && extra="--no-cache"

    # بررسی Dockerfile
    if [ ! -f Dockerfile ]; then
        c_red "[!] Dockerfile پیدا نشد."
        exit 1
    fi

    # تعیین buildx
    if [ "$PLATFORMS" != "linux/amd64" ] && docker buildx version >/dev/null 2>&1; then
        c_dim "    استفاده از buildx برای: ${PLATFORMS}"
        docker buildx inspect apz-builder >/dev/null 2>&1 || \
            docker buildx create --name apz-builder --use
        docker buildx build \
            --builder apz-builder \
            --platform "${PLATFORMS}" \
            $extra \
            -t "${IMAGE_NAME}:${IMAGE_TAG}" \
            -t "${IMAGE_NAME}:latest" \
            --load \
            -f Dockerfile \
            .
    else
        c_dim "    ساخت تک‌معماری: linux/amd64"
        docker build \
            $extra \
            -t "${IMAGE_NAME}:${IMAGE_TAG}" \
            -t "${IMAGE_NAME}:latest" \
            -f Dockerfile \
            .
    fi

    c_green "    [+] ایمیج ساخته شد: ${IMAGE_NAME}:${IMAGE_TAG}"

    # نمایش اندازه
    local size
    size="$(docker image inspect "${IMAGE_NAME}:${IMAGE_TAG}" --format='{{.Size}}' 2>/dev/null | awk '{printf "%.1f MB", $1/1024/1024}')"
    c_dim "    حجم: ${size}"
}

# ============================================================
#  10) push به registry
# ============================================================
do_push() {
    c_cyan ">>> [10/10] Push به ${REGISTRY}..."

    if [ "$REGISTRY" = "ghcr" ]; then
        if command -v gh >/dev/null 2>&1; then
            echo "$(gh auth token)" | docker login ghcr.io -u "${GH_USER}" --password-stdin
        else
            c_yellow "[!] gh موجود نیست، docker login دستی لازم است."
        fi
    elif [ "$REGISTRY" = "dockerhub" ]; then
        if [ -n "${DOCKER_PAT:-}" ]; then
            echo "$DOCKER_PAT" | docker login -u "${DOCKER_USER}" --password-stdin
        else
            c_yellow "[!] DOCKER_PAT تنظیم نشده."
            docker login
        fi
    fi

    docker tag "${IMAGE_NAME}:${IMAGE_TAG}" "${IMAGE_NAME}:latest"
    docker push "${IMAGE_NAME}:${IMAGE_TAG}"
    docker push "${IMAGE_NAME}:latest"

    c_green "    [+] Push انجام شد: ${IMAGE_NAME}:${IMAGE_TAG}"
}

# ============================================================
#  run / compose-up / clean
# ============================================================
do_run() {
    c_cyan ">>> اجرای API روی http://localhost:5000"
    docker run --rm -it \
        -p 5000:5000 \
        -v apz-data:/data \
        -v "$(pwd)/rules:/data/rules:ro" \
        -e APZ_VT_API_KEY="${APZ_VT_API_KEY:-}" \
        -e APZ_HA_API_KEY="${APZ_HA_API_KEY:-}" \
        -e APZ_MD_API_KEY="${APZ_MD_API_KEY:-}" \
        -e APZ_AI_API_KEY="${APZ_AI_API_KEY:-}" \
        "${IMAGE_NAME}:${IMAGE_TAG}" api
}

do_compose_up() {
    c_cyan ">>> Docker Compose up..."
    if [ "$HAS_COMPOSE" != "1" ]; then
        c_red "[!] docker compose موجود نیست."; exit 1
    fi
    cd "${SCRIPT_DIR}"
    $COMPOSE_CMD up -d --build
    c_green "    [+] سرویس‌ها بالا آمدند."
    $COMPOSE_CMD ps
}

do_clean() {
    c_cyan ">>> پاک‌سازی..."
    docker image rm -f "${IMAGE_NAME}:${IMAGE_TAG}" 2>/dev/null || true
    docker image rm -f "${IMAGE_NAME}:latest" 2>/dev/null || true
    docker image rm -f "${IMAGE_NAME}:slim" 2>/dev/null || true
    docker image rm -f "${IMAGE_NAME}:full" 2>/dev/null || true
    docker volume rm -f apz-data apz-redis 2>/dev/null || true
    docker builder prune -f --filter "until=24h" 2>/dev/null || true
    c_green "    [+] تمام."
}

# ============================================================
#  summary
# ============================================================
summary() {
    echo
    echo "============================================================"
    c_green "   ✅ Docker setup کامل شد"
    echo "============================================================"
    echo "   فایل‌های ساخته‌شده:"
    echo "     Dockerfile              ← ایمیج اصلی"
    echo "     Dockerfile.slim         ← ایمیج کوچک (Alpine)"
    echo "     Dockerfile.proot        ← ایمیج کامل (PDF/weasyprint)"
    echo "     docker-compose.yml      ← API + worker + redis"
    echo "     docker-compose.ci.yml   ← نسخه CI"
    echo "     Makefile.docker         ← اهداف Make"
    echo "     docker/entrypoint.sh    ← ورودی کانتینر"
    echo "     docker/healthcheck.sh   ← بررسی سلامت"
    echo "     .dockerignore"
    echo "     .github/workflows/docker.yml"
    echo
    echo "   ▸ دستورات سریع:"
    echo "       bash docker_setup.sh build"
    echo "       bash docker_setup.sh run"
    echo "       bash docker_setup.sh compose-up"
    echo "       bash docker_setup.sh push --registry=ghcr"
    echo
    echo "   ▸ با Make:"
    echo "       make -f Makefile.docker build"
    echo "       make -f Makefile.docker buildx"
    echo "       make -f Makefile.docker run"
    echo
    echo "   ▸ اجرای مستقیم تحلیل:"
    echo "       docker run --rm -v \$PWD/samples:/samples:ro \\"
    echo "           ${IMAGE_NAME}:${IMAGE_TAG} scan-dir /samples"
    echo "============================================================"
}

# ============================================================
#  main
# ============================================================
main() {
    banner
    preflight

    # همیشه فایل‌ها را می‌سازیم (اگر نبودند)
    write_dockerignore
    write_dockerfile
    write_dockerfile_proot
    write_entrypoint
    write_healthcheck
    write_compose
    write_makefile_docker
    write_docker_workflow

    case "$ACTION" in
        build)
            do_build
            summary
            ;;
        run)
            do_build
            do_run
            ;;
        push)
            do_build
            do_push
            summary
            ;;
        compose-up|up)
            do_compose_up
            summary
            ;;
        compose-down|down)
            do_compose_down 2>/dev/null || $COMPOSE_CMD down
            c_green "[+] سرویس‌ها خاموش شدند."
            ;;
        clean)
            do_clean
            ;;
        gen|generate)
            c_green "[+] فقط فایل‌ها ساخته شدند (بدون build)."
            summary
            ;;
        *)
            echo "Usage: bash docker_setup.sh <build|run|push|compose-up|compose-down|clean|gen> [options]"
            exit 1
            ;;
    esac
}

main
