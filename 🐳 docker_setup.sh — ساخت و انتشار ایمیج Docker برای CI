write_dockerfile() {
    c_cyan ">>> [2/10] نوشتن Dockerfile..."
    cat > "${SCRIPT_DIR}/Dockerfile" <<'EOF_DOCKER'
# ============================================================
#  APZ Manager – Production Dockerfile
#  Multi-stage, distroless-ish, non-root, multi-arch
# ============================================================

# ----- Stage 1: builder -----
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# وابستگی‌های ساخت (برای yara-python و androguard)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libyara-dev \
        libxml2-dev \
        libxslt1-dev \
        libffi-dev \
        libjpeg-dev \
        libfreetype6-dev \
        zlib1g-dev \
        libssl-dev \
        git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# ساخت wheel‌ها (لایه‌بندی برای کش بهتر)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip wheel setuptools

COPY requirements-android.txt* requirements.txt* ./
RUN if [ -f requirements-android.txt ]; then \
        pip wheel --wheel-dir=/wheels -r requirements-android.txt; \
    elif [ -f requirements.txt ]; then \
        pip wheel --wheel-dir=/wheels -r requirements.txt; \
    else \
        pip wheel --wheel-dir=/wheels \
            androguard pyyaml flask sqlalchemy yara-python requests rich; \
    fi

# ----- Stage 2: runtime -----
FROM python:3.11-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="APZ Manager" \
      org.opencontainers.image.description="APK Security Analysis Platform" \
      org.opencontainers.image.source="https://github.com/your-org/apz-manager" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    APZ_HOME=/opt/apz \
    APZ_DEFAULT_OUTDIR=/data/reports \
    APZ_DB_PATH=/data/apz.db \
    APZ_LOG_LEVEL=INFO \
    APZ_HTTP_HOST=0.0.0.0 \
    APZ_HTTP_PORT=5000

# وابستگی‌های runtime (بدون build-essential)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libyara9 \
        libxml2 \
        libxslt1.1 \
        libjpeg62-turbo \
        libfreetype6 \
        zlib1g \
        libssl3 \
        ca-certificates \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/*

# کاربر non-root
RUN groupadd -r apz -g 1000 && \
    useradd  -r -g apz -u 1000 -m -d /home/apz -s /bin/bash apz

# کپی venv از builder
COPY --from=builder /opt/venv /opt/venv

# کپی wheel‌ها (اختیاری برای نصب افزودنی‌ها)
COPY --from=builder /wheels /wheels
RUN chmod -R a+r /wheels

# کپی سورس
WORKDIR ${APZ_HOME}
COPY --chown=apz:apz . ${APZ_HOME}

# پوشه‌های داده
RUN mkdir -p /data/reports /data/logs /data/rules && \
    chown -R apz:apz /data ${APZ_HOME}

# entrypoint و healthcheck
COPY --chown=apz:apz docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chown=apz:apz docker/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh

USER apz

EXPOSE 5000

VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["api"]
EOF_DOCKER
    c_green "    [+] Dockerfile نوشته شد."
}

