۶) patch_apz_manager.py — پچ خودکار فایل اصلی

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
patch_apz_manager.py
------------------------------------------------------------
پچ خودکار apz_manager.py برای سازگاری با اندروید/Termux:
- غیرفعال‌کردن Tkinter در صورت نبود DISPLAY
- حذف وابستگی سخت به weasyprint
- افزودن مسیر پیش‌فرض خروجی در ~/apz-reports
------------------------------------------------------------
"""
from __future__ import annotations

import os
import re
import shutil
from pathlib import Path

TARGETS = ["apz_manager.py", "apz_api.py", "apz_orchestrator.py"]
BACKUP_SUFFIX = ".android.bak"


def is_android() -> bool:
    return ("ANDROID_ROOT" in os.environ) or ("com.termux" in os.environ.get("PREFIX", ""))


def backup(path: Path) -> None:
    bak = path.with_suffix(path.suffix + BACKUP_SUFFIX)
    if not bak.exists():
        shutil.copy2(path, bak)
        print(f"[+] بکاپ: {bak}")


def patch_tkinter_guard(path: Path) -> bool:
    """اگر tkinter موجود نیست، import آن را در try/except قرار می‌دهد."""
    src = path.read_text(encoding="utf-8")
    if "TKINTER_AVAILABLE" in src:
        return False

    # جایگزین import tkinter
    pattern = re.compile(
        r"^(import tkinter.*|from tkinter import .*)$",
        re.MULTILINE,
    )

    if not pattern.search(src):
        return False

    def _wrap(match: re.Match) -> str:
        line = match.group(0)
        return (
            "try:\n"
            f"    {line}\n"
            "    TKINTER_AVAILABLE = True\n"
            "except Exception:\n"
            "    TKINTER_AVAILABLE = False\n"
        )

    # فقط اولین بلوک import را wrap کن
    new_src, count = pattern.subn(_wrap, src, count=1)
    if count:
        path.write_text(new_src, encoding="utf-8")
        print(f"[+] tkinter guard اعمال شد: {path.name}")
        return True
    return False


def patch_weasyprint(path: Path) -> bool:
    """هر import سخت weasyprint را در try/except قرار می‌دهد."""
    src = path.read_text(encoding="utf-8")
    if "WEASYPRINT_AVAILABLE" in src:
        return False

    pattern = re.compile(r"^(from weasyprint import .+|import weasyprint.*)$", re.MULTILINE)
    if not pattern.search(src):
        return False

    def _wrap(match: re.Match) -> str:
        line = match.group(0)
        return (
            "try:\n"
            f"    {line}\n"
            "    WEASYPRINT_AVAILABLE = True\n"
            "except Exception:\n"
            "    WEASYPRINT_AVAILABLE = False\n"
        )

    new_src, count = pattern.subn(_wrap, src, count=1)
    if count:
        path.write_text(new_src, encoding="utf-8")
        print(f"[+] weasyprint guard اعمال شد: {path.name}")
        return True
    return False


def patch_default_outdir(path: Path) -> bool:
    """افزودن مسیر پیش‌فرض برای خروجی‌ها (اگر نبود)."""
    src = path.read_text(encoding="utf-8")
    if "APZ_DEFAULT_OUTDIR" in src:
        return False

    inject = (
        "\n# --- APZ Android Patch ---\n"
        "import pathlib as _apz_pl\n"
        "APZ_DEFAULT_OUTDIR = _apz_pl.Path.home() / 'apz-reports'\n"
        "APZ_DEFAULT_OUTDIR.mkdir(parents=True, exist_ok=True)\n"
        "# --- End APZ Patch ---\n\n"
    )

    # بعد از بلوک importها اضافه کن (بعد از آخرین import در ۳۰ خط اول)
    lines = src.splitlines(keepends=True)
    insert_at = 0
    for i, line in enumerate(lines[:60]):
        if line.startswith(("import ", "from ")) or line.strip() == "":
            insert_at = i + 1
        else:
            break

    new_src = "".join(lines[:insert_at]) + inject + "".join(lines[insert_at:])
    path.write_text(new_src, encoding="utf-8")
    print(f"[+] APZ_DEFAULT_OUTDIR اضافه شد: {path.name}")
    return True


def main() -> None:
    root = Path(__file__).resolve().parent
    print(f"[i] شاخه پروژه: {root}")
    print(f"[i] اندروید تشخیص داده شد: {is_android()}")

    changed_any = False
    for name in TARGETS:
        p = root / name
        if not p.exists():
            print(f"[=] {name} موجود نیست، رد می‌شود.")
            continue
        backup(p)
        c1 = patch_tkinter_guard(p)
        c2 = patch_weasyprint(p)
        c3 = patch_default_outdir(p)
        changed_any = changed_any or c1 or c2 or c3

    if changed_any:
        print("\n✅ پچ‌ها اعمال شد. بکاپ‌ها با پسوند .android.bak ذخیره شدند.")
    else:
        print("\n[=] تغییری لازم نبود.")


if __name__ == "__main__":
    main()
```

