```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
report_generator_patch.py
------------------------------------------------------------
نسخه‌ی سازگار با اندروید از report_generator.

ویژگی‌ها:
- به‌طور خودکار weasyprint را (در صورت نبود) غیرفعال می‌کند.
- خروجی HTML تمیز و قابل چاپ در مرورگر اندروید.
- در Ubuntu proot اگر weasyprint نصب باشد، PDF هم تولید می‌شود.
- بدون وابستگی به Tkinter یا X11.

قابل جایگزینی مستقیم با report_generator.py
------------------------------------------------------------
"""
from __future__ import annotations

import json
import os
import platform
from datetime import datetime
from typing import Any, Dict, List, Optional

# --- تشخیص پشتیبانی PDF ---
PDF_SUPPORTED = False
HTML_CLASS = None
try:
    from weasyprint import HTML as HTML_CLASS  # type: ignore
    PDF_SUPPORTED = True
except Exception:
    PDF_SUPPORTED = False

IS_ANDROID = ("ANDROID_ROOT" in os.environ) or ("com.termux" in os.environ.get("PREFIX", ""))


def _safe_get(d: Dict[str, Any], *keys, default=None):
    cur = d
    for k in keys:
        if not isinstance(cur, dict) or k not in cur:
            return default
        cur = cur[k]
    return cur


def _risk_color(level: str) -> str:
    return {
        "CRITICAL": "#8b0000",
        "HIGH":     "#d9534f",
        "MEDIUM":   "#f0ad4e",
        "LOW":      "#5bc0de",
        "CLEAN":    "#5cb85c",
        "UNKNOWN":  "#777777",
    }.get((level or "").upper(), "#777777")


def _findings_to_rows(findings: List[Dict[str, Any]]) -> str:
    if not findings:
        return "<tr><td colspan='4' style='text-align:center;color:#888;'>یافته‌ای ثبت نشده است.</td></tr>"
    rows = []
    for f in findings:
        title = f.get("title_fa") or f.get("title") or "-"
        weight = f.get("weight", 0)
        detail = f.get("detail_fa") or f.get("detail") or ""
        evidence = f.get("evidence") or []
        if isinstance(evidence, list):
            evidence = "<br>".join(f"<code>{e}</code>" for e in evidence)
        rows.append(
            f"<tr><td><b>{title}</b></td>"
            f"<td style='text-align:center;'>{weight}</td>"
            f"<td>{detail}</td>"
            f"<td>{evidence}</td></tr>"
        )
    return "\n".join(rows)


def _list_to_html(items: Optional[List[Any]], empty_msg="—") -> str:
    if not items:
        return f"<span style='color:#888;'>{empty_msg}</span>"
    if isinstance(items, (str, bytes)):
        return f"<code>{items}</code>"
    return "<ul>" + "".join(f"<li><code>{i}</code></li>" for i in items) + "</ul>"


class ReportGenerator:
    """تولید گزارش HTML/PDF/JSON با پشتیبانی از اندروید."""

    def __init__(self, report: Dict[str, Any]):
        self.report = report or {}
        self.file = self.report.get("file", "unknown.apk")
        self.sha256 = self.report.get("sha256", "-")
        self.risk_score = self.report.get("risk_score", 0)
        self.risk_level = self.report.get("risk_level", "UNKNOWN")
        self.confidence = self.report.get("confidence", 0)
        self.sandbox_verdict = self.report.get("sandbox_verdict", "-")
        self.findings = self.report.get("findings", []) or []
        self.permissions = self.report.get("permissions", []) or []
        self.limitations = self.report.get("limitations", []) or []
        self.iocs = self.report.get("iocs", {}) or {}
        self.mitre = self.report.get("mitre", []) or []
        self.recommendations = self.report.get("recommendations", []) or []

    # ------------------------------------------------------------------
    def render_html(self) -> str:
        color = _risk_color(self.risk_level)
        rows = _findings_to_rows(self.findings)
        mitre_html = ", ".join(
            f"<code>{m.get('id', m) if isinstance(m, dict) else m}</code>"
            for m in self.mitre
        ) or "—"

        iocs_html = "<br>".join(
            f"<b>{k}</b>: {_list_to_html(v)}" for k, v in self.iocs.items()
        ) or "—"

        pdf_note = (
            "<span style='color:#5cb85c;'>PDF فعال است</span>"
            if PDF_SUPPORTED else
            "<span style='color:#f0ad4e;'>PDF غیرفعال (weasyprint نصب نیست)</span>"
        )

        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

        return f"""<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>APZ Report – {self.file}</title>
<style>
    body {{ font-family: Tahoma, Arial, sans-serif; background:#f7f7f9; margin:0; padding:16px; color:#222; }}
    .card {{ background:#fff; border-radius:10px; padding:16px; box-shadow:0 1px 4px rgba(0,0,0,.08); margin-bottom:16px; }}
    h1 {{ font-size:18px; margin:0 0 8px; }}
    h2 {{ font-size:16px; margin:16px 0 8px; border-right:4px solid {color}; padding-right:8px; }}
    .score {{ display:flex; gap:16px; align-items:center; flex-wrap:wrap; }}
    .score .val {{ font-size:38px; font-weight:bold; color:{color}; }}
    .badge {{ display:inline-block; padding:4px 10px; border-radius:20px; color:#fff; background:{color}; font-weight:bold; }}
    table {{ width:100%; border-collapse:collapse; font-size:13px; }}
    th, td {{ padding:8px; border-bottom:1px solid #eee; vertical-align:top; text-align:right; }}
    th {{ background:#fafafa; }}
    code {{ background:#f2f2f2; padding:1px 4px; border-radius:4px; font-size:12px; word-break:break-all; }}
    .meta {{ font-size:12px; color:#666; }}
    .footer {{ text-align:center; color:#888; font-size:11px; margin-top:20px; }}
    ul {{ padding-right:18px; }}
</style>
</head>
<body>
    <div class="card">
        <h1>📦 گزارش تحلیل امنیتی APZ Manager</h1>
        <div class="meta">فایل: <code>{self.file}</code></div>
        <div class="meta">SHA-256: <code>{self.sha256}</code></div>
        <div class="meta">تاریخ: {now} | پلتفرم: {platform.system()} {platform.release()}</div>
        <div class="meta">وضعیت PDF: {pdf_note}</div>
    </div>

    <div class="card">
        <h2>🎯 خلاصه‌ی ریسک</h2>
        <div class="score">
            <div class="val">{self.risk_score}</div>
            <div>
                <div class="badge">{self.risk_level}</div>
                <div style="margin-top:6px;">اطمینان: <b>{self.confidence}%</b></div>
                <div>Sandbox: <b>{self.sandbox_verdict}</b></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>🔍 یافته‌ها</h2>
        <table>
            <thead>
                <tr><th>عنوان</th><th>وزن</th><th>توضیح</th><th>شواهد</th></tr>
            </thead>
            <tbody>
                {rows}
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>🔐 مجوزها</h2>
        {_list_to_html(self.permissions, "مجوز خاصی استخراج نشد.")}
    </div>

    <div class="card">
        <h2>🌐 IOCها</h2>
        {iocs_html}
    </div>

    <div class="card">
        <h2>🎯 MITRE ATT&CK</h2>
        {mitre_html}
    </div>

    <div class="card">
        <h2>✅ توصیه‌ها</h2>
        {_list_to_html(self.recommendations, "توصیه‌ای ثبت نشده.")}
    </div>

    <div class="card">
        <h2>⚠️ محدودیت‌ها</h2>
        {_list_to_html(self.limitations, "—")}
    </div>

    <div class="footer">
        APZ Manager – گزارش خودکار | {now}
    </div>
</body>
</html>"""

    # ------------------------------------------------------------------
    def save_html(self, path: str) -> str:
        html = self.render_html()
        os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(html)
        return path

    # ------------------------------------------------------------------
    def save_pdf(self, path: str) -> Optional[str]:
        if not PDF_SUPPORTED or HTML_CLASS is None:
            print("[!] PDF غیرفعال است (weasyprint موجود نیست).")
            return None
        html_path = path.rsplit(".", 1)[0] + ".html"
        self.save_html(html_path)
        HTML_CLASS(filename=html_path).write_pdf(path)
        return path

    # ------------------------------------------------------------------
    def save_json(self, path: str) -> str:
        os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(self.report, f, ensure_ascii=False, indent=2)
        return path

    # ------------------------------------------------------------------
    def save_all(self, base_path: str) -> Dict[str, Optional[str]]:
        """base_path مثل: /home/apz-reports/app.json"""
        base = base_path.rsplit(".", 1)[0]
        return {
            "json": self.save_json(base + ".json"),
            "html": self.save_html(base + ".html"),
            "pdf":  self.save_pdf(base + ".pdf"),
        }


# ----------------------------------------------------------------------
# توابع سازگار با کدهای قدیمی (اگر پروژه از توابع ماژولی استفاده می‌کند)
# ----------------------------------------------------------------------
def generate_html_report(report: Dict[str, Any], output_path: str) -> str:
    return ReportGenerator(report).save_html(output_path)


def generate_pdf_report(report: Dict[str, Any], output_path: str) -> Optional[str]:
    return ReportGenerator(report).save_pdf(output_path)


def generate_json_report(report: Dict[str, Any], output_path: str) -> str:
    return ReportGenerator(report).save_json(output_path)


