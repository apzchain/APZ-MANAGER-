```bash
#!/data/data/com.termux/files/usr/bin/bash
# ============================================================
#  APZ Manager - Quick runner for Android/Termux
#  Usage:
#     bash run_android.sh /sdcard/Download/app.apk
#     bash run_android.sh /sdcard/Download/app.apk --api
#     bash run_android.sh --batch list.txt
# ============================================================
set -e

WORK_DIR="${HOME}/apz-manager"
VENV_DIR="${WORK_DIR}/venv"
OUT_DIR="${HOME}/apz-reports"

c_green()  { printf "\033[1;32m%s\033[0m\n" "$1"; }
c_red()    { printf "\033[1;31m%s\033[0m\n" "$1"; }
c_cyan()   { printf "\033[1;36m%s\033[0m\n" "$1"; }

# --- بررسی محیط ---
if [ ! -d "${WORK_DIR}" ]; then
    c_red "[!] APZ Manager نصب نشده. ابتدا apz_android.sh را اجرا کنید."
    exit 1
fi

cd "${WORK_DIR}"
mkdir -p "${OUT_DIR}"

# --- فعال‌سازی venv ---
if [ -f "${VENV_DIR}/bin/activate" ]; then
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
else
    c_red "[!] venv پیدا نشد."
    exit 1
fi

# --- حالت API ---
if [ "$1" == "--api" ]; then
    c_cyan ">>> اجرای سرور API روی http://127.0.0.1:5000"
    exec python apz_api.py
fi

# --- حالت دسته‌ای ---
if [ "$1" == "--batch" ]; then
    if [ -z "$2" ]; then
        c_red "Usage: run_android.sh --batch list.txt"
        exit 1
    fi
    OUT="${OUT_DIR}/batch_$(date +%Y%m%d_%H%M%S).json"
    c_cyan ">>> تحلیل دسته‌ای: $2"
    python apz_manager.py --batch "$2" --output "${OUT}" --db
    c_green "[+] گزارش: ${OUT}"
    exit 0
fi

# --- حالت تک‌فایل ---
APK_PATH="$1"
if [ -z "${APK_PATH}" ]; then
    echo "Usage:"
    echo "  bash run_android.sh /sdcard/Download/app.apk"
    echo "  bash run_android.sh /sdcard/Download/app.apk --db"
    echo "  bash run_android.sh --batch list.txt"
    echo "  bash run_android.sh --api"
    exit 1
fi

if [ ! -f "${APK_PATH}" ]; then
    c_red "[!] فایل پیدا نشد: ${APK_PATH}"
    exit 1
fi

BASENAME=$(basename "${APK_PATH}" .apk)
OUT="${OUT_DIR}/${BASENAME}_$(date +%Y%m%d_%H%M%S).json"

c_cyan ">>> تحلیل APK: ${APK_PATH}"
c_cyan ">>> خروجی: ${OUT}"

python apz_manager.py --file "${APK_PATH}" --output "${OUT}" --db "$@"

c_green "[+] تحلیل کامل شد."
echo "    گزارش JSON: ${OUT}"

# HTML در صورت وجود
HTML_OUT="${OUT%.json}.html"
if [ -f "${HTML_OUT}" ]; then
    echo "    گزارش HTML: ${HTML_OUT}"
    # اعلان در Termux:API (اختیاری)
    if command -v termux-notification >/dev/null 2>&1; then
        termux-notification \
            --title "APZ Manager" \
            --content "تحلیل $(basename "$APK_PATH") کامل شد." \
            || true
    fi
fi
