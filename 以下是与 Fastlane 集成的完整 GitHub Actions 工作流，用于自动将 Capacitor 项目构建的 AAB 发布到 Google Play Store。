以下是与 Fastlane 集成的完整 GitHub Actions 工作流，用于自动将 Capacitor 项目构建的 AAB 发布到 Google Play Store。

---

📁 文件结构

```
.github/workflows/
└── publish-play-store.yml   # 发布到 Play Store 的工作流

android/
└── fastlane/
    ├── Appfile              # 包名 + JSON 密钥路径
    ├── Fastfile             # Lanes 定义
    └── Gemfile              # Ruby 依赖
```

📄 1. .github/workflows/publish-play-store.yml

```yaml
name: Publish to Play Store

on:
  release:
    types: [ published ]
  workflow_dispatch:
    inputs:
      track:
        description: 'Play Store track'
        required: true
        default: 'internal'
        type: choice
        options:
          - internal
          - alpha
          - beta
          - production

permissions:
  contents: read

jobs:
  publish:
    name: Build AAB & Publish to Play Store
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      # ─────────────────────────────────────────
      # 1. Checkout
      # ─────────────────────────────────────────
      - name: Checkout
        uses: actions/checkout@v4

      # ─────────────────────────────────────────
      # 2. Setup Node.js
      # ─────────────────────────────────────────
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      # ─────────────────────────────────────────
      # 3. Setup JDK 17
      # ─────────────────────────────────────────
      - name: Setup JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      # ─────────────────────────────────────────
      # 4. Setup Android SDK
      # ─────────────────────────────────────────
      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      # ─────────────────────────────────────────
      # 5. Setup Ruby (برای Fastlane)
      # ─────────────────────────────────────────
      - name: Setup Ruby
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true
          working-directory: android

      # ─────────────────────────────────────────
      # 6. Cache Gradle
      # ─────────────────────────────────────────
      - name: Cache Gradle packages
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
          restore-keys: ${{ runner.os }}-gradle-

      # ─────────────────────────────────────────
      # 7. Install Node Dependencies
      # ─────────────────────────────────────────
      - name: Install dependencies
        run: npm ci

      # ─────────────────────────────────────────
      # 8. Build Web Assets
      # ─────────────────────────────────────────
      - name: Build web assets
        run: npm run build
        # اگر build script ندارید، این خط را حذف کنید

      # ─────────────────────────────────────────
      # 9. Sync Capacitor
      # ─────────────────────────────────────────
      - name: Sync Capacitor
        run: npx cap sync android

      # ─────────────────────────────────────────
      # 10. Decode Google Play Service Account JSON
      # ─────────────────────────────────────────
      - name: Decode Play Store JSON Key
        env:
          PLAY_STORE_JSON_BASE64: ${{ secrets.PLAY_STORE_JSON_BASE64 }}
        run: |
          mkdir -p android/fastlane
          echo "$PLAY_STORE_JSON_BASE64" | base64 -d > android/fastlane/play-store-key.json
          echo "✅ Play Store JSON decoded"

      # ─────────────────────────────────────────
      # 11. Decode Keystore (برای امضای AAB)
      # ─────────────────────────────────────────
      - name: Decode Keystore
        env:
          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
        run: |
          echo "$KEYSTORE_BASE64" | base64 -d > android/release.jks
          echo "✅ Keystore decoded"

      # ─────────────────────────────────────────
      # 12. Build Release AAB
      # ─────────────────────────────────────────
      - name: Build Release AAB
        working-directory: ./android
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          chmod +x gradlew
          ./gradlew bundleRelease \
            -Pandroid.injected.signing.store.file=release.jks \
            -Pandroid.injected.signing.store.password="$KEYSTORE_PASSWORD" \
            -Pandroid.injected.signing.key.alias="$KEY_ALIAS" \
            -Pandroid.injected.signing.key.password="$KEY_PASSWORD" \
            --stacktrace

      # ─────────────────────────────────────────
      # 13. Run Fastlane Supply
      # ─────────────────────────────────────────
      - name: Run Fastlane Supply
        working-directory: ./android
        env:
          PLAY_STORE_JSON_KEY_PATH: ${{ github.workspace }}/android/fastlane/play-store-key.json
          TRACK: ${{ github.event.inputs.track || 'internal' }}
          LC_ALL: en_US.UTF-8
          LANG: en_US.UTF-8
        run: |
          bundle exec fastlane android deploy \
            track:"$TRACK" \
            aab:"${{ github.workspace }}/android/app/build/outputs/bundle/release/app-release.aab"

      # ─────────────────────────────────────────
      # 14. Cleanup Secrets
      # ─────────────────────────────────────────
      - name: Cleanup
        if: always()
        run: |
          rm -f android/fastlane/play-store-key.json
          rm -f android/release.jks
```

