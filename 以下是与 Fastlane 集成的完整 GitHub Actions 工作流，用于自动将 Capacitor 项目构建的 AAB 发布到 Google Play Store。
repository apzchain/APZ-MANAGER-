📄 3. android/fastlane/Fastfile

```ruby
# ═══════════════════════════════════════════════
# APZ Wallet — Fastlane Fastfile
# ═══════════════════════════════════════════════

default_platform(:android)

platform :android do

  # ─────────────────────────────────────────
  # Lane: Deploy AAB to Play Store
  # ─────────────────────────────────────────
  desc "Build and deploy AAB to Google Play Store"
  lane :deploy do |options|
    track_name = options[:track] || "internal"
    aab_path = options[:aab] || "../app/build/outputs/bundle/release/app-release.aab"

    UI.message("🚀 Deploying APZ Wallet to Play Store track: #{track_name}")

    upload_to_play_store(
      track: track_name,
      aab: aab_path,
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-key.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: track_name == "production" ? "completed" : "draft",
      validate_only: false
    )

    UI.success("✅ Successfully deployed to Play Store (#{track_name})!")
  end

  # ─────────────────────────────────────────
  # Lane: Promote to Production
  # ─────────────────────────────────────────
  desc "Promote from beta to production"
  lane :promote_to_production do
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-key.json",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true,
      skip_upload_aab: true
    )
    UI.success("✅ Promoted to production!")
  end

  # ─────────────────────────────────────────
  # Lane: Validate Metadata Only
  # ─────────────────────────────────────────
  desc "Validate Play Store metadata without uploading"
  lane :validate do
    upload_to_play_store(
      json_key: ENV["PLAY_STORE_JSON_KEY_PATH"] || "fastlane/play-store-key.json",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: true
    )
    UI.success("✅ Metadata validation passed!")
  end

end
```

